load("@rules_java//java:defs.bzl", "java_library")

# The converter: Formex 4 → legal-text XML
java_library(
    name = "infra",
    srcs = glob(["*.java"]),
    visibility = ["//src:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    runtime_deps = ["//formex-converter/xslt:resources"],
    deps = [
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_jspecify_jspecify",
    ],
)
