load("//tools/build:defs.bzl", "xjc_library")

# JAXB classes for legal-text.xsd; their Javadoc comes from the schema's xs:documentation
xjc_library(
    name = "xml",
    srcs = ["LocalDateAdapter.java"],
    bindings = "bindings.xjb",
    schema = "//formex-converter/schema:legal-text.xsd",
    visibility = ["//src:__subpackages__"],  # the viewer only: //formex-converter never depends on it
)
