<ANNEX xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://formex.publications.europa.eu/schema/formex-05.20-20100601.xd"><BIB.INSTANCE><DOCUMENT.REF FILE="L_2011042EN.01002901.doc.xml"><COLL>L</COLL><NO.OJ>042</NO.OJ><YEAR>2011</YEAR><LG.OJ>EN</LG.OJ><PAGE.FIRST>29</PAGE.FIRST><PAGE.SEQ>1</PAGE.SEQ><VOLUME.REF>01</VOLUME.REF></DOCUMENT.REF><DATE ISO="20110215">20110215</DATE><LG.DOC>EN</LG.DOC><NO.SEQ>0006.0001</NO.SEQ><PAGE.FIRST>31</PAGE.FIRST><PAGE.SEQ>1</PAGE.SEQ><PAGE.LAST>31</PAGE.LAST><PAGE.TOTAL>1</PAGE.TOTAL></BIB.INSTANCE><TITLE><TI><P>ANNEX</P></TI></TITLE><CONTENTS><GR.TBL><TITLE><TI><P><HT TYPE="BOLD">CLEARANCE OF THE PAYING AGENCIES’ ACCOUNTS</HT></P><P><HT TYPE="BOLD">FINANCIAL YEAR 2008</HT></P></TI><STI><P><HT TYPE="BOLD">Amount to be recovered from or paid to the Member State</HT></P></STI></TITLE><GR.NOTES><NOTE NOTE.ID="E0001" NUMBERING="ARAB" TYPE="TABLE"><P>The reductions and suspensions are those taken into account in the payment system, to which are added in particular the corrections for the non respect of payment deadlines established in August, September and October 2008.</P></NOTE><NOTE NOTE.ID="E0002" NUMBERING="ARAB" TYPE="TABLE"><P>For the calculation of the amount to be recovered from or paid to the Member State the amount taken into account is, the total of the annual declaration for the expenditure cleared (column a) or, the total of the monthly declarations for the expenditure disjoined (column b).</P><P>Applicable exchange rate: Article 7(2) of the Commission Regulation (EC) No 883/2006.</P></NOTE><NOTE NOTE.ID="E0003" NUMBERING="ARAB" TYPE="TABLE"><P>If the Assigned revenue part would be in advantage of Member State, it has to be declared under 05 07 01 06.</P></NOTE><NOTE NOTE.ID="E0004" NUMBERING="ARAB" TYPE="TABLE"><P>If the Assigned revenue part of the Sugar Fund, would be in the advantage of the Member State, it has to be declared under 05 02 16 02.</P></NOTE><GR.ANNOTATION><ANNOTATION><P><HT TYPE="ITALIC">NB</HT>: Nomenclature 2011: 05 07 01 06, 05 02 16 02, 6701, 6702, 6803.</P></ANNOTATION></GR.ANNOTATION></GR.NOTES><TBL COLS="13" NO.SEQ="0001" PAGE.SIZE="SINGLE.LANDSCAPE"><CORPUS><ROW TYPE="HEADER"><CELL COL="1" ROWSPAN="3" TYPE="HEADER">MS</CELL><CELL COL="2" ROWSPAN="3" TYPE="HEADER"><IE/></CELL><CELL COL="3" COLSPAN="2" TYPE="HEADER">2008 — Expenditure/Assigned Revenue for the Paying Agencies for which the accounts are</CELL><CELL COL="5" ROWSPAN="3" TYPE="HEADER">Total a + b</CELL><CELL COL="6" ROWSPAN="3" TYPE="HEADER">Reductions and suspensions for the whole financial year<NOTE NOTE.REF="E0001"></NOTE></CELL><CELL COL="7" ROWSPAN="3" TYPE="HEADER">Reductions according to Article 32 of Regulation 1290/2005</CELL><CELL COL="8" ROWSPAN="3" TYPE="HEADER">Total including reductions and suspensions</CELL><CELL COL="9" ROWSPAN="3" TYPE="HEADER">Payments made to the Member State for the financial year</CELL><CELL COL="10" ROWSPAN="3" TYPE="HEADER">Amount to be recovered from (–) or paid to (+) the Member State<NOTE NOTE.REF="E0002"></NOTE></CELL><CELL COL="11" ROWSPAN="3" TYPE="HEADER">Amount recovered from (–) or paid to (+) the Member State under Decision 2009/367/EC</CELL><CELL COL="12" ROWSPAN="3" TYPE="HEADER">Amount recovered from (–) or paid to (+) the Member State under Decision 2010/56/EU</CELL><CELL COL="13" ROWSPAN="3" TYPE="HEADER">Amount to be recovered from (–) or paid to (+) the Member State<NOTE NOTE.REF="E0002"></NOTE></CELL></ROW><ROW TYPE="HEADER"><CELL COL="3" TYPE="HEADER">cleared</CELL><CELL COL="4" TYPE="HEADER">disjoined</CELL></ROW><ROW TYPE="HEADER"><CELL COL="3" TYPE="HEADER">= expenditure/assigned revenue declared in the annual declaration</CELL><CELL COL="4" TYPE="HEADER">= total of the expenditure/assigned revenue in the monthly declarations</CELL></ROW><ROW TYPE="HEADER"><CELL COL="1" TYPE="HEADER"><IE/></CELL><CELL COL="2" TYPE="HEADER"><IE/></CELL><CELL COL="3" TYPE="HEADER">a</CELL><CELL COL="4" TYPE="HEADER">b</CELL><CELL COL="5" TYPE="HEADER">c = a + b</CELL><CELL COL="6" TYPE="HEADER">d</CELL><CELL COL="7" TYPE="HEADER">e</CELL><CELL COL="8" TYPE="HEADER">f = c + d + e</CELL><CELL COL="9" TYPE="HEADER">g</CELL><CELL COL="10" TYPE="HEADER">h = f – g</CELL><CELL COL="11" TYPE="HEADER">i</CELL><CELL COL="12" TYPE="HEADER">i′</CELL><CELL COL="13" TYPE="HEADER">j = h – i – i′</CELL></ROW><ROW><CELL COL="1">IT</CELL><CELL COL="2">EUR</CELL><CELL COL="3"><FT TYPE="DECIMAL">4270684692,35</FT></CELL><CELL COL="4"><FT TYPE="DECIMAL">0,00</FT></CELL><CELL COL="5"><FT TYPE="DECIMAL">4270684692,35</FT></CELL><CELL COL="6"><FT TYPE="DECIMAL">–1887157,65</FT></CELL><CELL COL="7"><FT TYPE="DECIMAL">–4363298,08</FT></CELL><CELL COL="8"><FT TYPE="DECIMAL">4264434236,62</FT></CELL><CELL COL="9"><FT TYPE="DECIMAL">4264132179,52</FT></CELL><CELL COL="10"><FT TYPE="DECIMAL">302057,10</FT></CELL><CELL COL="11"><FT TYPE="DECIMAL">256775,28</FT></CELL><CELL COL="12"><FT TYPE="DECIMAL">0,00</FT></CELL><CELL COL="13"><FT TYPE="DECIMAL">45281,82</FT></CELL></ROW></CORPUS></TBL><TBL COLS="8" NO.SEQ="0002" PAGE.SIZE="SINGLE.LANDSCAPE"><CORPUS><ROW TYPE="HEADER"><CELL COL="1" ROWSPAN="4" TYPE="HEADER">MS</CELL><CELL COL="2" ROWSPAN="4" TYPE="HEADER"><IE/></CELL><CELL COL="3" ROWSPAN="2" TYPE="HEADER">Expenditure<NOTE NOTE.REF="E0003"></NOTE></CELL><CELL COL="4" ROWSPAN="2" TYPE="HEADER">Assigned revenue<NOTE NOTE.REF="E0003"></NOTE></CELL><CELL COL="5" COLSPAN="2" TYPE="HEADER">Sugar Fund</CELL><CELL COL="7" ROWSPAN="2" TYPE="HEADER">Article 32 (= e)</CELL><CELL COL="8" ROWSPAN="3" TYPE="HEADER">Total (= h)</CELL></ROW><ROW TYPE="HEADER"><CELL COL="5" TYPE="HEADER">Expenditure<NOTE NOTE.REF="E0004"></NOTE></CELL><CELL COL="6" TYPE="HEADER">Assigned revenue<NOTE NOTE.REF="E0004"></NOTE></CELL></ROW><ROW TYPE="HEADER"><CELL COL="3" TYPE="HEADER">05 07 01 06</CELL><CELL COL="4" TYPE="HEADER">6701</CELL><CELL COL="5" TYPE="HEADER">05 02 16 02</CELL><CELL COL="6" TYPE="HEADER">6803</CELL><CELL COL="7" T