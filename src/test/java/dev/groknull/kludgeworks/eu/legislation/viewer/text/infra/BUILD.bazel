# SPDX-License-Identifier: MIT
load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test", "java_test_suite")

# One test target per *Test.java; Fixture, Fixtures and TextConservation become a shared library
java_test_suite(
    name = "infra",
    size = "medium",
    srcs = glob(
        ["*.java"],
        exclude = ["CorpusTests.java"],
    ),
    data = ["//src/test/resources/fixtures"],
    runner = "junit5",
    runtime_deps = [
        "//src/main/resources/dev/groknull/kludgeworks/eu/legislation/viewer/text/infra/xml:resources",
        "//src/test/resources/compare:resources",
        "//src/test/resources/mathml3:resources",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        "//src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/text/infra",
        "//src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/text/infra/xml",
        "//tools/build:schematron",
        "@maven//:jakarta_xml_bind_jakarta_xml_bind_api",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
        "@maven//:org_xmlunit_xmlunit_assertj3",
        "@maven//:org_xmlunit_xmlunit_core",
        "@rules_java//java/runfiles",
    ],
)

# The regression test on the whole corpus: one language's mirror in formex-corpus/, ignored
# (mise run corpus:fetch, then mise run corpus:test; also //:corpus; see CorpusTests)
java_junit5_test(
    name = "corpus",
    size = "enormous",
    srcs = ["CorpusTests.java"],
    # the JDK's XML limits, which the converter lifts for its own parsing, also stop the validation
    # of a large document's output (a 55 MB consolidation, an annex with 100,000 entity references)
    jvm_flags = [
        "-Djdk.xml.maxGeneralEntitySizeLimit=0",
        "-Djdk.xml.totalEntitySizeLimit=0",
    ],
    # not part of //...; cached on the converter and the mirror's manifest hash (--test_env)
    tags = ["manual"],
    test_class = "dev.groknull.kludgeworks.eu.legislation.viewer.text.infra.CorpusTests",
    visibility = ["//:__pkg__"],  # for the //:corpus suite
    runtime_deps = [
        "//src/main/resources/dev/groknull/kludgeworks/eu/legislation/viewer/text/infra/xml:resources",
        "//src/test/resources/compare:resources",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        ":infra-test-lib",
        "//src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/text/infra",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_xmlunit_xmlunit_assertj3",
    ],
)
