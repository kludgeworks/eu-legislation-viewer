PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
PREFIX cmr: <http://publications.europa.eu/ontology/cdm/cmr#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX annotation: <http://publications.europa.eu/ontology/annotation#>

SELECT DISTINCT
  ?work
  ?creationDate ?lastModificationDate
  ?title ?version ?dateCreation ?dateDocument ?embargo ?createdBy
  (GROUP_CONCAT(DISTINCT ?idDocument; separator="||") AS ?idDocuments)
  ?celexNumber ?sectorId ?eli ?inForce ?numberCorrigendum
  ?dateEntryIntoForce ?dateEndOfValidity
  ?basedOnTreaty ?basedOnResource
  ?signatory ?signatoryFunction
  ?legalType ?legalYear ?eea
  (GROUP_CONCAT(DISTINCT STR(?repealsRes); separator="||") AS ?repealsResources)
  (GROUP_CONCAT(DISTINCT STR(?implicitlyRepealsRes); separator="||") AS ?implicitlyRepealsResources)
  (GROUP_CONCAT(DISTINCT STR(?expression); separator="||") AS ?expressions)
  (GROUP_CONCAT(DISTINCT STR(?subdivision); separator="||") AS ?subdivisions)
  (GROUP_CONCAT(DISTINCT STR(?relatedWork); separator="||") AS ?relatedWorks)
  (GROUP_CONCAT(DISTINCT ?amendsRelationString; separator="||") AS ?amendsRelations)
  (GROUP_CONCAT(DISTINCT ?amendedByRelationString; separator="||") AS ?amendedByRelations)
  (GROUP_CONCAT(DISTINCT ?consolidatesRelationString; separator="||") AS ?consolidatesRelations)
  (GROUP_CONCAT(DISTINCT ?consolidatedByRelationString; separator="||") AS ?consolidatedByRelations)
  (GROUP_CONCAT(DISTINCT STR(?correction); separator="||") AS ?corrections)
  (GROUP_CONCAT(DISTINCT STR(?correctedBy); separator="||") AS ?correctedByResources)
  (GROUP_CONCAT(DISTINCT STR(?citesWork); separator="||") AS ?citedWorks)
  (GROUP_CONCAT(DISTINCT STR(?citedByWork); separator="||") AS ?citedByWorks)
  (GROUP_CONCAT(DISTINCT STR(?subjectMatter); separator="||") AS ?subjectMatters)
  (GROUP_CONCAT(DISTINCT STR(?eurovoc); separator="||") AS ?eurovocConcepts)
  (GROUP_CONCAT(DISTINCT STR(?directoryCode); separator="||") AS ?directoryCodes)
WHERE {
  {
    ?work cdm:work_id_document ?docId .
    FILTER(
      STR(?docId) = ?X-KW-ID ||
      # Check if ID matches the end of the document ID (for prefixed IDs)
      REGEX(STR(?docId), CONCAT(":", ?X-KW-ID, "$")) ||
      # Check if parameter includes prefix but needs to match unprefixed value
      (REGEX(?X-KW-ID, "^(celex:|planjo:|immc:|oj:)(.+)$") &&
       REGEX(STR(?docId), CONCAT(":", REPLACE(?X-KW-ID, "^(celex:|planjo:|immc:|oj:)", ""), "$")))
    )
  }

  # CdmEntity properties
  OPTIONAL { ?work cmr:creationDate ?creationDate }
  OPTIONAL { ?work cmr:lastModificationDate ?lastModificationDate }

  # Work properties
  OPTIONAL { ?work cdm:work_title ?title }
  OPTIONAL { ?work cdm:work_version ?version }
  OPTIONAL { ?work cdm:work_date_creation ?dateCreation }
  OPTIONAL { ?work cdm:work_date_document ?dateDocument }
  OPTIONAL { ?work cdm:work_embargo ?embargo }
  OPTIONAL { ?work cdm:work_created_by_agent ?createdBy }
  OPTIONAL { ?work cdm:work_id_document ?idDocument }

  # Legal Resource properties
  OPTIONAL { ?work cdm:resource_legal_id_celex ?celexNumber }
  OPTIONAL { ?work cdm:resource_legal_id_sector ?sectorId }
  OPTIONAL { ?work cdm:resource_legal_eli ?eli }
  OPTIONAL { ?work cdm:resource_legal_in-force ?inForce }
  OPTIONAL { ?work cdm:resource_legal_number_corrigendum ?numberCorrigendum }
  OPTIONAL { ?work cdm:resource_legal_date_entry-into-force ?dateEntryIntoForce }
  OPTIONAL { ?work cdm:resource_legal_date_end-of-validity ?dateEndOfValidity }
  OPTIONAL { ?work cdm:resource_legal_based_on_concept_treaty ?basedOnTreaty }
  OPTIONAL { ?work cdm:resource_legal_based_on_resource_legal ?basedOnResource }
  OPTIONAL { ?work cdm:resource_legal_signatory_name ?signatory }
  OPTIONAL { ?work cdm:resource_legal_signatory_function ?signatoryFunction }
  OPTIONAL { ?work cdm:resource_legal_type ?legalType }
  OPTIONAL { ?work cdm:resource_legal_year ?legalYear }
  OPTIONAL { ?work cdm:resource_legal_eea ?eea }
  OPTIONAL { ?work cdm:resource_legal_repeals_resource_legal ?repealsRes }
  OPTIONAL { ?work cdm:resource_legal_implicitly_repeals_resource_legal ?implicitlyRepealsRes }

  # Related entities
  OPTIONAL { ?expression cdm:expression_belongs_to_work ?work }
  OPTIONAL { ?subdivision cdm:work_part_of_work ?work } # Assuming this is the correct inverse for cdm:work_contains_subdivision
  OPTIONAL { ?work cdm:work_related_to_work ?relatedWork }

  # Amendment relationships (Work amends otherResource)
  OPTIONAL {
    ?work cdm:resource_legal_amends_resource_legal ?otherResourceAmendedByThis .
    OPTIONAL { ?work cdm:work_date_document ?thisWorkDateDocForAmends . }
    OPTIONAL {
      ?amendsAxiom owl:annotatedSource ?work ;
                     owl:annotatedProperty cdm:resource_legal_amends_resource_legal ;
                     owl:annotatedTarget ?otherResourceAmendedByThis ;
                     annotation:reference_to_modified_location ?amendsSpecificProvisions .
    }
    BIND(CONCAT(STR(?otherResourceAmendedByThis), "##", COALESCE(STR(?thisWorkDateDocForAmends), ""), "##", COALESCE(STR(?amendsSpecificProvisions), "")) AS ?amendsRelationString)
  }

  # AmendedBy relationships (otherResource amends this Work)
  OPTIONAL {
    ?otherResourceAmendingThis cdm:resource_legal_amends_resource_legal ?work .
    OPTIONAL { ?otherResourceAmendingThis cdm:work_date_document ?otherWorkDateDocForAmendedBy . }
    OPTIONAL {
      ?amendedByAxiom owl:annotatedSource ?otherResourceAmendingThis ;
                       owl:annotatedProperty cdm:resource_legal_amends_resource_legal ;
                       owl:annotatedTarget ?work ;
                       annotation:reference_to_modified_location ?amendedBySpecificProvisions .
    }
    BIND(CONCAT(STR(?otherResourceAmendingThis), "##", COALESCE(STR(?otherWorkDateDocForAmendedBy), ""), "##", COALESCE(STR(?amendedBySpecificProvisions), "")) AS ?amendedByRelationString)
  }

  # Consolidation relationships (Work consolidates otherResource) - This case might be less common for a single Work query
  OPTIONAL {
     ?work cdm:act_consolidated_consolidates_resource_legal ?otherResourceConsolidatedByThis .
     OPTIONAL { ?work cdm:act_consolidated_date ?thisWorkConsolidationDate . }
     BIND(CONCAT(STR(?otherResourceConsolidatedByThis), "##", COALESCE(STR(?thisWorkConsolidationDate), "")) AS ?consolidatesRelationString)
  }

  # ConsolidatedBy relationships (otherResource consolidates this Work)
  OPTIONAL {
    ?otherResourceConsolidatingThis cdm:act_consolidated_consolidates_resource_legal ?work .
    OPTIONAL { ?otherResourceConsolidatingThis cdm:act_consolidated_date ?otherWorkConsolidationDate . }
    BIND(CONCAT(STR(?otherResourceConsolidatingThis), "##", COALESCE(STR(?otherWorkConsolidationDate), "")) AS ?consolidatedByRelationString)
  }

  # Correction relationships
  OPTIONAL { ?work cdm:resource_legal_corrects_resource_legal ?correction } # ?work corrects ?correction
  OPTIONAL { ?correctedBy cdm:resource_legal_corrects_resource_legal ?work } # ?correctedBy corrects ?work

  # Citation relationships
  OPTIONAL { ?work cdm:work_cites_work ?citesWork }
  OPTIONAL { ?citedByWork cdm:work_cites_work ?work }

  # Subject classifications
  OPTIONAL { ?work cdm:resource_legal_is_about_subject-matter ?subjectMatter }
  OPTIONAL { ?work cdm:work_is_about_concept_eurovoc ?eurovoc }
  OPTIONAL { ?work cdm:resource_legal_is_about_concept_directory-code ?directoryCode }
}
GROUP BY ?work ?creationDate ?lastModificationDate ?title ?version ?dateCreation
         ?dateDocument ?embargo ?createdBy ?celexNumber ?sectorId ?eli ?inForce
         ?numberCorrigendum ?dateEntryIntoForce ?dateEndOfValidity ?basedOnTreaty
         ?basedOnResource ?signatory ?signatoryFunction ?legalType ?legalYear ?eea