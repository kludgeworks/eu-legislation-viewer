PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
PREFIX cmr: <http://publications.europa.eu/ontology/cdm/cmr#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT
  ?manifestation
  ?creationDate ?lastModificationDate
  ?date ?datePublication ?dimension ?embargo ?isSigned
  ?catalogueNumberGlobal ?type ?version
  ?publishedByUri ?manifestsExpressionUri
WHERE {
  ?manifestation cdm:manifestation_manifests_expression ?X-KW-EXPRESSION-URI .
  
  # Set the manifestsExpressionUri to the expression URI parameter
  BIND(?X-KW-EXPRESSION-URI AS ?manifestsExpressionUri)
  
  # CdmEntity properties (from base class)
  OPTIONAL { ?manifestation cmr:creationDate ?creationDate }
  OPTIONAL { ?manifestation cmr:lastModificationDate ?lastModificationDate }
  
  # Manifestation properties
  OPTIONAL { ?manifestation cdm:manifestation_date ?date }
  OPTIONAL { ?manifestation cdm:manifestation_date_publication ?datePublication }
  OPTIONAL { ?manifestation cdm:manifestation_dimension ?dimension }
  OPTIONAL { ?manifestation cdm:manifestation_embargo ?embargo }
  OPTIONAL { ?manifestation cdm:manifestation_is-signed ?isSigned }
  OPTIONAL { ?manifestation cdm:manifestation_number_catalogue_global ?catalogueNumberGlobal }
  OPTIONAL { ?manifestation cdm:manifestation_type ?type }
  OPTIONAL { ?manifestation cdm:manifestation_version ?version }
  OPTIONAL { ?manifestation cdm:manifestation_published_by_agent ?publishedByUri }
}