PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
PREFIX cmr: <http://publications.europa.eu/ontology/cdm/cmr#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT
  ?expression
  ?creationDate ?lastModificationDate
  ?date ?edition ?embargo ?source ?title ?version ?language
  ?belongsToWorkUri
WHERE {
  ?expression cdm:expression_belongs_to_work ?X-KW-WORK-URI ;
             cmr:lang ?language .
  
  # Set the belongsToWorkUri to the work URI parameter
  BIND(?X-KW-WORK-URI AS ?belongsToWorkUri)
  
  # CdmEntity properties (from base class)
  OPTIONAL { ?expression cmr:creationDate ?creationDate }
  OPTIONAL { ?expression cmr:lastModificationDate ?lastModificationDate }
  
  # Expression properties
  OPTIONAL { ?expression cdm:expression_date ?date }
  OPTIONAL { ?expression cdm:expression_edition ?edition }
  OPTIONAL { ?expression cdm:expression_embargo ?embargo }
  OPTIONAL { ?expression cdm:expression_source ?source }
  OPTIONAL { ?expression cdm:expression_title ?title }
  OPTIONAL { ?expression cdm:expression_version ?version }
}
ORDER BY ?language