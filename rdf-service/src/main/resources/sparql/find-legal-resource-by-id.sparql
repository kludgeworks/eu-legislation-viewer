PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
PREFIX cmr: <http://publications.europa.eu/ontology/cdm/cmr#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX eli: <http://data.europa.eu/eli/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX annotation: <http://publications.europa.eu/ontology/annotation#>

SELECT DISTINCT
    ?work
    (GROUP_CONCAT(DISTINCT ?type; separator="|") AS ?types)
    ?creationDate ?lastModificationDate
    ?title ?version
    ?dateCreation ?dateDocument ?embargo
    ?createdBy
    (GROUP_CONCAT(DISTINCT ?idDocument; separator="|") AS ?idDocuments)
    ?celexNumber ?sectorId ?eli ?inForce ?numberCorrigendum
    (GROUP_CONCAT(DISTINCT ?expression; separator="|") AS ?expressions)
    (GROUP_CONCAT(DISTINCT ?subdivision; separator="|") AS ?subdivisions)
    (GROUP_CONCAT(DISTINCT ?relatedWork; separator="|") AS ?relatedWorks)
    (GROUP_CONCAT(DISTINCT ?amendsLegalResource; separator="|") AS ?amendedResources)
    (GROUP_CONCAT(DISTINCT ?amendedByLegalResource; separator="|") AS ?amendingResources)
    (GROUP_CONCAT(DISTINCT ?consolidatesResource; separator="|") AS ?consolidatedResources)
    (GROUP_CONCAT(DISTINCT ?consolidatedByAct; separator="|") AS ?consolidatingResources)
WHERE {
    {
        ?work cdm:work_id_document ?docId .
        FILTER(
            STR(?docId) = ?X-KW-ID ||
            # Check if ID matches the end of the document ID (for prefixed IDs)
            REGEX(STR(?docId), CONCAT(":", ?X-KW-ID, "$")) ||
            # Check if parameter includes prefix but needs to match unprefixed value
            (REGEX(?X-KW-ID, "^(celex:|planjo:|immc:|oj:)(.+)$") &&
            REGEX(STR(?docId), CONCAT(":", REPLACE(?X-KW-ID, "^(celex:|planjo:|immc:|oj:)", ""), "$")))
        )
    }

    # Get the type(s)
    OPTIONAL { ?work rdf:type ?type }

    # All predicates made OPTIONAL
    OPTIONAL { ?work cmr:creationDate ?creationDate }
    OPTIONAL { ?work cmr:lastModificationDate ?lastModificationDate }
    OPTIONAL { ?work cdm:work_title ?title }
    OPTIONAL { ?work cdm:work_version ?version }
    OPTIONAL { ?work cdm:work_date_creation ?dateCreation }
    OPTIONAL { ?work cdm:work_date_document ?dateDocument }
    OPTIONAL { ?work cdm:work_embargo ?embargo }
    OPTIONAL { ?work cdm:work_created_by_agent ?createdBy }
    OPTIONAL { ?work cdm:work_id_document ?idDocument }
    
    # Legal Resource properties
    OPTIONAL { ?work cdm:resource_legal_id_celex ?celexNumber }
    OPTIONAL { ?work cdm:resource_legal_id_sector ?sectorId }
    OPTIONAL { ?work cdm:resource_legal_eli ?eli }
    OPTIONAL { ?work cdm:resource_legal_in-force ?inForce }
    OPTIONAL { ?work cdm:resource_legal_number_corrigendum ?numberCorrigendum }
    
    # Related entities - using inverse relationships where needed
    OPTIONAL { ?expression cdm:expression_belongs_to_work ?work }
    OPTIONAL { ?subdivision cdm:work_part_of_work ?work }
    OPTIONAL { ?work cdm:work_related_to_work ?relatedWork }
    
    # Amendment relationships
    OPTIONAL { ?work cdm:resource_legal_amends_resource_legal ?amendsLegalResource }
    OPTIONAL { ?amendedByLegalResource cdm:resource_legal_amends_resource_legal ?work }
    
    # Consolidation relationships
    OPTIONAL { ?work cdm:act_consolidated_consolidates_resource_legal ?consolidatesResource }
    OPTIONAL { ?consolidatedByAct cdm:act_consolidated_consolidates_resource_legal ?work }
}
GROUP BY ?work ?creationDate ?lastModificationDate ?title ?version ?dateCreation 
         ?dateDocument ?embargo ?createdBy ?celexNumber ?sectorId ?eli ?inForce ?numberCorrigendum