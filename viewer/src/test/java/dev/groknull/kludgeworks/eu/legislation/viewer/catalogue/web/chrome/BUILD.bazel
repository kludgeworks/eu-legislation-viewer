load("@contrib_rules_jvm//java:defs.bzl", "java_test_suite")

# The pages' chrome: the theme switch
java_test_suite(
    name = "chrome",
    size = "small",
    srcs = glob(["*Test.java"]),
    runner = "junit5",
    runtime_deps = [
        "@maven//:org_apache_tomcat_embed_tomcat_embed_core",  # the servlet API, which the app compiles against only
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/catalogue/web/chrome",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_springframework_spring_test",
        "@maven//:org_springframework_spring_web",
    ],
)
