# SPDX-License-Identifier: MIT
load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test", "java_library", "java_test_suite")

# The content module's domain: how a place is named. One test target per *Test.java
java_test_suite(
    name = "content",
    size = "small",
    srcs = glob(["*Test.java"]),
    runner = "junit5",
    runtime_deps = [
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# Legal texts stored in Postgres in a container, and read back from it; needs Docker
java_junit5_test(
    name = "ContentTests",
    size = "medium",
    timeout = "short",
    srcs = ["ContentTests.java"],
    tags = [
        "cpu:4",  # its cores reserved: tests run at once would otherwise starve one another
        "requires-docker",
    ],
    test_class = "dev.groknull.kludgeworks.eu.legislation.viewer.content.ContentTests",
    runtime_deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer",
        "@maven//:ch_qos_logback_logback_classic",  # the log lines, in the test's log
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        ":legal-texts",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content:model",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "//viewer/src/test/java/dev/groknull/kludgeworks/eu/legislation/viewer:api-schemas",
        "//viewer/src/test/java/dev/groknull/kludgeworks/eu/legislation/viewer:testing",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_awaitility_awaitility",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_springframework_boot_spring_boot_test",
        "@maven//:org_springframework_spring_beans",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_jdbc",
        "@maven//:org_springframework_spring_tx",
    ],
)

# model/
# The legal texts the tests encode: the converter's expected output for its fixtures, and their
# elements as the converter wrote them
java_library(
    name = "legal-texts",
    testonly = True,
    srcs = ["model/LegalTexts.java"],
    data = ["//libs/formex-converter:expected"],
    visibility = ["//viewer:__subpackages__"],
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content:model",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@rules_java//java/runfiles",
    ],
)

# Legal texts written as JSON and read back, as the converter wrote them
java_test_suite(
    name = "model",
    size = "small",
    srcs = ["model/EncoderTest.java"],
    runner = "junit5",
    runtime_deps = [
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        ":legal-texts",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content:model",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
    ],
)

# Legal texts in the public model, checked against its JSON Schema
java_test_suite(
    name = "public",
    size = "small",
    srcs = ["model/PublicTextsTest.java"],
    runner = "junit5",
    runtime_deps = [
        "//viewer/src/main/resources",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        ":legal-texts",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content:model",
        "//viewer/src/test/java/dev/groknull/kludgeworks/eu/legislation/viewer:api-schemas",
        "@maven//:com_networknt_json_schema_validator",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
        "@maven//:tools_jackson_core_jackson_databind",
    ],
)

# Every version of an act, from a directory of legal-text files, written as JSON and read back; run
# by hand, not by bazel test //...: --test_env=LEGAL_TEXT_DIR=<dir> (see VersionsRoundTrip)
java_junit5_test(
    name = "versions",
    size = "enormous",
    srcs = ["model/VersionsRoundTrip.java"],
    jvm_flags = ["-Xmx8g"],
    tags = ["manual"],
    test_class = "dev.groknull.kludgeworks.eu.legislation.viewer.content.model.VersionsRoundTrip",
    runtime_deps = [
        "@maven//:ch_qos_logback_logback_classic",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        ":legal-texts",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content:model",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
        "@maven//:org_slf4j_slf4j_api",
    ],
)
