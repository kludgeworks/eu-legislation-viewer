# SPDX-License-Identifier: MIT
load("@contrib_rules_jvm//java:defs.bzl", "java_library", "java_test_suite")

# One test target per *Test.java: against Cellar's recorded answers to the acts queries
java_test_suite(
    name = "infra",
    size = "small",
    srcs = glob(["*Test.java"]),
    runner = "junit5",
    runtime_deps = [
        "//viewer/src/test/resources/acts:resources",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        ":recorded-acts",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/catalogue",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/catalogue/infra",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/cellar",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# The acts as Cellar's recorded answers make them, for other modules' tests too
java_library(
    name = "recorded-acts",
    testonly = True,
    srcs = ["RecordedActs.java"],
    visibility = ["//viewer:__subpackages__"],
    runtime_deps = ["//viewer/src/test/resources/acts:resources"],
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/catalogue",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/catalogue/infra",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/cellar",
    ],
)
