# SPDX-License-Identifier: MIT
load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test", "java_test_suite")
load("@rules_java//java:defs.bzl", "java_library")

# The legal texts the tests encode: the converter's expected output for its fixtures
java_library(
    name = "legal-texts",
    testonly = True,
    srcs = ["LegalTexts.java"],
    data = ["//formex-converter:expected"],
    visibility = ["//viewer:__subpackages__"],
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content/model",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@rules_java//java/runfiles",
    ],
)

# Legal texts encoded into the tree and rebuilt from it, as they were
java_test_suite(
    name = "model",
    size = "small",
    srcs = [
        "EncoderTest.java",
        "SegmentationTest.java",
    ],
    runner = "junit5",
    runtime_deps = [
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        ":legal-texts",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content/model",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
    ],
)

# Every version of an act, from a directory of legal-text files, rebuilt from one shared tree; run
# by hand, not by bazel test //...: --test_env=LEGAL_TEXT_DIR=<dir> (see VersionsRoundTrip)
java_junit5_test(
    name = "versions",
    size = "enormous",
    srcs = ["VersionsRoundTrip.java"],
    jvm_flags = ["-Xmx8g"],
    tags = ["manual"],
    test_class = "dev.groknull.kludgeworks.eu.legislation.viewer.content.model.VersionsRoundTrip",
    runtime_deps = [
        "@maven//:ch_qos_logback_logback_classic",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        ":legal-texts",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content/model",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
        "@maven//:org_slf4j_slf4j_api",
    ],
)
