# SPDX-License-Identifier: MIT
load("@contrib_rules_jvm//java:defs.bzl", "java_binary", "java_test_suite")

# The legal text's templates on the converter's samples: one each, and running text as it reads
java_test_suite(
    name = "legaltext",
    size = "small",
    srcs = glob(["*Test.java"]),
    data = ["//formex-converter:legal-text.xsd"],
    jvm_flags = ["-Dlegal-text.xsd=$(rootpath //formex-converter:legal-text.xsd)"],
    runner = "junit5",
    runtime_deps = [
        "//viewer/src/main/jte",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content:model",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/legaltext",
        "//viewer/src/test/java/dev/groknull/kludgeworks/eu/legislation/viewer/content:legal-texts",
        "@maven//:gg_jte_jte_runtime",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_jsoup_jsoup",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
    ],
)

# Renders a folder of legal texts as the viewer shows them, a page each (mise run text:survey)
java_binary(
    name = "render_texts",
    testonly = True,
    srcs = ["RenderTexts.java"],
    main_class = "dev.groknull.kludgeworks.eu.legislation.viewer.legaltext.RenderTexts",
    runtime_deps = ["//viewer/src/main/jte"],
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content:model",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/legaltext",
        "//viewer/src/test/java/dev/groknull/kludgeworks/eu/legislation/viewer/content:legal-texts",
        "@maven//:gg_jte_jte_runtime",
    ],
)

# The fragments' controller alone (@WebMvcTest, MockMvc), the content mocked: how browsers cache the
# fragments (entity tags, 304, Cache-Control). No store, no containers.
java_test_suite(
    name = "controllers",
    size = "small",
    srcs = glob(["*ControllerTests.java"]),
    data = ["@maven//:org_mockito_mockito_core"],
    # Mockito as an agent, as its documentation asks: the JDK will stop it attaching itself
    jvm_flags = ["-javaagent:$(rootpath @maven//:org_mockito_mockito_core)"],
    runner = "junit5",
    test_suffixes = ["ControllerTests.java"],
    runtime_deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/chrome",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/legaltext",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_mockito_mockito_core",
        "@maven//:org_springframework_boot_spring_boot_test",
        "@maven//:org_springframework_boot_spring_boot_webmvc_test",
        "@maven//:org_springframework_spring_beans",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_test",
        "@maven//:org_springframework_spring_web",
    ],
)
