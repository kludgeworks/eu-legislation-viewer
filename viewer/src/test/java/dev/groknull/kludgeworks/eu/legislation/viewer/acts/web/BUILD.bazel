load("@contrib_rules_jvm//java:defs.bzl", "java_test_suite")

# The act resource on Spring MVC's test support (MockMvc), on acts held in memory
java_test_suite(
    name = "web",
    size = "small",
    srcs = glob(["*.java"]),
    runner = "junit5",
    # Spring's naming for tests in a Spring context
    test_suffixes = ["Tests.java"],
    runtime_deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer",  # ViewerApplication: the slice's configuration
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
        "@maven//:org_springframework_boot_spring_boot_starter_hateoas",
        "@maven//:org_springframework_boot_spring_boot_starter_webmvc",
    ],
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/acts",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/acts/web",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/cellar",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_jmolecules_integrations_jmolecules_jackson3",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_springframework_boot_spring_boot_autoconfigure",
        "@maven//:org_springframework_boot_spring_boot_test",
        "@maven//:org_springframework_boot_spring_boot_webmvc_test",
        "@maven//:org_springframework_hateoas_spring_hateoas",
        "@maven//:org_springframework_spring_beans",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_core",
        "@maven//:org_springframework_spring_test",
        "@maven//:org_springframework_spring_web",
    ],
)
