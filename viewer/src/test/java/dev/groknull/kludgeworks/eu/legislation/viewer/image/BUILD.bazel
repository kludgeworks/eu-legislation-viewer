load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test", "java_test_suite")

# Unit tests for TIFF decoding / WebP encoding and ImageService coalescing, digest pinning, and
# cleanup listeners.
java_test_suite(
    name = "unit",
    size = "small",
    srcs = [
        "application/ImageServiceTest.java",
        "infra/TiffWebpRendererTest.java",
    ],
    runner = "junit5",
    runtime_deps = [
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/image",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/image:application",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/image:infra",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/image:model",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "@maven//:dev_matrixlab_webp4j_webp4j_core",
        "@maven//:io_micrometer_micrometer_observation",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_springframework_spring_tx",
    ],
)

