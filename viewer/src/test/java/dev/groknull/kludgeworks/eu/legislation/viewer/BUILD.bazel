load("@contrib_rules_jvm//java:defs.bzl", "java_test_suite")
load("@rules_java//java:defs.bzl", "java_binary", "java_library")

# The viewer for running locally (TestViewerApplication), and what the whole-application checks share
java_library(
    name = "testing",
    testonly = True,
    srcs = [
        "ProductionClasses.java",
        "TestViewerApplication.java",
    ],
    visibility = ["//viewer:__subpackages__"],
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer",
        "@maven//:com_tngtech_archunit_archunit",
        "@maven//:org_springframework_boot_spring_boot",
    ],
)

# bazel run //viewer:dev (mise run app:dev): the viewer for running locally
java_binary(
    name = "dev",
    testonly = True,
    main_class = "dev.groknull.kludgeworks.eu.legislation.viewer.TestViewerApplication",
    visibility = ["//viewer:__pkg__"],
    runtime_deps = [":testing"],
)

# Writes the modules' documentation (mise run modules): Spring Modulith's Documenter, into
# viewer/spring-modulith-docs, not committed
java_binary(
    name = "modules",
    testonly = True,
    srcs = ["ModuleDocumentation.java"],
    main_class = "dev.groknull.kludgeworks.eu.legislation.viewer.ModuleDocumentation",
    deps = [
        ":testing",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer",
        "@maven//:com_tngtech_archunit_archunit",
        "@maven//:org_springframework_modulith_spring_modulith_core",
        "@maven//:org_springframework_modulith_spring_modulith_docs",
    ],
)

# Whole-application checks: the module structure (Spring Modulith), and that the app starts, on
# Bazel's classpath and as Spring Boot's jar
java_test_suite(
    name = "viewer",
    size = "small",
    srcs = glob(
        ["*.java"],
        exclude = [
            "ModuleDocumentation.java",
            "ProductionClasses.java",
            "TestViewerApplication.java",
        ],
    ),
    data = ["//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer:viewer-app"],
    runner = "junit5",
    # Spring's naming for whole-application checks
    test_suffixes = ["Tests.java"],
    runtime_deps = [
        "@maven//:org_jmolecules_integrations_jmolecules_archunit",  # jMolecules' rules in verify()
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        ":testing",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer",
        "@maven//:com_tngtech_archunit_archunit",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_jmolecules_jmolecules_ddd",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_springframework_boot_spring_boot_test",
        "@maven//:org_springframework_modulith_spring_modulith_core",
        "@maven//:org_springframework_spring_beans",
        "@rules_java//java/runfiles",
    ],
)
