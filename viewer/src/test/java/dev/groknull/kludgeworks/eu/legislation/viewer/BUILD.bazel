# SPDX-License-Identifier: MIT
load("@contrib_rules_jvm//java:defs.bzl", "java_binary", "java_junit5_test", "java_library", "java_test_suite")

# The app's store in a container (Testcontainers), for the tests that need one, and the viewer on it
# for running locally (TestViewerApplication, with Grafana's OpenTelemetry stack: ObservabilityContainers)
java_library(
    name = "testing",
    testonly = True,
    srcs = [
        "ObservabilityContainers.java",
        "ProductionClasses.java",
        "TestViewerApplication.java",
        "TestcontainersConfiguration.java",
    ],
    visibility = ["//viewer:__subpackages__"],
    deps = [
        "//tools/build/src/main/java/dev/groknull/kludgeworks/build/flyway",
        "//tools/build/src/main/java/dev/groknull/kludgeworks/build/postgres",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer",
        "@maven//:com_tngtech_archunit_archunit",
        "@maven//:org_flywaydb_flyway_core",
        "@maven//:org_springframework_boot_spring_boot",
        "@maven//:org_springframework_boot_spring_boot_flyway",
        "@maven//:org_springframework_boot_spring_boot_test",
        "@maven//:org_springframework_boot_spring_boot_testcontainers",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_testcontainers_testcontainers",
        "@maven//:org_testcontainers_testcontainers_grafana",
        "@maven//:org_testcontainers_testcontainers_postgresql",
    ],
)

# bazel run //viewer:dev (mise run app:dev): the viewer with its store and Grafana in containers;
# needs Docker. Testcontainers' reuse: the running Postgres, and what was ingested into it, outlive
# the app (the tests never reuse it: they'd share one store)
java_binary(
    name = "dev",
    testonly = True,
    env = {"TESTCONTAINERS_REUSE_ENABLE": "true"},
    main_class = "dev.groknull.kludgeworks.eu.legislation.viewer.TestViewerApplication",
    visibility = ["//viewer:__pkg__"],
    runtime_deps = [":testing"],
)

# Writes the modules' documentation (mise run modules): Spring Modulith's Documenter, into
# viewer/spring-modulith-docs, not committed
java_binary(
    name = "modules",
    testonly = True,
    srcs = ["ModuleDocumentation.java"],
    main_class = "dev.groknull.kludgeworks.eu.legislation.viewer.ModuleDocumentation",
    deps = [
        ":testing",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer",
        "@maven//:com_tngtech_archunit_archunit",
        "@maven//:org_springframework_modulith_spring_modulith_core",
        "@maven//:org_springframework_modulith_spring_modulith_docs",
    ],
)

# Whole-application checks: the module structure (Spring Modulith), and that the app starts, on
# Bazel's classpath and as Spring Boot's jar, on Postgres in a container (Docker)
java_test_suite(
    name = "viewer",
    size = "medium",
    timeout = "short",
    srcs = glob(
        ["*.java"],
        exclude = [
            "ModuleDocumentation.java",
            "ObservabilityContainers.java",
            "ProductionClasses.java",
            "TestViewerApplication.java",
            "TestcontainersConfiguration.java",
            "ViewerJarContentsTest.java",
        ],
    ),
    data = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer:viewer-app",
        "//viewer/src/main/resources:migrations",
    ],
    runner = "junit5",
    tags = [
        "cpu:4",  # its cores reserved: tests run at once would otherwise starve one another
        "requires-docker",
    ],
    # Spring's naming for whole-application checks
    test_suffixes = ["Tests.java"],
    runtime_deps = [
        "@maven//:org_jmolecules_integrations_jmolecules_archunit",  # jMolecules' rules in verify()
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        ":testing",
        "//tools/build/src/main/java/dev/groknull/kludgeworks/build/flyway",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer",
        "@maven//:com_tngtech_archunit_archunit",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_jmolecules_jmolecules_ddd",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jooq_jooq",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_springframework_boot_spring_boot_test",
        "@maven//:org_springframework_modulith_spring_modulith_core",
        "@maven//:org_springframework_spring_beans",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_testcontainers_testcontainers_postgresql",
        "@rules_java//java/runfiles",
    ],
)

# What Spring Boot's jar holds: the app, its libraries once each, no test libraries, and the
# production resources; read from the jar, so no Docker
java_junit5_test(
    name = "ViewerJarContentsTest",
    size = "small",
    srcs = ["ViewerJarContentsTest.java"],
    data = ["//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer:viewer-app"],
    test_class = "dev.groknull.kludgeworks.eu.legislation.viewer.ViewerJarContentsTest",
    runtime_deps = [
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@rules_java//java/runfiles",
    ],
)
