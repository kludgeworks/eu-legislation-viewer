# The parts' controller alone (@WebMvcTest, MockMvc), what it asks of the modules mocked: what it
# refuses, where its links lead. No store, no containers.
java_test_suite(
    name = "controllers",
    size = "small",
    srcs = glob(["web/*ControllerTests.java"]),
    data = ["@maven//:org_mockito_mockito_core"],
    # Mockito as an agent, as its documentation asks: the JDK will stop it attaching itself
    jvm_flags = ["-javaagent:$(rootpath @maven//:org_mockito_mockito_core)"],
    runner = "junit5",
    test_suffixes = ["ControllerTests.java"],
    runtime_deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/catalogue",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/chrome",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/comparison",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/comparison:model",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/comparison:web",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/legaltext",
        "//viewer/src/main/jte",
        "//viewer/src/test/java/dev/groknull/kludgeworks/eu/legislation/viewer/catalogue:one-act-cellar",
        "@maven//:gg_jte_jte_runtime",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_jsoup_jsoup",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_mockito_mockito_core",
        "@maven//:org_springframework_boot_spring_boot_test",
