# The glue of the rules: the steps, and the domain's types for them
RULES_GLUE = [
    "model/ApplicabilitySteps.java",
    "model/AttributionSteps.java",
    "model/Cited.java",
    "model/Comparing.java",
    "model/DifferenceSteps.java",
    "model/LastChangeSteps.java",
    "model/MadeBySteps.java",
    "model/ModificationSteps.java",
    "model/OneActSteps.java",
    "model/PairingSteps.java",
    "model/TagsSteps.java",
    "model/Types.java",
]

# model/ (the rules)
# The business rules that the comparison's domain applies (viewer/src/test/rules/comparison), run
# by Cucumber. The steps depend on the domains of the comparison, the content and the catalogue
# only: a rule that only a view or a controller applies cannot be tested here.
# One exception: catalogue:recorded-acts, the acts as Cellar's recorded answers make them. It
# depends on catalogue:infra, which parses those answers. So the steps can reach the catalogue's
# infrastructure, though they must call only its domain. The comparison's web and view stay out
# of reach. Kept for now, to see how big the problem becomes (decided 2026-11-22).
java_junit5_test(
    name = "rules",
    size = "small",
    srcs = RULES_GLUE + ["model/ComparisonRules.java"],
    test_class = "dev.groknull.kludgeworks.eu.legislation.viewer.comparison.model.ComparisonRules",
    runtime_deps = [
        "//tools/build/src/main/java/dev/groknull/kludgeworks/build/rules",
        "//viewer/src/test/rules",
        "@maven//:io_cucumber_cucumber_junit_platform_engine",
        "@maven//:io_cucumber_cucumber_picocontainer",  # one instance of each step class a scenario; Comparing shared by constructor
        "@maven//:org_junit_jupiter_junit_jupiter_api",  # the runner checks for Jupiter
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
        "@maven//:org_junit_platform_junit_platform_suite_engine",
    ],
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/catalogue",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/comparison",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/comparison:model",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content:model",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "//viewer/src/test/java/dev/groknull/kludgeworks/eu/legislation/viewer/catalogue:recorded-acts",
        "//viewer/src/test/java/dev/groknull/kludgeworks/eu/legislation/viewer/content:legal-texts",
        "@maven//:io_cucumber_cucumber_java",
        "@maven//:io_cucumber_cucumber_junit_platform_engine",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_junit_platform_junit_platform_suite_api",
    ],
)

