    name = "ComparisonsTests",
    size = "small",
    srcs = ["ComparisonsTests.java"],
    tags = ["requires-docker"],
    test_class = "dev.groknull.kludgeworks.eu.legislation.viewer.comparison.ComparisonsTests",
    runtime_deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer",
        "@maven//:ch_qos_logback_logback_classic",  # the log lines, in the test's log
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/comparison",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/test/java/dev/groknull/kludgeworks/eu/legislation/viewer:testing",
        "//viewer/src/test/java/dev/groknull/kludgeworks/eu/legislation/viewer/content/model:legal-texts",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_awaitility_awaitility",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_springframework_boot_spring_boot_test",
        "@maven//:org_springframework_spring_beans",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_jdbc",
        "@maven//:org_springframework_spring_tx",
    ],
