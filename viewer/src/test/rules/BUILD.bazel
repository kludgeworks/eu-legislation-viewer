load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test", "java_library")

# The business rules, as Gherkin features: one feature per area of rules, in the folder of the
# module whose domain applies them. Each module's rules suite (a Cucumber suite) runs its own, and
# the wiki is written from the run (//tools/build/src/main/java/dev/groknull/kludgeworks/build/rules)
# How a feature is written:
# - A Rule holds its name, in kebab case, and its title (Rule: tags-of-an-occurrence · The tags of
#   an occurrence), and its text. The name is unique in its feature, and @BusinessRule names it.
#   The tag @revision-<n> on the Rule gives its revision when it changes meaning (none is 1). It
#   has an example for each of its clauses, on real texts. Steps name places and acts as the pages
#   do.
# - Its words are ASD-STE100 Simplified Technical English: hk's vale step checks the rule names,
#   titles, descriptions and steps (.vale.ini). A rule's conditions, or the steps of a procedure,
#   are a list, its items started by "-": "*" is a step keyword. A step's words change with its
#   Cucumber expression, in the same change.
# - A Background in a Rule gives the step that all the Rule's examples start from. "But" starts a
#   negative step after a positive one. A quote longer than a line is a doc string (""").
# - The tag @known-bug marks an example that states what the domain should do, which a filed bug
#   makes fail today. Give it with the issue's number, @ISS-<n>: the wiki links to the issue
#   (https://www.notion.so/ISS-<n>). Each module's rules run leaves these examples out, and its
#   known-bugs run checks that each still fails: one that passes fails that run, because its bug
#   is fixed, so the tag goes and the issue closes.
java_library(
    name = "rules",
    testonly = True,
    resource_strip_prefix = "viewer/src/test",
    resources = glob(["**/*.feature"]),
    visibility = ["//viewer:__subpackages__"],
)

# The features as files, for the wiki's writer to compare with those of the last release
filegroup(
    name = "features",
    srcs = glob(["**/*.feature"]),
    visibility = ["//visibility:public"],
)

# Each rule has a name and an example, on each build, not only when the wiki is written. And
# each rule has a method of the viewer that applies it (@BusinessRule), unless its examples are all
# known bugs, and each such mark names a rule of a feature. The viewer's classes are on the test's
# classpath for that.
java_junit5_test(
    name = "RulesCheckTest",
    size = "small",
    srcs = ["RulesCheckTest.java"],
    data = [":features"],
    test_class = "rules.RulesCheckTest",
    runtime_deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        "//tools/build/src/main/java/dev/groknull/kludgeworks/build/rules",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@rules_java//java/runfiles",
    ],
)
