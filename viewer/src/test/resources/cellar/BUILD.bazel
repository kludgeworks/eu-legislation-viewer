load("@contrib_rules_jvm//java:defs.bzl", "java_library")

package(default_visibility = ["//viewer:__subpackages__"])

# Cellar's responses, recorded byte for byte (see SOURCE), on the classpath at /cellar/
java_library(
    name = "resources",
    resource_strip_prefix = "viewer/src/test/resources",
    resources = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)
