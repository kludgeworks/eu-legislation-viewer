load("@contrib_rules_jvm//java:defs.bzl", "java_binary", "java_test")

# tbls on the schema the migrations make, built on Postgres in Docker (SchemaDatabase), with
# .tbls.yml: the arguments both targets start with, then tbls's command and its configuration
SCHEMA_ARGS = [
    "viewer/src/main/resources/db/migration",
    "$(rootpath //tools/build:tbls)",
]

SCHEMA_CONFIG = [
    "--config",
    "$(rootpath //:.tbls.yml)",
]

SCHEMA_DATA = [
    "//:.tbls.yml",
    "//tools/build:tbls",
    "//viewer/src/main/resources:migrations",
]

SCHEMA_DATABASE = "//tools/build/src/main/java/dev/groknull/kludgeworks/build:schema_database"

# every table described (COMMENT ON) and in its module's viewpoint. SchemaDatabase's main is the
# test: it exits with tbls's status
java_test(
    name = "schema",
    args = SCHEMA_ARGS + ["lint"] + SCHEMA_CONFIG,
    data = SCHEMA_DATA,
    jvm_flags = ["-Dorg.slf4j.simpleLogger.defaultLogLevel=warn"],
    main_class = "dev.groknull.kludgeworks.build.SchemaDatabase",
    tags = ["requires-docker"],
    use_testrunner = False,
    runtime_deps = [SCHEMA_DATABASE],
)

# the schema's documentation and Mermaid diagrams, written into docs/database (mise run db:diagram)
java_binary(
    name = "diagram",
    args = SCHEMA_ARGS + [
        "doc",
        "--rm-dist",
    ] + SCHEMA_CONFIG,
    data = SCHEMA_DATA,
    jvm_flags = ["-Dorg.slf4j.simpleLogger.defaultLogLevel=warn"],
    main_class = "dev.groknull.kludgeworks.build.SchemaDatabase",
    runtime_deps = [SCHEMA_DATABASE],
)

# the pending migrations keep the schema the released code uses: expand, then contract, a release
# apart. ExpandContract's main is the test: it exits non-zero on a problem
java_test(
    name = "expand_contract",
    args = ["viewer/src/main/resources/db/migration"],
    data = ["//viewer/src/main/resources:migrations"],
    jvm_flags = ["-Dorg.slf4j.simpleLogger.defaultLogLevel=warn"],
    main_class = "dev.groknull.kludgeworks.build.ExpandContract",
    tags = ["requires-docker"],
    use_testrunner = False,
    runtime_deps = ["//tools/build/src/main/java/dev/groknull/kludgeworks/build:expand_contract"],
)
