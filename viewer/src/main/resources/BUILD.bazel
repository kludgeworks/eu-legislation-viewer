load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@contrib_rules_jvm//java:defs.bzl", "java_library")
load("//tools/build:defs.bzl", "build_info")

# Boot's build info (META-INF/build-info.properties): the release, from --embed_label, as
# BuildProperties, for the keys of the caches and the entity tags (chrome.Release) and /actuator/info
build_info(
    name = "build_info",
    artifact = "kludgeworks-viewer",
)

# the application's configuration (application.yaml), on the classpath root, and its build info
java_library(
    name = "resources",
    resources = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ) + [":build_info"],
    visibility = ["//viewer:__subpackages__"],
)

# each module's migrations, by their directory, whatever they're named: for its jOOQ classes
# (jooq_tables)
[
    filegroup(
        name = module + "_migrations",
        srcs = glob(["db/migration/%s/*.sql" % module]),
        visibility = ["//viewer:__subpackages__"],
    )
    for module in [
        "catalogue",
        "comparison",
        "content",
        "ingest",
    ]
]

# every module's migrations, the app's own (__root) too: for starting the jar on them as they are in
# the source (ViewerJarTests)
filegroup(
    name = "migrations",
    srcs = glob(["db/migration/**/*.sql"]),
    visibility = ["//viewer:__subpackages__"],
)

# The scripts of the pages, ES modules, for their tests and type check (//viewer/src/test/js)
js_library(
    name = "js",
    srcs = glob(["static/js/*.js"]),
    visibility = ["//viewer:__subpackages__"],
)
