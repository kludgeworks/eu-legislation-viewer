load("@rules_java//java:defs.bzl", "java_library")

# the application's configuration (application.yaml), on the classpath root
java_library(
    name = "resources",
    resources = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//viewer:__subpackages__"],
)

# each module's migrations, for its jOOQ classes (jooq_tables)
exports_files(
    glob(["db/migration/**/*.sql"]),
    visibility = ["//viewer:__subpackages__"],
)
