# SPDX-License-Identifier: MIT
# Gets the dates of an act, and the dates of every act that its consolidations integrate, for
# CellarDates. It gets each date of entry into force as Cellar has it, with the annotations that
# type the date:
# - The type of date, from the authority table fd_335. EV is entry into force, MA is application
#   and PE is taking effect. /PART means that the date applies to part of the act.
# - Cellar's comment on the date. For example, "DATPUB +20 V ART 2" means 20 days after
#   publication, see Article 2. "ET 32020R0910" adds that act, which changed the date.
# The consolidations also list earlier consolidations. These have dates but no annotations, and
# CellarDates leaves them out.
# It uses only consolidations with a CELEX number, as versions.rq does. The other consolidations
# are Cellar's internal production versions. They may list an act that no version integrates.
# It gives one row per date and annotation.
# {{celex}}: the CELEX number of the base act, for example 32015R1998. Sparql.fill escapes it.
PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
PREFIX annotation: <http://publications.europa.eu/ontology/annotation#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject ?date ?type ?comment
WHERE {
  {
    ?work cdm:resource_legal_id_celex "{{celex}}"^^xsd:string .
  } UNION {
    ?act cdm:resource_legal_id_celex "{{celex}}"^^xsd:string .
    ?consolidation cdm:act_consolidated_based_on_resource_legal ?act ;
         cdm:resource_legal_id_celex ?version ;
         cdm:act_consolidated_consolidates_resource_legal ?work .
  }
  ?work cdm:resource_legal_id_celex ?subject ;
       cdm:resource_legal_date_entry-into-force ?date .
  OPTIONAL {
    ?axiom owl:annotatedSource ?work ;
         owl:annotatedProperty cdm:resource_legal_date_entry-into-force ;
         owl:annotatedTarget ?date .
    OPTIONAL { ?axiom annotation:type_of_date ?type }
    OPTIONAL { ?axiom annotation:comment_on_date ?comment }
  }
}
ORDER BY ?subject ?date
