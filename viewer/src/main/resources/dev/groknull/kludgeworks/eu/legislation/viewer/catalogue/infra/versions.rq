# SPDX-License-Identifier: MIT
# Gets the consolidated versions of an act, for CellarActs. For each consolidation based on the
# act, it gets:
# - the CELEX number, for example 02015R1998-20260322, and the date.
# - whether Cellar published it as a PDF. An interim version has no PDF, and Cellar may still
#   revise it.
# - the acts that the consolidation lists as consolidated in it, as Cellar states them. These are
#   the base act, the previous consolidation, and the amending acts and corrigenda of this step.
#   Where a public consolidation lists no amending acts, it falls back to the acts its internal
#   production version of the same date consolidates.
# It gets works with a CELEX number. It gives one row per version and listed act. CellarActs folds
# the rows.
# {{celex}}: the CELEX number of the base act, for example 32015R1998. Sparql.fill escapes it.
PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?version ?date ?pdf ?listed
WHERE {
  ?act cdm:resource_legal_id_celex "{{celex}}"^^xsd:string .
  ?consolidation cdm:act_consolidated_based_on_resource_legal ?act ;
       cdm:resource_legal_id_celex ?version ;
       cdm:act_consolidated_date ?date .
  BIND (EXISTS {
    ?expression cdm:expression_belongs_to_work ?consolidation .
    ?manifestation cdm:manifestation_manifests_expression ?expression ;
         cdm:manifestation_type ?format .
    FILTER (STRSTARTS(STR(?format), "pdf"))
  } AS ?pdf)
  BIND (EXISTS {
    ?consolidation cdm:act_consolidated_consolidates_resource_legal ?other .
    FILTER (?other != ?act)
  } AS ?hasAmendingActs)
  OPTIONAL {
    FILTER (?hasAmendingActs)
    ?consolidation cdm:act_consolidated_consolidates_resource_legal ?integrated .
    ?integrated cdm:resource_legal_id_celex ?consListed .
  }
  OPTIONAL {
    FILTER (!?hasAmendingActs)
    ?prod cdm:act_consolidated_based_on_resource_legal ?act ;
         cdm:act_consolidated_date ?date ;
         cdm:act_consolidated_consolidates_resource_legal ?prodIntegrated .
    FILTER NOT EXISTS { ?prod cdm:resource_legal_id_celex ?prodCelex }
    ?prodIntegrated cdm:resource_legal_id_celex ?prodListed .
  }
  BIND (COALESCE(?consListed, ?prodListed) AS ?listed)
}
ORDER BY ?date ?listed
