# SPDX-License-Identifier: MIT
# Gets what other acts did to the provisions of an act, for CellarAmendments. Cellar annotates each
# amendment with one axiom per amended location. Each row has:
# - the location, in Cellar's codes from the authority table fd_370. For example,
#   "AR 89 PA 1 ALN 1" or "AN PO 8.1.2.3 PTA (c)".
# - the role, from the authority table fd_375. For example, R is replacement, J is addition, DEL is
#   deletion, A is repeal and P is extended validity.
# - the day the amendment applies from.
# - the day the amendment ends, if it lapses.
# - the languages, if the act corrects only some language versions. For example, "SV".
# It gets only amendments with a location. The others give nothing that a unit can be joined to.
# It gives one row per amended location.
# {{celex}}: the CELEX number of a base act, for example 32015R1998. Sparql.fill escapes it.
PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
PREFIX annotation: <http://publications.europa.eu/ontology/annotation#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?subject ?location ?role ?from ?until ?languages
WHERE {
  ?work cdm:resource_legal_id_celex "{{celex}}"^^xsd:string .
  ?axiom owl:annotatedSource ?amending ;
         owl:annotatedProperty cdm:resource_legal_amends_resource_legal ;
         owl:annotatedTarget ?work ;
         annotation:reference_to_modified_location ?location .
  ?amending cdm:resource_legal_id_celex ?subject .
  OPTIONAL { ?axiom annotation:role2 ?role }
  OPTIONAL { ?axiom annotation:start_of_validity ?from }
  OPTIONAL { ?axiom annotation:end_of_validity ?until }
  OPTIONAL { ?axiom annotation:language_list ?languages }
}
ORDER BY ?subject ?from ?location
