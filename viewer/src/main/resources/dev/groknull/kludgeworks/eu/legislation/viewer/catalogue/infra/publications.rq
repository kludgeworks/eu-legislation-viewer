# SPDX-License-Identifier: MIT
# Gets how the acts that the consolidations of an act integrate were published, for
# CellarPublications. This includes corrigenda. For each act it gets:
# - the ELI.
# - the title in each language.
# - the place in the Official Journal. This is the collection, for example OJ-L. It is also the
#   number in the act-by-act Journal, for example 2026/449, or the issue that contains the act, for
#   example L 21. The act-by-act Journal started in October 2023.
# - the day of publication for each place. An act that has both places has two days.
# It uses consolidations with or without a CELEX number, as dates.rq does. CellarActs retains
# only publications of acts that a version in the act's timeline integrates (and of the act itself).
# It gives one row per act and title. The details of the Journal are optional. They are often
# missing for a corrigendum.
# {{celex}}: the CELEX number of the base act, for example 32015R1998. Sparql.fill escapes it.
PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject ?eli ?code ?title ?collection ?number ?published ?issueCollection ?issue
    ?issuePublished
WHERE {
  ?act cdm:resource_legal_id_celex "{{celex}}"^^xsd:string .
  ?consolidation cdm:act_consolidated_based_on_resource_legal ?act ;
       cdm:act_consolidated_consolidates_resource_legal ?work .
  ?work cdm:resource_legal_id_celex ?subject .
  OPTIONAL { ?work cdm:resource_legal_eli ?eli }
  OPTIONAL {
    ?expression cdm:expression_belongs_to_work ?work ;
         cdm:expression_uses_language ?language ;
         cdm:expression_title ?title .
    BIND(STRAFTER(STR(?language), "/language/") AS ?code)
  }
  OPTIONAL {
    ?work cdm:official-journal-act_part_of_collection_document ?collection ;
         cdm:resource_legal_reference_oj-act ?number ;
         cdm:official-journal-act_date_publication ?published .
  }
  OPTIONAL {
    ?work cdm:resource_legal_published_in_official-journal ?journal .
    ?journal cdm:official-journal_part_of_collection_document ?issueCollection ;
         cdm:official-journal_number ?issue ;
         cdm:publication_general_date_publication ?issuePublished .
  }
}
ORDER BY ?subject ?code
