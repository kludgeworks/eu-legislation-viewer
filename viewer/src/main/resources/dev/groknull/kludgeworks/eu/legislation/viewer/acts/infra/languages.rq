# SPDX-License-Identifier: MIT
# The languages each version of an act has its text in as Formex (CellarActs): the act's own work
# (the original text) and each consolidation based on it, by its CELEX, with the authority codes of
# its expressions that have a Formex manifestation (fmx4), space-separated (BUL CES … SWE), and when
# Cellar last modified any of those manifestations, as it does when it republishes one: what the
# viewer's texts of the version are made from, so part of their key (ValkeyExpressions). One query
# for the whole timeline, apart from versions.rq, whose PDF check it would repeat on every row
# (Research: which languages a version is in). A version without Formex has no row.
# {{celex}}: the base act's CELEX (32015R1998), checked against its pattern first.
PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
PREFIX cmr: <http://publications.europa.eu/ontology/cdm/cmr#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?version
       (GROUP_CONCAT(DISTINCT STRAFTER(STR(?language), "/language/"); separator=" ") AS ?languages)
       (MAX(?modified) AS ?formexModified)
WHERE {
  # each branch binds ?work itself: a BIND of the act would run before the act is bound
  { ?work cdm:resource_legal_id_celex "{{celex}}"^^xsd:string . }
  UNION
  { ?act cdm:resource_legal_id_celex "{{celex}}"^^xsd:string .
    ?work cdm:act_consolidated_based_on_resource_legal ?act ;
          cdm:act_consolidated_date ?date . }
  ?work cdm:resource_legal_id_celex ?version .
  ?expression cdm:expression_belongs_to_work ?work ;
              cdm:expression_uses_language ?language .
  ?manifestation cdm:manifestation_manifests_expression ?expression ;
                 cdm:manifestation_type "fmx4"^^xsd:string ;
                 cmr:lastModificationDate ?modified .
}
GROUP BY ?version
ORDER BY ?version
