# SPDX-License-Identifier: MIT
PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
SELECT ?celex ?eli ?resource_type ?document_date ?in_force WHERE {
  ?w cdm:resource_legal_id_celex ?celex .
  FILTER(REGEX(STR(?celex), '{{pattern}}'))
  OPTIONAL { ?w cdm:resource_legal_eli ?eli }
  OPTIONAL { ?w cdm:work_has_resource-type ?resource_type }
  OPTIONAL { ?w cdm:work_date_document ?document_date }
  OPTIONAL { ?w cdm:resource_legal_in-force ?in_force }
}
