# SPDX-License-Identifier: MIT
# Finds acts whose English title has the words, for CellarSearch. It uses Virtuoso's full-text
# index, with bif:contains. It ranks the acts in this order:
# - higher relevance first.
# - then acts that amend no other act.
# - then acts in force.
# - then newer acts.
# It finds only regulations, directives and decisions. These have a CELEX number of sector 3 and
# type R, L or D, so corrigenda are left out.
# It gets one page of acts. For each act it then gets the ELI, the resource type, whether the act
# is in force, and the acts it amends with their ELIs.
# It gives one row per combination of values, in no order. CellarSearch folds and orders the rows.
# The ranking is in a subquery. Virtuoso answers nothing for the score of bif:contains next to an
# OPTIONAL, or under an aggregate.
# Placeholders, which Sparql.fill escapes:
# - {{words}}: the words, each quoted and joined by AND, for example 'aviation' AND 'security'.
#   The words have letters and digits only.
# - {{types}}: the CELEX type letters, RLD or one of them.
# - {{amending}}: yes for amending acts only, else no.
# - {{limit}} and {{offset}}: the page, in digits.
# bif: is the prefix of Virtuoso's built-in functions. It is declared because SPARQL requires every
# prefix to be declared.
PREFIX bif: <bif:>
PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?celex ?eli ?title ?type ?inForce ?amends ?amendsEli ?relevance
WHERE {
  {
    SELECT ?work ?celex ?title ?relevance
    WHERE {
      ?expression cdm:expression_title ?title ;
          cdm:expression_uses_language <http://publications.europa.eu/resource/authority/language/ENG> ;
          cdm:expression_belongs_to_work ?work .
      ?title bif:contains "{{words}}" OPTION (score ?relevance) .
      ?work cdm:resource_legal_id_celex ?celex .
      FILTER (REGEX(STR(?celex), CONCAT("^3[0-9]{4}[", "{{types}}", "][0-9]{4}$")))
      FILTER ("{{amending}}" = "no" || EXISTS { ?work cdm:resource_legal_amends_resource_legal ?any })
    }
    ORDER BY DESC(?relevance)
        ASC(EXISTS { ?work cdm:resource_legal_amends_resource_legal ?amended })
        DESC(EXISTS { ?work cdm:resource_legal_in-force "true"^^xsd:boolean })
        DESC(?celex)
    LIMIT {{limit}}
    OFFSET {{offset}}
  }
  OPTIONAL { ?work cdm:resource_legal_eli ?eli }
  OPTIONAL { ?work cdm:work_has_resource-type ?type }
  OPTIONAL { ?work cdm:resource_legal_in-force ?inForce }
  OPTIONAL {
    ?work cdm:resource_legal_amends_resource_legal ?target .
    ?target cdm:resource_legal_id_celex ?amends .
    OPTIONAL { ?target cdm:resource_legal_eli ?amendsEli }
  }
}
