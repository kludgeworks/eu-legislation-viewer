# SPDX-License-Identifier: MIT
# Gets the work of an act by its CELEX number, for CellarActs. It gets:
# - the ELI, the resource type and the date of document.
# - whether the act is in force.
# - the dates of entry into force. There can be several. Cellar types them with annotations, which
#   this query does not read. The earliest date is the entry into force itself.
# - the date of end of validity. It is 9999-12-31 while the act is open-ended.
# It gives one row per combination of values. CellarActs folds the rows.
# {{celex}}: the CELEX number of a base act, for example 32015R1998. Sparql.fill escapes it.
PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?eli ?type ?dateOfDocument ?inForce ?entryIntoForce ?endOfValidity
WHERE {
  ?work cdm:resource_legal_id_celex "{{celex}}"^^xsd:string .
  OPTIONAL { ?work cdm:resource_legal_eli ?eli }
  OPTIONAL { ?work cdm:work_has_resource-type ?type }
  OPTIONAL { ?work cdm:work_date_document ?dateOfDocument }
  OPTIONAL { ?work cdm:resource_legal_in-force ?inForce }
  OPTIONAL { ?work cdm:resource_legal_date_entry-into-force ?entryIntoForce }
  OPTIONAL { ?work cdm:resource_legal_date_end-of-validity ?endOfValidity }
}
