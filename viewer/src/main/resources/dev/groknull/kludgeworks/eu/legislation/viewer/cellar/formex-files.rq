# SPDX-License-Identifier: MIT
# Gets the Formex items of one version in one language, for FormexFiles.
# The path is work → expression → manifestation → items. The work has a CELEX number, the
# expression is a language, and the manifestation is fmx4.
# Each item comes with its file name. The file name is tdm:stream_name. If the technical metadata
# is missing, it is the suffix of owl:sameAs after ".fmx4.".
# Each item also comes with the time Cellar last modified the manifestation. If there is more than
# one manifestation, FormexFiles uses this time to choose the latest.
# FormexFiles fills in these placeholders:
# - {{celex}}: the CELEX number, for example 32015R1998 or 02015R1998-20260322. Sparql.fill
#   escapes it.
# - {{language}}: an EU authority code, for example ENG. FormexFiles checks it against its pattern.
PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
PREFIX cmr: <http://publications.europa.eu/ontology/cdm/cmr#>
PREFIX tdm: <http://publications.europa.eu/ontology/tdm#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?manifestation ?item ?mime (SAMPLE(COALESCE(?streamName, STRAFTER(STR(?same), ".fmx4."))) AS ?file)
       ?modified
WHERE {
  VALUES (?celex ?language) { ("{{celex}}"^^xsd:string <http://publications.europa.eu/resource/authority/language/{{language}}>) }
  ?work cdm:resource_legal_id_celex ?celex .
  ?expr cdm:expression_belongs_to_work ?work ;
        cdm:expression_uses_language ?language .
  ?manifestation cdm:manifestation_manifests_expression ?expr ;
       cdm:manifestation_type "fmx4"^^xsd:string ;
       cmr:lastModificationDate ?modified .
  ?item cdm:item_belongs_to_manifestation ?manifestation ;
        cmr:manifestationMimeType ?mime .
  OPTIONAL { ?item tdm:stream_name ?streamName }
  OPTIONAL { ?item owl:sameAs ?same }
}
GROUP BY ?manifestation ?item ?mime ?modified
ORDER BY ?item
