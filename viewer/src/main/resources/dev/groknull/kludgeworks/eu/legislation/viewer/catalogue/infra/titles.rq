# SPDX-License-Identifier: MIT
# An act's titles (CellarActs): the title of each of its work's expressions, by the authority code of
# the expression's language (ENG, FRA …), as the Official Journal printed it ("Commission
# Implementing Regulation (EU) 2015/1998 of 5 November 2015 laying down … (Text with EEA
# relevance)"). Read with the act, before any of its texts is built, so its page can name it while
# they are. Cellar has expressions in languages that aren't official (Norwegian, for the EEA):
# CellarActs keeps the official ones.
# {{celex}}: a base act's CELEX (32015R1998), escaped by Sparql.fill.
PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT (STRAFTER(STR(?language), "/language/") AS ?code) ?title
WHERE {
  ?work cdm:resource_legal_id_celex "{{celex}}"^^xsd:string .
  ?expression cdm:expression_belongs_to_work ?work ;
              cdm:expression_uses_language ?language ;
              cdm:expression_title ?title .
}
ORDER BY ?code
