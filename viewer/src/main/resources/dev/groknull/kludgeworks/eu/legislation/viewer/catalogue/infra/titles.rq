# SPDX-License-Identifier: MIT
# Gets the titles of an act, for CellarActs. It gets the title of each expression of the work, by
# the authority code of the language of the expression, for example ENG or FRA.
# The title is as the Official Journal printed it. For example, "Commission Implementing Regulation
# (EU) 2015/1998 of 5 November 2015 laying down … (Text with EEA relevance)".
# The viewer reads the titles with the act, before it builds any of the texts. So the page of the
# act can show its name while the texts build.
# Cellar has expressions in languages that are not official, for example Norwegian for the EEA.
# CellarActs keeps only the official languages.
# {{celex}}: the CELEX number of a base act, for example 32015R1998. Sparql.fill escapes it.
PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT (STRAFTER(STR(?language), "/language/") AS ?code) ?title
WHERE {
  ?work cdm:resource_legal_id_celex "{{celex}}"^^xsd:string .
  ?expression cdm:expression_belongs_to_work ?work ;
              cdm:expression_uses_language ?language ;
              cdm:expression_title ?title .
}
ORDER BY ?code
