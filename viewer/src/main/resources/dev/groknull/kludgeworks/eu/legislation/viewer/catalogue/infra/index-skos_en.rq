# SPDX-License-Identifier: MIT
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?concept ?pref_label ?alt_label WHERE {
  VALUES ?scheme {
    <http://eurovoc.europa.eu>
    <http://publications.europa.eu/resource/authority/subject-matter>
    <http://publications.europa.eu/resource/authority/dir-eu-legal-act>
  }
  ?concept skos:inScheme ?scheme ;
           skos:prefLabel ?pref_label .
  FILTER (LANG(?pref_label) = 'en')
  OPTIONAL {
    ?concept skos:altLabel ?alt_label .
    FILTER (LANG(?alt_label) = 'en')
  }
}
