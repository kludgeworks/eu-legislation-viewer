load("@contrib_rules_jvm//java:defs.bzl", "java_library")

# A library outside the viewer's modules: the addresses of the compare page and of its parts. The
# catalogue links to the parts by them, and the comparison module answers them, with no Java
# between the two modules
java_library(
    name = "comparepage",
    srcs = glob(["*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jspecify_jspecify",
    ],
)
