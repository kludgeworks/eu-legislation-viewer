load("@rules_java//java:defs.bzl", "java_library")

# The expressions module's web adapter: the legal text as JSON, and the versions' resources
java_library(
    name = "web",
    srcs = glob(["*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/acts",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/acts/web",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/api",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/expressions",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:org_jmolecules_jmolecules_hexagonal_architecture",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_springframework_hateoas_spring_hateoas",
        "@maven//:org_springframework_spring_beans",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_web",
        "@maven//:tools_jackson_core_jackson_databind",
    ],
)
