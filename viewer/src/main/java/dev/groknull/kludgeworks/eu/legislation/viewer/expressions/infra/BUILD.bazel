load("@rules_java//java:defs.bzl", "java_library")

# The expressions module's adapters: legal texts converted from Cellar's Formex (FormexConversion) by
# //formex-converter's stylesheets (FormexConverter) and kept in Valkey (ValkeyExpressions), and the
# reader from legal-text XML into the records
java_library(
    name = "infra",
    srcs = glob(["*.java"]),
    plugins = ["//tools/build:mapstruct"],
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    runtime_deps = [
        "//formex-converter:schema",
        "//formex-converter:stylesheets",
    ],
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/acts",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/cellar",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/expressions",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/expressions/infra/xml",
        "@maven//:jakarta_validation_jakarta_validation_api",
        "@maven//:jakarta_xml_bind_jakarta_xml_bind_api",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_jmolecules_jmolecules_hexagonal_architecture",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_mapstruct_mapstruct",
        "@maven//:org_springframework_boot_spring_boot",
        "@maven//:org_springframework_data_spring_data_redis",
        "@maven//:org_springframework_spring_context",
    ],
)
