load("@rules_java//java:defs.bzl", "java_library")

# The broadcast module's infrastructure: externalized events through Valkey's streams
java_library(
    name = "infra",
    srcs = glob(["*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/broadcast",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_springframework_boot_spring_boot_autoconfigure",
        "@maven//:org_springframework_data_spring_data_commons",
        "@maven//:org_springframework_data_spring_data_redis",
        "@maven//:org_springframework_modulith_spring_modulith_events_api",
        "@maven//:org_springframework_modulith_spring_modulith_events_core",
        "@maven//:org_springframework_spring_beans",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_core",
        "@maven//:org_springframework_spring_expression",
        "@maven//:tools_jackson_core_jackson_databind",
    ],
)
