# SPDX-License-Identifier: MIT
load("@contrib_rules_jvm//java:defs.bzl", "java_library")
load("//tools/build:defs.bzl", "jooq_tables")

# The module's API and domain: Act, its identifiers, versions and timeline; Acts, the repository
java_library(
    name = "catalogue",
    srcs = glob(["*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/ingest",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "@maven//:org_jmolecules_jmolecules_ddd",
        "@maven//:org_jmolecules_jmolecules_events",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_springframework_modulith_spring_modulith_api",
        "@maven//:org_springframework_modulith_spring_modulith_events_api",
    ],
)

# application/
# The catalogue module's application ring: the acts from the store, read from Cellar the first time
java_library(
    name = "application",
    srcs = glob(["application/*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        ":catalogue",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/ingest",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "@maven//:jakarta_validation_jakarta_validation_api",
        "@maven//:org_jmolecules_jmolecules_events",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_springframework_boot_spring_boot",
        "@maven//:org_springframework_modulith_spring_modulith_events_api",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_tx",
    ],
)

# infra/
# The catalogue module's infrastructure: acts read from Cellar, kept in Postgres with jOOQ
java_library(
    name = "infra",
    srcs = glob(["infra/*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    runtime_deps = ["//viewer/src/main/resources/dev/groknull/kludgeworks/eu/legislation/viewer/catalogue/infra:sparql"],
    deps = [
        ":application",
        ":catalogue",
        ":jooq",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/cellar",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/ingest",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jooq_jooq",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_springframework_spring_beans",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_tx",
        "@maven//:tools_jackson_core_jackson_databind",
    ],
)

# The module's tables (act, its versions, dates, amendments …) as jOOQ classes, from its migrations
jooq_tables(
    name = "jooq",
    config = "infra/jooq.xml",
    migrations = "//viewer/src/main/resources:catalogue_migrations",
    package = "dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.infra.jooq",
    deps = [
        ":catalogue",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/ingest",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
    ],
)

# web/
# The catalogue module's web side: the home page, and a version's page, its text by htmx
java_library(
    name = "web",
    srcs = glob(["web/*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        ":catalogue",
        ":view",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/broadcast",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/chrome",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/comparepage",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/ingest",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "//viewer/src/main/jte",
        "@maven//:gg_jte_jte_models",
        "@maven//:gg_jte_jte_models_runtime",
        "@maven//:gg_jte_jte_runtime",
        "@maven//:io_github_wimdeblauwe_htmx_spring_boot",
        "@maven//:jakarta_servlet_jakarta_servlet_api",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_web",
        "@maven//:org_springframework_spring_webmvc",
    ],
)

# web/view/
# What the catalogue's pages show (home, an act's masthead and timeline, a version's Reading
# card, the compare page's cards, the preparing and failure panels), worked out for their
# templates (src/main/jte/catalogue): its own target, so the templates can take it while
# catalogue/web renders them
java_library(
    name = "view",
    srcs = glob(["web/view/*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        ":catalogue",
        "//tools/build:record_builder",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/chrome",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/comparepage",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/ingest",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jspecify_jspecify",
    ],
)
