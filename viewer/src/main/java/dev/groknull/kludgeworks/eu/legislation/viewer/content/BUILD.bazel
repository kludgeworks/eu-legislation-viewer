# SPDX-License-Identifier: MIT
load("@contrib_rules_jvm//java:defs.bzl", "java_library")
load("//tools/build:defs.bzl", "jooq_tables")

# The content module's API and domain: Content, the store of legal texts, and their identities,
# events and outlines
java_library(
    name = "content",
    srcs = glob(["*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_jmolecules_jmolecules_ddd",
        "@maven//:org_jmolecules_jmolecules_events",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_springframework_modulith_spring_modulith_api",
        "@maven//:org_springframework_modulith_spring_modulith_events_api",
    ],
)

# application/
# The content module's application ring: storing, reading and outlining texts, on a store of texts
java_library(
    name = "application",
    srcs = glob(["application/*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        ":content",
        ":model",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "@maven//:io_micrometer_micrometer_observation",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_springframework_modulith_spring_modulith_events_api",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_tx",
    ],
)

# infra/
# The content module's infrastructure: the texts in Postgres, one row each, with jOOQ, and the
# outlines cached in the process, with Caffeine
java_library(
    name = "infra",
    srcs = glob(["infra/*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        ":application",
        ":content",
        ":jooq",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "@maven//:com_github_ben_manes_caffeine_caffeine",
        "@maven//:com_github_luben_zstd_jni",
        "@maven//:jakarta_validation_jakarta_validation_api",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jooq_jooq",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_springframework_boot_spring_boot",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_context_support",
        "@maven//:tools_jackson_core_jackson_core",
        "@maven//:tools_jackson_core_jackson_databind",
    ],
)

# The module's table (text) as jOOQ classes, from its migrations
jooq_tables(
    name = "jooq",
    config = "infra/jooq.xml",
    migrations = "//viewer/src/main/resources:content_migrations",
    package = "dev.groknull.kludgeworks.eu.legislation.viewer.content.infra.jooq",
    deps = [
        ":content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
    ],
)

# model/
# The content model: legal texts as JSON, and back, and their outlines
java_library(
    name = "model",
    srcs = glob(["model/*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        ":content",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jspecify_jspecify",
        "@maven//:tools_jackson_core_jackson_core",
    ],
)
