<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT -->
<!-- Sets what jOOQ generates for the tables of the catalogue module. The jooq_tables target in
     BUILD.bazel sets the database and the target package. The generated code uses these types:
     - Identifiers are the value objects of the module. Each column of the domain act_identifier is
       an ActIdentifier.
     - The kind of a version is Version.Kind.
     - The kind and anchor of an act date are ActDate.Kind and ActDate.Anchor.
     - The location, place and role of an amendment are Location, Place and Amendment.Role.
     - Each column of the domain language_code is a Language. The failure of an
       expression or an entry is a Failure.
     - Times are Instants.
     - Every tsvector column is a TsVector of the library libs/jooq-extension. -->
<configuration xmlns="http://www.jooq.org/xsd/jooq-codegen-3.21.0.xsd">
  <logging>WARN</logging>
  <generator>
    <database>
      <forcedTypes>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ActIdentifier</userType>
          <lambdaConverter>
            <from>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ActIdentifier::new</from>
            <to>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ActIdentifier::celex</to>
          </lambdaConverter>
          <includeTypes>act_identifier</includeTypes>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Eli</userType>
          <lambdaConverter>
            <from>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Eli::new</from>
            <to>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Eli::path</to>
          </lambdaConverter>
          <includeExpression>act\.eli|act_publication\.eli</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ResourceType</userType>
          <lambdaConverter>
            <from>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ResourceType::new</from>
            <to>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ResourceType::code</to>
          </lambdaConverter>
          <includeExpression>act\.resource_type</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Version.Kind</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>version\.kind</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ActDate.Kind</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>act_date\.kind</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Location</userType>
          <lambdaConverter>
            <from>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Location::new</from>
            <to>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Location::code</to>
          </lambdaConverter>
          <includeExpression>act_amendment\.cellar_location</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Place</userType>
          <lambdaConverter>
            <from>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Place::new</from>
            <to>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Place::words</to>
          </lambdaConverter>
          <includeExpression>act_amendment\.place</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Amendment.Role</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>act_amendment\.kind</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ActDate.Anchor</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>act_date\.anchor</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.language.Language</userType>
          <enumConverter>true</enumConverter>
          <includeTypes>language_code</includeTypes>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.ingest.Failure</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>expression\.failure|preparation_entry\.failure</includeExpression>
        </forcedType>
        <forcedType>
          <userType>java.time.Instant</userType>
          <lambdaConverter>
            <from>java.time.OffsetDateTime::toInstant</from>
            <to>instant -> instant.atOffset(java.time.ZoneOffset.UTC)</to>
          </lambdaConverter>
          <includeTypes>(?i:timestamptz|timestamp\ with\ time\ zone)</includeTypes>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.jooq.postgres.TsVector</userType>
          <lambdaConverter>
            <from>dev.groknull.kludgeworks.jooq.postgres.TsVector::of</from>
            <to>dev.groknull.kludgeworks.jooq.postgres.TsVector::text</to>
          </lambdaConverter>
          <includeTypes>(?i:tsvector)</includeTypes>
        </forcedType>
      </forcedTypes>
    </database>
    <generate>
      <records>true</records>
      <pojos>false</pojos>
      <daos>false</daos>
      <javaTimeTypes>true</javaTimeTypes>
      <globalObjectReferences>true</globalObjectReferences>
      <comments>false</comments>
    </generate>
  </generator>
</configuration>
