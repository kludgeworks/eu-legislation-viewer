<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT -->
<!-- Sets what jOOQ generates for the tables of the catalogue module. The jooq_tables target in
     BUILD.bazel sets the database and the target package. The generated code uses these types:
     - Identifiers are the value objects of the module.
     - The kind of a version is Version.Kind.
     - The kind and anchor of an act date are ActDate.Kind and ActDate.Anchor.
     - The location and role of an amendment are Location and Amendment.Role.
     - The language, root and failure of an expression are Language, ContentHash and Failure.
     - The roots of a step count are ContentHash.
     - Times are Instants. -->
<configuration xmlns="http://www.jooq.org/xsd/jooq-codegen-3.21.0.xsd">
  <logging>WARN</logging>
  <generator>
    <database>
      <forcedTypes>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ActIdentifier</userType>
          <converter>org.jooq.Converter.ofNullable(String.class, dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ActIdentifier.class, dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ActIdentifier::new, dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ActIdentifier::celex)</converter>
          <includeExpression>act\.celex|version\.act|act_date\.act|act_date\.subject|act_title\.act|act_amendment\.act|act_amendment\.amending|act_publication\.(act|subject)|act_publication_title\.(act|subject)|step_count\.act|step_act_count\.act|step_act_count\.amending|preparation\.act|preparation_step\.act</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Eli</userType>
          <converter>org.jooq.Converter.ofNullable(String.class, dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Eli.class, dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Eli::new, dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Eli::path)</converter>
          <includeExpression>act\.eli|act_publication\.eli</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ResourceType</userType>
          <converter>org.jooq.Converter.ofNullable(String.class, dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ResourceType.class, dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ResourceType::new, dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ResourceType::code)</converter>
          <includeExpression>act\.resource_type</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Version.Kind</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>version\.kind</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ActDate.Kind</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>act_date\.kind</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Location</userType>
          <converter>org.jooq.Converter.ofNullable(String.class, dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Location.class, dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Location::new, dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Location::code)</converter>
          <includeExpression>act_amendment\.cellar_location</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.Amendment.Role</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>act_amendment\.kind</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.catalogue.ActDate.Anchor</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>act_date\.anchor</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.language.Language</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>expression\.language_code|act_title\.language_code|act_publication_title\.language_code|preparation\.language_code|preparation_step\.language_code</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.content.ContentHash</userType>
          <converter>org.jooq.Converter.ofNullable(String.class, dev.groknull.kludgeworks.eu.legislation.viewer.content.ContentHash.class, dev.groknull.kludgeworks.eu.legislation.viewer.content.ContentHash::new, dev.groknull.kludgeworks.eu.legislation.viewer.content.ContentHash::hex)</converter>
          <includeExpression>expression\.root|step_count\.(from|to)_root|step_act_count\.(from|to)_root</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.ingest.Failure</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>expression\.failure|preparation_step\.failure</includeExpression>
        </forcedType>
        <forcedType>
          <userType>java.time.Instant</userType>
          <converter>org.jooq.Converter.ofNullable(java.time.OffsetDateTime.class, java.time.Instant.class, java.time.OffsetDateTime::toInstant, instant -> instant.atOffset(java.time.ZoneOffset.UTC))</converter>
          <includeTypes>(?i:timestamptz|timestamp\ with\ time\ zone)</includeTypes>
        </forcedType>
      </forcedTypes>
    </database>
    <generate>
      <records>true</records>
      <pojos>false</pojos>
      <daos>false</daos>
      <javaTimeTypes>true</javaTimeTypes>
      <globalObjectReferences>true</globalObjectReferences>
      <comments>false</comments>
    </generate>
  </generator>
</configuration>
