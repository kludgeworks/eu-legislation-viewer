load("@contrib_rules_jvm//java:defs.bzl", "java_library")

# The legaltext module: legal texts as HTML, with the templates of src/main/jte/legal, for every page
# that shows legal text, and the /content fragments that pages transclude, their HTML cached in
# Valkey
java_library(
    name = "legaltext",
    srcs = glob(["*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/chrome",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "@maven//:gg_jte_jte_runtime",
        "@maven//:jakarta_servlet_jakarta_servlet_api",
        "@maven//:jakarta_validation_jakarta_validation_api",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_springframework_boot_spring_boot",
        "@maven//:org_springframework_data_spring_data_redis",
        "@maven//:org_springframework_modulith_spring_modulith_api",
        "@maven//:org_springframework_spring_beans",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_web",
    ],
)
