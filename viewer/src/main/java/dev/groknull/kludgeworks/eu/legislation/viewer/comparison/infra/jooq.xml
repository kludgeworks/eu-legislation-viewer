<!-- What jOOQ generates of the comparison module's table (jooq_tables, in BUILD.bazel, which sets
     the database and the target): the texts as TextId, the time as an Instant. The bytea columns,
     the kept JSON, stay bytes. -->
<configuration xmlns="http://www.jooq.org/xsd/jooq-codegen-3.21.0.xsd">
  <logging>WARN</logging>
  <generator>
    <database>
      <forcedTypes>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.content.TextId</userType>
          <converter>org.jooq.Converter.ofNullable(Long.class, dev.groknull.kludgeworks.eu.legislation.viewer.content.TextId.class, dev.groknull.kludgeworks.eu.legislation.viewer.content.TextId::new, dev.groknull.kludgeworks.eu.legislation.viewer.content.TextId::value)</converter>
          <includeExpression>(?i:.*\.(from|to)_text)</includeExpression>
        </forcedType>
        <forcedType>
          <userType>java.time.Instant</userType>
          <converter>org.jooq.Converter.ofNullable(java.time.OffsetDateTime.class, java.time.Instant.class, java.time.OffsetDateTime::toInstant, instant -> instant.atOffset(java.time.ZoneOffset.UTC))</converter>
          <includeTypes>(?i:timestamptz|timestamp\ with\ time\ zone)</includeTypes>
        </forcedType>
      </forcedTypes>
    </database>
    <generate>
      <records>true</records>
      <pojos>false</pojos>
      <daos>false</daos>
      <javaTimeTypes>true</javaTimeTypes>
      <globalObjectReferences>true</globalObjectReferences>
      <comments>false</comments>
    </generate>
  </generator>
</configuration>
