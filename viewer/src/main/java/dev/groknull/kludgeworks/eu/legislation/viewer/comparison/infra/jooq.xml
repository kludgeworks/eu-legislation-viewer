<!-- What jOOQ generates of the comparison module's table (jooq_tables, in BUILD.bazel, which sets
     the database and the target): the roots as ContentHash, the time as an Instant. The other bytea
     columns, the kept JSON, stay bytes. -->
<configuration xmlns="http://www.jooq.org/xsd/jooq-codegen-3.21.0.xsd">
  <logging>WARN</logging>
  <generator>
    <database>
      <forcedTypes>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.content.ContentHash</userType>
          <converter>org.jooq.Converter.ofNullable(byte[].class, dev.groknull.kludgeworks.eu.legislation.viewer.content.ContentHash.class, dev.groknull.kludgeworks.eu.legislation.viewer.content.ContentHash::of, dev.groknull.kludgeworks.eu.legislation.viewer.content.ContentHash::bytes)</converter>
          <includeExpression>(?i:.*\.(from|to)_root)</includeExpression>
          <includeTypes>bytea</includeTypes>
        </forcedType>
        <forcedType>
          <userType>java.time.Instant</userType>
          <converter>org.jooq.Converter.ofNullable(java.time.OffsetDateTime.class, java.time.Instant.class, java.time.OffsetDateTime::toInstant, instant -> instant.atOffset(java.time.ZoneOffset.UTC))</converter>
          <includeTypes>(?i:timestamptz|timestamp\ with\ time\ zone)</includeTypes>
        </forcedType>
      </forcedTypes>
    </database>
    <generate>
      <records>true</records>
      <pojos>false</pojos>
      <daos>false</daos>
      <javaTimeTypes>true</javaTimeTypes>
      <globalObjectReferences>true</globalObjectReferences>
      <comments>false</comments>
    </generate>
  </generator>
</configuration>
