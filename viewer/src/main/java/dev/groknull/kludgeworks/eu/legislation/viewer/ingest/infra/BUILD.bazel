# SPDX-License-Identifier: MIT
load("@contrib_rules_jvm//java:defs.bzl", "java_library")
load("//tools/build:defs.bzl", "jooq_tables")

# The ingest module's infrastructure: a document's Formex from Cellar, converted by
# //formex-converter's stylesheets; the jobs in Postgres, with jOOQ
java_library(
    name = "infra",
    srcs = glob(["*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    runtime_deps = [
        "//formex-converter:schema",
        "//formex-converter:stylesheets",
    ],
    deps = [
        ":jooq",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/cellar",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/ingest",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/ingest/application",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/ingest/model",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jooq_jooq",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_core",
        "@maven//:org_springframework_spring_tx",
    ],
)

# The module's tables (ingest_job) as jOOQ classes, from its migrations
jooq_tables(
    name = "jooq",
    config = "jooq.xml",
    migrations = "//viewer/src/main/resources:ingest_migrations",
    package = "dev.groknull.kludgeworks.eu.legislation.viewer.ingest.infra.jooq",
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/ingest",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
    ],
)
