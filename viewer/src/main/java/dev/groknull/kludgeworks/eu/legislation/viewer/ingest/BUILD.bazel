# SPDX-License-Identifier: MIT
load("@contrib_rules_jvm//java:defs.bzl", "java_library")
load("//tools/build:defs.bzl", "jooq_tables")

# The ingest module's API: scheduling an expression's legal text to be built (Ingest), its job's
# status, and the events that say how it went
java_library(
    name = "ingest",
    srcs = glob(["*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "@maven//:org_jmolecules_jmolecules_events",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_springframework_modulith_spring_modulith_api",
    ],
)

# application/
# The ingest module's application ring: scheduling expressions and running their jobs, in the
# background, on the conversions the infrastructure provides
java_library(
    name = "application",
    srcs = glob(["application/*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        ":ingest",
        ":model",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "@maven//:io_micrometer_micrometer_tracing",
        "@maven//:jakarta_validation_jakarta_validation_api",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_springframework_boot_spring_boot",
        "@maven//:org_springframework_boot_spring_boot_autoconfigure",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_tx",
    ],
)

# infra/
# The ingest module's infrastructure: a document's Formex from Cellar, converted by
# //formex-converter's stylesheets; the jobs in Postgres, with jOOQ
java_library(
    name = "infra",
    srcs = glob(["infra/*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    runtime_deps = [
        "//formex-converter:schema",
        "//formex-converter:stylesheets",
    ],
    deps = [
        ":application",
        ":ingest",
        ":jooq",
        ":model",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/cellar",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jooq_jooq",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_core",
        "@maven//:org_springframework_spring_tx",
    ],
)

# The module's tables (ingest_job) as jOOQ classes, from its migrations
jooq_tables(
    name = "jooq",
    config = "infra/jooq.xml",
    migrations = "//viewer/src/main/resources:ingest_migrations",
    package = "dev.groknull.kludgeworks.eu.legislation.viewer.ingest.infra.jooq",
    deps = [
        ":ingest",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
    ],
)

# model/
# The ingest module's domain: the ingest job (its withers by RecordBuilder) and its queue, and the
# converter's refusals
java_library(
    name = "model",
    srcs = glob(["model/*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        ":ingest",
        "//tools/build:record_builder",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "@maven//:org_jmolecules_jmolecules_ddd",
        "@maven//:org_jmolecules_jmolecules_events",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_springframework_spring_tx",  # the queue's optimistic-locking failure
    ],
)
