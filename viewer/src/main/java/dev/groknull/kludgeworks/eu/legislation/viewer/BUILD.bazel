# SPDX-License-Identifier: MIT
load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("//tools/build:defs.bzl", "spring_boot_jar")

# The application: ViewerApplication and, at run time, its modules, its configuration and migrations,
# and the starters: web, the store (Postgres, Flyway, jOOQ, Modulith's event registry) and
# observability (OpenTelemetry, Modulith's insight, JDBC spans)
java_library(
    name = "viewer",
    srcs = glob(["*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    runtime_deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/acts",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/acts/infra",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/cellar",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content/application",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content/infra",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content/model",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/ingest",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/ingest/infra",
        "//viewer/src/main/resources",
        "@maven//:net_ttddyy_observation_datasource_micrometer_spring_boot",
        "@maven//:org_flywaydb_flyway_database_postgresql",
        "@maven//:org_jmolecules_integrations_jmolecules_jackson3",
        "@maven//:org_jmolecules_integrations_jmolecules_spring",
        "@maven//:org_postgresql_postgresql",
        "@maven//:org_springframework_boot_spring_boot_starter_actuator",
        "@maven//:org_springframework_boot_spring_boot_starter_flyway",
        "@maven//:org_springframework_boot_spring_boot_starter_jooq",
        "@maven//:org_springframework_boot_spring_boot_starter_opentelemetry",
        "@maven//:org_springframework_boot_spring_boot_starter_restclient",
        "@maven//:org_springframework_boot_spring_boot_starter_validation",
        "@maven//:org_springframework_boot_spring_boot_starter_webmvc",
        "@maven//:org_springframework_modulith_spring_modulith_starter_insight",
        "@maven//:org_springframework_modulith_spring_modulith_starter_jdbc",
    ],
    deps = [
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_springframework_boot_spring_boot",
        "@maven//:org_springframework_boot_spring_boot_autoconfigure",
    ],
)

# bazel run //viewer:app: on Bazel's classpath, for development
java_binary(
    name = "app",
    main_class = "dev.groknull.kludgeworks.eu.legislation.viewer.ViewerApplication",
    visibility = ["//viewer:__pkg__"],
    runtime_deps = [":viewer"],
)

# The app as one file, Spring Boot's executable jar: bazel build //viewer:jar, then java -jar viewer-app.jar
# (not app_deploy.jar, which loses the auto-configuration: see spring_boot_jar)
spring_boot_jar(
    name = "viewer-app",
    app = ":viewer",
    main_class = "dev.groknull.kludgeworks.eu.legislation.viewer.ViewerApplication",
    visibility = ["//viewer:__subpackages__"],
)
