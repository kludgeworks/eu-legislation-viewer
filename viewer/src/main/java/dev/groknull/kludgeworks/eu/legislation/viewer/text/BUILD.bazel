load("@rules_java//java:defs.bzl", "java_library")
load("//tools/build:defs.bzl", "schema_javadoc")

# the module's API package: for now only its declaration
java_library(
    name = "text",
    srcs = glob(["*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_springframework_modulith_spring_modulith_api",
    ],
)

# The records' Javadoc is legal-text.xsd's documentation: schema_javadoc_update writes it (mise run
# docs), schema_javadoc_test checks it. The tables are where a record and the schema name a thing
# differently, as the mapper (LegalTextMapper) does.
schema_javadoc(
    name = "schema_javadoc",
    size = "small",
    srcs = glob(
        ["*.java"],
        exclude = ["package-info.java"],
    ),
    components = {
        "Lifecycle.events": "eventRef",
        "Conclusions.signatures": "signature",
        "Signature.signatories": "signatory",
        "Row.cells": "td",
        "Text.value": "v",
    },
    schema = "//formex-converter:legal-text.xsd",
    types = {
        "Inline": "InlineNode",
        "LegalText.Kind": "DocumentKind",
        "EventRef.Type": "EventType",
        "Formula.Name": "FormulaName",
        "Note.Kind": "NoteKind",
        "Provenance.Action": "Action",
        "ListBlock.Kind": "ListKind",
        "Unit.Kind": "UnitKind",
        "Emphasis.Kind": "EmphasisKind",
        "Ref.Kind": "RefKind",
    },
)
