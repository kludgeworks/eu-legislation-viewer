# SPDX-License-Identifier: MIT
load("@contrib_rules_jvm//java:defs.bzl", "java_library")
load("//tools/build:defs.bzl", "jooq_tables")

# The content module's infrastructure: the trees in Postgres, with jOOQ
java_library(
    name = "infra",
    srcs = glob(["*.java"]),
    visibility = ["//viewer:__subpackages__"],  # the viewer only: //formex-converter never depends on it
    deps = [
        ":jooq",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content/application",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content/model",
        "@maven//:org_jmolecules_jmolecules_onion_architecture",
        "@maven//:org_jooq_jooq",
        "@maven//:org_jspecify_jspecify",
        "@maven//:org_springframework_spring_context",
    ],
)

# The module's tables (node, edge, overlay, root_segment) as jOOQ classes, from its migrations
jooq_tables(
    name = "jooq",
    config = "jooq.xml",
    migrations = "//viewer/src/main/resources:content_migrations",
    package = "dev.groknull.kludgeworks.eu.legislation.viewer.content.infra.jooq",
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content/model",
    ],
)
