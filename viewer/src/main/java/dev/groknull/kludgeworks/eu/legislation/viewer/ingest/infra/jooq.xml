<!-- What jOOQ generates of the ingest module's tables (jooq_tables, in BUILD.bazel, which sets
     the database and the target): the text columns as the module's enums, the times as Instants -->
<configuration xmlns="http://www.jooq.org/xsd/jooq-codegen-3.21.0.xsd">
  <logging>WARN</logging>
  <generator>
    <database>
      <forcedTypes>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.ingest.IngestStatus.State</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>ingest_job\.state</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.ingest.IngestStatus.Stage</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>ingest_job\.phase</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.ingest.Failure</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>ingest_job\.failure</includeExpression>
        </forcedType>
        <forcedType>
          <userType>dev.groknull.kludgeworks.eu.legislation.viewer.language.Language</userType>
          <enumConverter>true</enumConverter>
          <includeExpression>ingest_job\.language_code</includeExpression>
        </forcedType>
        <forcedType>
          <userType>java.time.Instant</userType>
          <converter>org.jooq.Converter.ofNullable(java.time.OffsetDateTime.class, java.time.Instant.class, java.time.OffsetDateTime::toInstant, instant -> instant.atOffset(java.time.ZoneOffset.UTC))</converter>
          <includeTypes>(?i:timestamptz|timestamp\ with\ time\ zone)</includeTypes>
        </forcedType>
      </forcedTypes>
    </database>
    <generate>
      <records>true</records>
      <pojos>false</pojos>
      <daos>false</daos>
      <javaTimeTypes>true</javaTimeTypes>
      <globalObjectReferences>true</globalObjectReferences>
      <comments>false</comments>
    </generate>
  </generator>
</configuration>
