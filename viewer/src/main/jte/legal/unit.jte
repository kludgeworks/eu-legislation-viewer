@import dev.groknull.kludgeworks.eu.legislation.viewer.content.Element
@import dev.groknull.kludgeworks.eu.legislation.viewer.content.web.LegalRenderer
@param Element node
@param LegalRenderer html
<%-- a numbered unit with a heading has a title, the two on one line (1.0 GENERAL PROVISIONS); one
without, its number beside its text (numbered) --%>@if("true".equals(node.attribute("numbered")) && html.has(node, "heading"))<div class="unit unit-${node.attribute("kind")}" id="${node.attribute("eId")}" data-depth="${node.attribute("depth")}" data-box="${node.attribute("box")}">${html.children(node, "provenance")}<div class="title">${html.children(node, "num")} ${html.children(node, "heading")}</div>${html.others(node, "provenance", "num", "heading")}</div>@else<div class="unit unit-${node.attribute("kind")}${"true".equals(node.attribute("numbered")) ? " numbered" : ""}" id="${node.attribute("eId")}" data-depth="${node.attribute("depth")}" data-box="${node.attribute("box")}">${html.children(node)}</div>@endif