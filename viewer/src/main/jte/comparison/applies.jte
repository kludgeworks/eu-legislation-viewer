@import dev.groknull.kludgeworks.eu.legislation.viewer.comparison.web.view.SidenoteView
@param SidenoteView.Applies applies
<%-- Shows when an act applies and which clause sets that date. Examples: "applies from 31 December
     2021 · Article 2 of 2019/103, as amended by 2020/910", and "applies from 7 March 2023 · Article
     79.5 of 2018/1862, on the day set by 2023/201". --%>${applies.when()}@if(applies.clause() != null)${applies.between()}<a href="${applies.clause().href()}" rel="external">${applies.clause().label()}<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens EUR-Lex)</span></a>@for(var each : applies.amendedBy()), as amended by <a href="${each.href()}" title="${each.title()}" rel="external">${each.label()}<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens EUR-Lex)</span></a>@endfor@for(var each : applies.setBy()), on the day set by <a href="${each.href()}" title="${each.title()}" rel="external">${each.label()}<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens EUR-Lex)</span></a>@endfor${applies.after()}@endif
