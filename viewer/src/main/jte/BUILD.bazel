load("//tools/build:defs.bzl", "jte_library")

# The pages and the legal text's templates, precompiled, with jte-models' typed facade (Templates).
# One root for all of them, because jte compiles one root into one package with one facade:
# layout/ the page shell (the chrome module), catalogue/ the catalogue's pages, with the compare
# page's shell and slots, comparison/ the comparison's parts of the compare page, legal/ one
# per legal-text element (the legaltext module's LegalRenderer) and legal/diff/ a comparison's
# marks, legalpart/ the parts of the legal text that aren't an element's, which legal/ calls
jte_library(
    name = "jte",
    srcs = glob(["**/*.jte"]),
    models_exclude = "gg\\.jte\\.generated\\.precompiled\\.legal(part)?\\..*",  # rendered by name, by LegalRenderer, or by legal/
    root = ".",
    visibility = ["//viewer:__subpackages__"],
    deps = [
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/catalogue",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/catalogue:view",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/chrome",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/comparepage",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/comparison",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/comparison:view",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/content",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/ingest",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/language",
        "//viewer/src/main/java/dev/groknull/kludgeworks/eu/legislation/viewer/legaltext",
    ],
)
