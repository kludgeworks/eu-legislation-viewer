load("@rules_java//java:defs.bzl", "java_library")

package(default_visibility = ["//visibility:public"])

# formex-to-legal-text.xsl, the modules it includes and the vocabularies they read: Formex → legal-text
filegroup(
    name = "xslt",
    srcs = glob([
        "*.xsl",
        "*.rdf",
    ]),
)

# the same, on the classpath at /formex-converter/xslt/
java_library(
    name = "resources",
    resources = [":xslt"],
)
