# SPDX-License-Identifier: MIT
load("//tools/build:defs.bzl", "xslt_quality_test")

# The Formex converter: XSLT 3 stylesheets from Formex 4 to legal text, and legal text's schema,
# versioned together by version.txt and usable with any XSLT 3 processor (the contract is in
# formex-to-legal-text.xsl's header). Laid out as Maven lays out a project: the stylesheets and the
# schema in src/main/resources, on the classpath at /dev/groknull/kludgeworks/formex/converter/;
# their tests in src/test/java and src/test/xspec, their data in src/test/resources. The viewer's
# Java adapter is its own (text.infra's FormexConverter). What others use, by short names:

# formex-to-legal-text.xsl, the modules it includes and version.txt, on the classpath
alias(
    name = "stylesheets",
    actual = "//formex-converter/src/main/resources/dev/groknull/kludgeworks/formex/converter:stylesheets",
    visibility = ["//visibility:public"],
)

# legal-text.xsd and what it needs, on the classpath at /dev/groknull/kludgeworks/formex/converter/schema/
alias(
    name = "schema",
    actual = "//formex-converter/src/main/resources/dev/groknull/kludgeworks/formex/converter:schema",
    visibility = ["//visibility:public"],
)

alias(
    name = "legal-text.xsd",
    actual = "//formex-converter/src/main/resources/dev/groknull/kludgeworks/formex/converter:schema/legal-text.xsd",
    visibility = ["//visibility:public"],
)

alias(
    name = "xml.xsd",
    actual = "//formex-converter/src/main/resources/dev/groknull/kludgeworks/formex/converter:schema/xml.xsd",
    visibility = ["//visibility:public"],
)

# the converter's output for each fixture: samples of legal text for the viewer's tests
alias(
    name = "expected",
    actual = "//formex-converter/src/test/resources/expected",
    visibility = ["//visibility:public"],
)

# the fixtures' Formex, raw as Cellar serves it: for tests that read real documents
alias(
    name = "fixtures",
    actual = "//formex-converter/src/test/resources/fixtures:formex",
    visibility = ["//visibility:public"],
)

# every stylesheet of the project, production and test
xslt_quality_test(
    name = "xslt_quality",
    srcs = [
        "//formex-converter/src/main/resources/dev/groknull/kludgeworks/formex/converter:xslt",
        "//formex-converter/src/test/resources/compare",
    ],
)
