   <preface>
      <longTitle>
         <p>
            <t v="Decision of the European Banking Authority confirming that the unsolicited credit assessments of certain ECAIs do not differ in quality from their solicited credit assessments"/>
         </p>
      </longTitle>
   </preface>
   <body>
      <unit eId="art_1" kind="article">
         <num>
            <t v="Article 1"/>
         </num>
         <p>
            <t v="For the purposes of Article 138 of Regulation (EU) No 575/2013, the EBA confirms that the quality of the unsolicited credit assessments of the ECAIs set out in the Annex does not differ from the quality of the solicited credit assessments of those ECAIs."/>
         </p>
      </unit>
      <unit eId="art_2" kind="article">
         <num>
            <t v="Article 2"/>
         </num>
         <p>
            <t v="This Decision shall enter into force on the twentieth day following that of its publication in the "/>
            <emphasis kind="i">
               <t v="Official Journal of the European Union"/>
            </emphasis>
            <t v="."/>
         </p>
      </unit>
   </body>
