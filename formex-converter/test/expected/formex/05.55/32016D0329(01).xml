   <body>
      <unit eId="art_1" kind="article">
         <num>
            <emphasis kind="i">
               <t v="Article 1"/>
            </emphasis>
         </num>
         <p>
            <t v="For the judicial year beginning on "/>
            <date asWritten="1 September 2016" date="2016-09-01"/>
            <t v=", the dates of the judicial vacations within the meaning of Article 41(2) and (6) of the Rules of Procedure are as follows:"/>
         </p>
         <list kind="dash">
            <unit eId="art_1/idt_1" kind="indent">
               <p>
                  <t v="Christmas 2016: from Monday "/>
                  <date asWritten="19 December 2016" date="2016-12-19"/>
                  <t v=" to Sunday "/>
                  <date asWritten="8 January 2017" date="2017-01-08"/>
                  <t v=" inclusive,"/>
               </p>
            </unit>
            <unit eId="art_1/idt_2" kind="indent">
               <p>
                  <t v="Easter 2017: from Monday "/>
                  <date asWritten="10 April 2017" date="2017-04-10"/>
                  <t v=" to Sunday "/>
                  <date asWritten="23 April 2017" date="2017-04-23"/>
                  <t v=" inclusive,"/>
               </p>
            </unit>
            <unit eId="art_1/idt_3" kind="indent">
               <p>
                  <t v="Summer 2017: from Friday "/>
                  <date asWritten="21 July 2017" date="2017-07-21"/>
                  <t v=" to Sunday "/>
                  <date asWritten="3 September 2017" date="2017-09-03"/>
                  <t v=" inclusive."/>
               </p>
            </unit>
         </list>
      </unit>
      <unit eId="art_2" kind="article">
         <num>
            <emphasis kind="i">
               <t v="Article 2"/>
            </emphasis>
         </num>
         <p>
            <t v="This Decision shall enter into force on the day of its publication in the "/>
            <emphasis kind="i">
               <t v="Official Journal of the European Union"/>
            </emphasis>
            <t v="."/>
         </p>
      </unit>
