   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE GENERAL COURT"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to Article 41(2) of the Rules of Procedure,"/>
            </p>
         </unit>
      </citations>
