         </p>
         <p>
            <t v="of "/>
            <docDate asWritten="14 December 2009" date="2009-12-14"/>
         </p>
         <p>
            <docPurpose>
               <t v="amending Decision 2007/230/EC on a form concerning social legislation relating to road transport activities"/>
            </docPurpose>
         </p>
         <p>
            <t v="(notified under document C(2009) 9895)"/>
         </p>
         <p>
            <t v="(Text with EEA relevance)"/>
