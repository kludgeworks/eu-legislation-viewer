            <t v="(2009/911/EU)"/>
         </p>
      </longTitle>
   </preface>
   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE COUNCIL OF THE EUROPEAN UNION,"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to the Treaty on the Functioning of the European Union, and in particular Article 240(2), first subparagraph, thereof,"/>
            </p>
         </unit>
      </citations>
      <recitals>
         <unit eId="pbl_1/rct_1" kind="recital">
            <p>
               <t v="Whereas the Secretary-General of the Council should be appointed,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HAS ADOPTED THIS DECISION:"/>
         </p>
      </formula>
   </preamble>
   <body>
      <unit eId="art_1" kind="article">
         <num>
            <t v="Article 1"/>
         </num>
         <p>
            <t v="Mr Pierre de BOISSIEU is hereby appointed Secretary-General of the Council of the European Union for the period from "/>
            <date asWritten="1 December 2009" date="2009-12-01"/>
            <t v=" until the day after the European Council meeting of June 2011."/>
         </p>
      </unit>
      <unit eId="art_2" kind="article">
         <num>
            <t v="Article 2"/>
         </num>
         <unit eId="art_2/unp_1" kind="paragraph">
            <p>
               <t v="This Decision shall be notified to Mr Pierre de BOISSIEU by the President of the Council."/>
            </p>
         </unit>
         <unit eId="art_2/unp_2" kind="paragraph">
            <p>
               <t v="It shall be published in the "/>
               <emphasis kind="i">
                  <t v="Official Journal of the European Union"/>
               </emphasis>
               <t v="."/>
            </p>
         </unit>
      </unit>
   </body>
