         <unit eId="tis_III" kind="division">
            <num>
               <t v="TITLE III"/>
            </num>
            <subheading>
               <t v="General provisions"/>
            </subheading>
            <unit eId="art_13" kind="article">
               <num>
                  <t v="Article 13"/>
               </num>
               <p>
                  <t v="When the first request for reimbursement is forwarded, the Member State concerned shall communicate to the Commission a certificate stating the dates when the group was set up and recognized."/>
               </p>
            </unit>
            <unit eId="art_14" kind="article">
               <num>
                  <t v="Article 14"/>
               </num>
               <p>
                  <t v="The Commission shall take a decision in regard to requests for reimbursement in one or more payments in accordance with the procedure laid down in Article 7 (1) of Council Regulation (EEC) No 729/70"/>
                  <noteRef href="#note_2" marker="2"/>
                  <t v=" of 21 April 1970 on the financing of the common agricultural policy."/>
               </p>
            </unit>
            <unit eId="art_15" kind="article">
               <num>
                  <t v="Article 15"/>
               </num>
               <p>
                  <t v="This Regulation shall enter into force on the third day following its publication in the "/>
                  <emphasis kind="i">
                     <t v="Official Journal of the European Communities"/>
                  </emphasis>
                  <t v="."/>
               </p>
            </unit>
