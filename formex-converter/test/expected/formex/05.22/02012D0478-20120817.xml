         <unit eId="pbl_1/cit_2" kind="citation">
            <p>
               <t v="Having regard to Decision 2011/782/CFSP"/>
               <noteRef href="#note_1" marker="1"/>
               <t v=", and in particular Article 21(1) thereof,"/>
            </p>
         </unit>
      </citations>
      <recitals>
         <intro>
            <p>
               <t v="Whereas:"/>
            </p>
         </intro>
         <unit eId="pbl_1/rct_1" kind="recital">
            <num>
               <t v="(1)"/>
            </num>
            <p>
               <t v="On "/>
               <date asWritten="1 December 2011" date="2011-12-01"/>
               <t v=", the Council adopted Decision 2011/782/CFSP."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_2" kind="recital">
            <num>
               <t v="(2)"/>
            </num>
            <p>
               <t v="An additional entity should be included in the list of persons and entities subject to restrictive measures set out in Annex I to Decision 2011/782/CFSP,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HAS ADOPTED THIS DECISION:"/>
         </p>
      </formula>
