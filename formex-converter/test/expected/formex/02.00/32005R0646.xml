   <preface>
      <longTitle>
         <p>
            <docType>
               <emphasis kind="uc">
                  <t v="Commission Regulation"/>
               </emphasis>
            </docType>
            <t v=" "/>
            <docNumber>
               <t v="(EC) No 646/2005"/>
            </docNumber>
         </p>
         <p>
            <t v="of "/>
            <docDate asWritten="27 April 2005" date="2005-04-27"/>
         </p>
         <p>
            <docPurpose>
               <t v="amending Regulation (EC) No 94/2005 on the issue of import licences for rice originating in the ACP States and the overseas countries and territories against applications submitted in the first five working days of January 2005 pursuant to Regulation (EC) No 638/2003"/>
            </docPurpose>
         </p>
      </longTitle>
   </preface>
   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE COMMISSION OF THE EUROPEAN COMMUNITIES,"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to the Treaty establishing the European Community,"/>
            </p>
         </unit>
         <unit eId="pbl_1/cit_2" kind="citation">
            <p>
               <t v="Having regard to Commission Regulation (EC) No 638/2003 of "/>
               <date asWritten="9 April 2003" date="2003-04-09"/>
               <t v=" laying down detailed rules for applying Council Regulation (EC) No 2286/2002 and to Council Decision 2001/822/EC as regards the arrangements applicable to imports of rice originating in the African, Caribbean and Pacific States (ACP States) and the overseas countries and territories (OCT)"/>
               <noteRef href="#note_1" marker="1"/>
               <t v=", and in particular Article 17(2) thereof,"/>
            </p>
         </unit>
      </citations>
      <recitals>
         <intro>
            <p>
               <t v="Whereas:"/>
            </p>
         </intro>
         <unit eId="pbl_1/rct_1" kind="recital">
            <p>
               <t v="Having checked the quantities booked by product category for the January 2005 tranche, a Member State was found to have made a booking error. As a result of this error, the quantities available for the May 2005 tranche in the Annex to Commission Regulation (EC) No 94/2005"/>
               <noteRef href="#note_2" marker="2"/>
               <t v=" were less than they should have been. The Regulation in question should therefore be amended to take account of the applications actually lodged for the January tranche and to make them available for the May tranche,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HAS ADOPTED THIS REGULATION:"/>
         </p>
      </formula>
   </preamble>
   <body>
      <unit eId="art_1" kind="article">
         <num>
            <t v="Article 1"/>
         </num>
         <p>
            <t v="The Annex to Regulation (EC) No 94/2005 is replaced by the Annex hereto."/>
         </p>
      </unit>
      <unit eId="art_2" kind="article">
         <num>
            <t v="Article 2"/>
         </num>
         <p>
            <t v="This Regulation shall enter into force on the day of its publication in the "/>
            <emphasis kind="i">
               <t v="Official Journal of the European Union"/>
            </emphasis>
            <t v="."/>
         </p>
      </unit>
   </body>
   <conclusions>
      <p>
         <t v="This Regulation shall be binding in its entirety and directly applicable in all Member States."/>
      </p>
      <signature>
         <placeAndDate>
