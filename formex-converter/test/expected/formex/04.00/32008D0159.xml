   <annexes>
      <unit eId="anx" kind="annex" eurlexAnchor="1">
         <num>
            <t v="ANNEX"/>
         </num>
         <quotedStructure eId="anx/qst_1">
            <unit eId="anx/qst_1/anx" kind="annex">
               <num>
                  <t v="‘"/>
                  <t v="ANNEX"/>
               </num>
               <unit eId="anx/qst_1/anx/lvl_1" kind="level" depth="1">
                  <heading>
                     <t v="Areas where the plan for the eradication of classical swine fever in feral pigs is to be implemented"/>
                  </heading>
                  <p>
                     <t v="The territory of the county of Nógrád and the territory of the county of Pest located north and east of the Danube, south of the border with Slovakia, west of the border with the county Nógrád and north of the motorway E 71."/>
                     <t v="’"/>
                     <t v="."/>
                  </p>
               </unit>
            </unit>
         </quotedStructure>
      </unit>
   </annexes>
