   <preface>
      <longTitle>
         <p>
            <docType>
               <emphasis kind="uc">
                  <t v="Commission Decision"/>
               </emphasis>
            </docType>
            <docNumber/>
         </p>
         <p>
            <t v="of "/>
            <docDate asWritten="22 February 2008" date="2008-02-22"/>
         </p>
         <p>
            <docPurpose>
               <t v="amending Decision 2007/683/EC approving the plan for the eradication of classical swine fever in feral pigs in certain areas of Hungary"/>
            </docPurpose>
         </p>
         <p>
            <t v="(notified under document number C(2008) 675)"/>
         </p>
         <p>
            <t v="(Only the Hungarian text is authentic)"/>
         </p>
         <p>
            <t v="(2008/159/EC)"/>
         </p>
      </longTitle>
   </preface>
   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE COMMISSION OF THE EUROPEAN COMMUNITIES,"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to the Treaty establishing the European Community,"/>
            </p>
         </unit>
         <unit eId="pbl_1/cit_2" kind="citation">
            <p>
               <t v="Having regard to Council Directive 2001/89/EC of "/>
               <date asWritten="23 October 2001" date="2001-10-23"/>
               <t v=" on Community measures for the control of classical swine fever"/>
               <noteRef href="#note_1" marker="1"/>
               <t v=", and in particular Article 16(1) thereof,"/>
            </p>
         </unit>
      </citations>
      <recitals>
         <intro>
            <p>
               <t v="Whereas:"/>
            </p>
         </intro>
         <unit eId="pbl_1/rct_1" kind="recital">
            <num>
               <t v="(1)"/>
            </num>
            <p>
               <t v="Commission Decision 2007/683/EC"/>
               <noteRef href="#note_2" marker="2"/>
               <t v=" was adopted as one of a number of measures to combat classical swine fever."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_2" kind="recital">
            <num>
               <t v="(2)"/>
            </num>
            <p>
               <t v="Slovakia has informed the Commission about the recent evolution of that disease in feral pigs in certain areas bordering Hungary."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_3" kind="recital">
            <num>
               <t v="(3)"/>
            </num>
            <p>
               <t v="Hungary has informed the Commission that in the light of the epidemiological situation, the measures set out in the plan for the eradication of classical swine fever in feral pigs need to be extended to certain areas of the Pest County in Hungary."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_4" kind="recital">
            <num>
               <t v="(4)"/>
            </num>
            <p>
               <t v="Decision 2007/683/EC should therefore be amended accordingly."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_5" kind="recital">
            <num>
               <t v="(5)"/>
            </num>
            <p>
               <t v="The measures provided for in this Decision are in accordance with the opinion of the Standing Committee on the Food Chain and Animal Health,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HAS ADOPTED THIS DECISION:"/>
         </p>
      </formula>
   </preamble>
   <body>
      <unit eId="art_1" kind="article">
         <num>
            <t v="Article 1"/>
         </num>
         <p>
            <t v="The Annex to Decision 2007/683/EC is replaced by the text in the Annex to this Decision."/>
         </p>
      </unit>
      <unit eId="art_2" kind="article">
         <num>
            <t v="Article 2"/>
         </num>
         <p>
            <t v="This Decision is addressed to the Republic of Hungary."/>
         </p>
      </unit>
   </body>
