   <preface>
      <longTitle>
         <p>
            <docType>
               <emphasis kind="uc">
                  <t v="Council Recommendation"/>
               </emphasis>
            </docType>
            <docNumber/>
         </p>
         <p>
            <t v="of "/>
            <docDate asWritten="14 February 2006" date="2006-02-14"/>
         </p>
         <p>
            <docPurpose>
               <t v="on the appointment of a member of the Executive Board of the European Central Bank"/>
            </docPurpose>
         </p>
         <p>
            <t v="(2006/108/EC)"/>
         </p>
      </longTitle>
   </preface>
   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE COUNCIL OF THE EUROPEAN UNION,"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to the Treaty establishing the European Community, and in particular Articles 112(2)(b) and 122(4) thereof, and to Articles 11.2 and 43.3 of the Protocol on the Statute of the European System of Central Banks and of the European Central Bank,"/>
            </p>
         </unit>
      </citations>
      <recitals>
         <intro>
            <p>
               <t v="Whereas:"/>
            </p>
         </intro>
         <unit eId="pbl_1/rct_1" kind="recital">
            <p>
               <t v="The term of office of Mr Otmar ISSING expires on "/>
               <date asWritten="31 May 2006" date="2006-05-31"/>
               <t v=". A member of the Executive Board of the European Central Bank must be appointed,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HEREBY RECOMMENDS THAT:"/>
         </p>
      </formula>
   </preamble>
   <body>
      <p>
         <t v="Mr Jürgen STARK be appointed a member of the Executive Board of the European Central Bank for a term of office of eight years with effect from "/>
         <date asWritten="1 June 2006" date="2006-06-01"/>
         <t v="."/>
      </p>
      <p>
         <t v="This Recommendation shall be submitted for a decision to the Heads of State or Government of the Member States of the European Community whose currency is the euro, after consulting the European Parliament and the Governing Council of the European Central Bank."/>
      </p>
      <p>
         <t v="This Recommendation shall be published in the "/>
         <emphasis kind="i">
            <t v="Official Journal of the European Union"/>
         </emphasis>
         <t v="."/>
      </p>
   </body>
