            <t v="Sole Article"/>
         </num>
         <p>
            <t v="In Article 8 of Decision 2011/C 253/04 of "/>
            <date asWritten="29 August 2011" date="2011-08-29"/>
            <t v=", the date "/>
            <quote startQuote="‘" endQuote="’">
               <date asWritten="31 December 2020" date="2020-12-31"/>
            </quote>
            <t v=" is replaced by the date "/>
            <quote startQuote="‘" endQuote="’">
               <date asWritten="31 December 2025" date="2025-12-31"/>
            </quote>
            <t v="."/>
         </p>
      </unit>
