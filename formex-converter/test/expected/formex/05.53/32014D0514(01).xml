   <preface>
      <longTitle>
         <p>
            <docType>
               <emphasis kind="uc">
                  <t v="Commission Decision"/>
               </emphasis>
            </docType>
            <docNumber/>
         </p>
         <p>
            <t v="of "/>
            <docDate asWritten="13 May 2014" date="2014-05-13"/>
         </p>
         <p>
            <docPurpose>
               <t v="appointing members and alternates of the Paediatric Committee to represent health professionals and patient associations"/>
            </docPurpose>
         </p>
         <p>
            <t v="(Text with EEA relevance)"/>
         </p>
      </longTitle>
   </preface>
   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE EUROPEAN COMMISSION,"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to the Treaty on the Functioning of the European Union,"/>
            </p>
         </unit>
         <unit eId="pbl_1/cit_2" kind="citation">
            <p>
               <t v="Having regard to Regulation (EC) No 1901/2006 of the European Parliament and of the Council of "/>
               <date asWritten="12 December 2006" date="2006-12-12"/>
               <t v=" on medicinal products for paediatric use and amending Regulation (EEC) No 1768/92, Directive 2001/20/EC, Directive 2001/83/EC and Regulation (EC) No 726/2004"/>
               <noteRef href="#note_1" marker="1"/>
               <t v=", and in particular Article 4(1) thereof,"/>
            </p>
         </unit>
      </citations>
      <recitals>
         <intro>
            <p>
               <t v="Whereas:"/>
            </p>
         </intro>
         <unit eId="pbl_1/rct_1" kind="recital">
            <num>
               <t v="(1)"/>
            </num>
            <p>
               <t v="Article 4(1) of Regulation (EC) No 1901/2006 requires that the Commission appoints representatives of health professionals and patient associations to the European Medicines Agency Paediatric Committee."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_2" kind="recital">
            <num>
               <t v="(2)"/>
            </num>
            <p>
               <t v="In accordance with Article 4(1) of Regulation (EC) No 1901/2006, a public call for expression of interest has been undertaken by the Commission. The European Parliament has been consulted on the result of the evaluation of the applications received in the framework of this call for expression of interest."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_3" kind="recital">
            <num>
               <t v="(3)"/>
            </num>
            <p>
               <t v="The members and alternates of the Committee shall be appointed for a period of three years starting on "/>
               <date asWritten="1 August 2014" date="2014-08-01"/>
               <t v="."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_4" kind="recital">
            <num>
               <t v="(4)"/>
            </num>
            <p>
               <t v="Where a member or alternate representing health professionals appointed by this decision is no longer capable of contributing efficiently to the work of the Committee, or resigns, the Commission may replace this member from the reserve list, for the remaining duration of the member’s mandate,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HAS DECIDED AS FOLLOWS:"/>
         </p>
      </formula>
   </preamble>
   <body>
