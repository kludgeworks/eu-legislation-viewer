   <annexes>
      <unit eId="anx" kind="annex" eurlexAnchor="1" rank="1">
         <num>
            <t v="ANNEX"/>
         </num>
         <p>
            <t v="In the Annex to Implementing Regulation (EU) 2021/17, in part C, point (a) of entry 10 "/>
            <quote startQuote="‘" endQuote="’">
               <t v="Changes to the labelling or the package leaflet which shall not be connected with the SPC:"/>
            </quote>
            <t v=" is replaced by the following:"/>
         </p>
         <quotedStructure eId="anx/qstr_1">
            <table cols="4">
               <tr>
                  <td>
                     <p>
                        <t v="‘"/>
                        <t v="a)"/>
                     </p>
                  </td>
                  <td>
                     <list kind="dash">
                        <unit eId="anx/qstr_1/tab_1/tr_1/td_2/idt_1" kind="indent">
                           <p>
                              <t v="administrative information concerning the holder’s representative or the distributor(s)"/>
                              <noteRef href="#note_anx000201-1" marker="*"/>
                           </p>
                        </unit>
                     </list>
                  </td>
                  <td/>
                  <td/>
               </tr>
            </table>
         </quotedStructure>
         <notes>
            <note eId="note_anx000201-1" marker="*" kind="table">
               <p>
                  <t v="The reference to a change in the administrative information of the distributor(s) applies only in those cases where the competent authority has allowed, in accordance with Regulation (EU) 2019/6, the inclusion of the information on the distributor(s)."/>
                  <t v="’"/>
               </p>
            </note>
         </notes>
      </unit>
   </annexes>
