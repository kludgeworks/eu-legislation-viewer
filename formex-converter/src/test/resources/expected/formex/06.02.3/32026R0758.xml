   </source>
   <preface>
      <longTitle>
         <p>
            <docType>
               <emphasis kind="uc">
                  <t v="Commission Implementing Regulation"/>
               </emphasis>
            </docType>
            <t v=" "/>
            <docNumber>
               <t v="(EU) 2026/758"/>
            </docNumber>
         </p>
         <p>
            <t v="of "/>
            <docDate date="2026-04-01">
               <t v="1 April 2026"/>
            </docDate>
         </p>
         <p>
            <docPurpose>
               <t v="amending Implementing Regulation (EU) 2021/17 as regards the inclusion of a variation amending the contact details of the distributor in the list of variations not requiring assessment"/>
            </docPurpose>
         </p>
         <p>
            <t v="(Text with EEA relevance)"/>
         </p>
      </longTitle>
   </preface>
   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE EUROPEAN COMMISSION,"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to the Treaty on the Functioning of the European Union,"/>
            </p>
         </unit>
         <unit eId="pbl_1/cit_2" kind="citation">
            <p>
               <t v="Having regard to Regulation (EU) 2019/6 of the European Parliament and of the Council of "/>
               <date date="2018-12-11">
                  <t v="11 December 2018"/>
               </date>
               <t v=" on veterinary medicinal products and repealing Directive 2001/82/EC"/>
               <noteRef href="#note_1" marker="1"/>
               <t v=", and in particular Article 60(1) thereof,"/>
            </p>
         </unit>
      </citations>
      <recitals>
         <intro>
            <p>
               <t v="Whereas:"/>
            </p>
         </intro>
         <unit eId="pbl_1/rct_1" kind="recital">
            <num>
               <t v="(1)"/>
            </num>
            <p>
               <t v="Commission Implementing Regulation (EU) 2021/17"/>
               <noteRef href="#note_2" marker="2"/>
               <t v=" establishes a list of variations not requiring assessment in accordance with Regulation (EU) 2019/6."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_2" kind="recital">
            <num>
               <t v="(2)"/>
            </num>
            <p>
               <t v="Based upon experience gained, the Coordination Group on Veterinary Medicinal Products advised the Commission to amend one of the entries in the Annex to Regulation (EU) 2021/17 in order to include in the list of variations not requiring assessment a variation amending the contact details of the distributor(s)."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_3" kind="recital">
            <num>
               <t v="(3)"/>
            </num>
            <p>
               <t v="The Commission agrees that this type of variation does not require an assessment, as such change is of an administrative nature and does not require a scientific assessment."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_4" kind="recital">
            <num>
               <t v="(4)"/>
            </num>
            <p>
               <t v="Implementing Regulation (EU) 2021/17 should therefore be amended accordingly."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_5" kind="recital">
            <num>
               <t v="(5)"/>
            </num>
            <p>
               <t v="The measures provided for in this Regulation are in accordance with the opinion of the Standing Committee on Veterinary Medicinal Products,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HAS ADOPTED THIS REGULATION:"/>
         </p>
      </formula>
   </preamble>
   <body>
      <unit eId="art_1" kind="article" rank="1">
         <num>
            <t v="Article 1"/>
         </num>
         <p>
            <t v="The Annex to Implementing Regulation (EU) 2021/17 is amended in accordance with the Annex to this Regulation."/>
         </p>
      </unit>
      <unit eId="art_2" kind="article" rank="1">
         <num>
            <t v="Article 2"/>
         </num>
         <unit eId="art_2/unp_1" kind="paragraph">
            <p>
               <t v="This Regulation shall enter into force on the twentieth day following that of its publication in the "/>
               <emphasis kind="i">
                  <t v="Official Journal of the European Union"/>
               </emphasis>
               <t v="."/>
            </p>
         </unit>
         <unit eId="art_2/unp_2" kind="paragraph">
            <p>
               <t v="This Regulation shall be binding in its entirety and directly applicable in all Member States."/>
            </p>
         </unit>
      </unit>
   </body>
