   <annexes>
      <unit eId="anx" kind="annex" eurlexAnchor="1" rank="1">
         <num>
            <t v="ANNEX"/>
         </num>
         <unit eId="anx/level_1" kind="level" depth="1" rank="2">
            <heading>
               <t v="CHARACTERISTICS OF END MARKER AND INTERMEDIARY MARKER BUOYS"/>
            </heading>
            <figure src="L_2005056EN.01001102.tif" content="techDesign">
               <description>
                  <p>
                     <t v="TOP SIGN"/>
                     <t v="SPHERE"/>
                     <t v="RADAR REFLECTOR"/>
                     <t v="LUMINOUS BAND"/>
                     <t v="YELLOW LIGHT"/>
                     <t v="RECTANGULAR"/>
                     <t v="FLAGS"/>
                     <t v="FLOAT"/>
                     <t v="SURFACE"/>
                     <t v="STABILISING WEIGHT"/>
                     <t v="MAST"/>
                     <t v="HEIGHT AT"/>
                     <t v="LEAST 1,5"/>
                     <t v="METERS ABOVE"/>
