         </p>
         <p>
            <docPurpose>
               <t v="on the issue of import licences for rice originating in the ACP States and the overseas countries and territories against applications submitted in the first five working days of October 2004 pursuant to Regulation (EC) No 638/2003"/>
            </docPurpose>
         </p>
      </longTitle>
   </preface>
   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE COMMISSION OF THE EUROPEAN COMMUNITIES,"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to the Treaty establishing the European Community,"/>
            </p>
