         <unit eId="pbl_1/cit_2" kind="citation">
            <p>
               <t v="Having regard to Council Regulation (EC) No 2286/2002 of "/>
               <date asWritten="10 December 2002" date="2002-12-10"/>
               <t v=" on the arrangements applicable to agricultural products and goods resulting from the processing of agricultural products originating in the African, Caribbean and Pacific States (ACP States) and repealing Regulation (EC) No 1706/98"/>
               <noteRef href="#note_1" marker="1"/>
               <t v=","/>
            </p>
         </unit>
         <unit eId="pbl_1/cit_3" kind="citation">
            <p>
               <t v="Having regard to Council Decision 2001/822/EC of "/>
               <date asWritten="27 November 2001" date="2001-11-27"/>
               <t v=" on the association of the overseas countries and territories with the European Community (Overseas Association Decision)"/>
               <noteRef href="#note_2" marker="2"/>
               <t v=","/>
            </p>
         </unit>
         <unit eId="pbl_1/cit_4" kind="citation">
            <p>
               <t v="Having regard to Commission Regulation (EC) No 638/2003 of "/>
               <date asWritten="9 April 2003" date="2003-04-09"/>
               <t v=" laying down detailed rules for applying Council Regulation (EC) No 2286/2002 and Council Decision 2001/822/EC as regards the arrangements applicable to imports of rice originating in the African, Caribbean and Pacific States (ACP States) and the overseas countries and territories (OCT)"/>
               <noteRef href="#note_3" marker="3"/>
               <t v=", and in particular Article 17(2) thereof,"/>
            </p>
         </unit>
      </citations>
      <recitals>
         <intro>
            <p>
               <t v="Whereas:"/>
            </p>
         </intro>
         <unit eId="pbl_1/rct_1" kind="recital">
            <p>
               <t v="Examination of the quantities for which applications have been submitted shows that licences for the October 2004 tranche should be issued for the quantities applied for reduced, where appropriate, by the percentages not covered,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HAS ADOPTED THIS REGULATION:"/>
         </p>
      </formula>
   </preamble>
   <body>
      <unit eId="art_1" kind="article">
         <num>
            <t v="Article 1"/>
         </num>
         <p>
            <t v="Import licences for rice against applications submitted during the first five working days of October 2004 pursuant to Regulation (EC) No 638/2003 and notified to the Commission shall be issued for the quantities applied for reduced, where appropriate, by the percentages set out in the Annex hereto."/>
         </p>
      </unit>
      <unit eId="art_2" kind="article">
         <num>
            <t v="Article 2"/>
         </num>
         <p>
            <t v="This Regulation shall enter into force on "/>
            <date asWritten="21 October 2004" date="2004-10-21"/>
            <t v="."/>
         </p>
      </unit>
   </body>
   <conclusions>
      <p>
         <t v="This Regulation shall be binding in its entirety and directly applicable in all Member States."/>
      </p>
