         <longTitle>
            <p>
               <docType>
                  <emphasis kind="uc">
                     <t v="Commission Implementing Regulation"/>
                  </emphasis>
               </docType>
               <t v=" "/>
               <docNumber>
                  <t v="(EU) 2016/1095"/>
               </docNumber>
            </p>
            <p>
               <t v="of "/>
               <docDate asWritten="6 July 2016" date="2016-07-06"/>
            </p>
            <p>
               <docPurpose>
                  <t v="concerning the authorisation of Zinc acetate dihydrate, Zinc chloride anhydrous, Zinc oxide, Zinc sulphate heptahydrate, Zinc sulphate monohydrate, Zinc chelate of amino acids hydrate, Zinc chelate of protein hydrolysates, Zinc chelate of glycine hydrate (solid) and Zinc chelate of glycine hydrate (liquid) as feed additives for all animal species and amending Regulations (EC) No 1334/2003, (EC) No 479/2006, (EU) No 335/2010 and Implementing Regulations (EU) No 991/2012 and (EU) No 636/2013"/>
               </docPurpose>
            </p>
            <p>
               <t v="(Text with EEA relevance)"/>
            </p>
         </longTitle>
      </eventRef>
   </lifecycle>
   <preface>
      <longTitle>
         <p>
            <docType>
               <emphasis kind="uc">
                  <t v="Commission Regulation"/>
               </emphasis>
            </docType>
            <t v=" "/>
            <docNumber>
               <t v="(EU) No 335/2010"/>
            </docNumber>
         </p>
         <p>
            <t v="of "/>
            <docDate asWritten="22 April 2010" date="2010-04-22"/>
         </p>
         <p>
            <docPurpose>
               <t v="concerning the authorisation of zinc chelate of hydroxy analogue of methionine as a feed additive for all animal species"/>
            </docPurpose>
         </p>
         <p>
            <t v="(Text with EEA relevance)"/>
         </p>
      </longTitle>
   </preface>
   <body>
      <unit eId="art_1" kind="article" rank="1">
         <num>
            <t v="Article 1"/>
         </num>
         <p>
            <t v="The preparation specified in the Annex, belonging to the additive category "/>
            <quote startQuote="‘" endQuote="’">
               <t v="nutritional additives"/>
            </quote>
            <t v=" and to the functional group "/>
            <quote startQuote="‘" endQuote="’">
               <t v="compounds of trace elements"/>
            </quote>
            <t v=", is authorised as an additive in animal nutrition subject to the conditions laid down in that Annex."/>
         </p>
      </unit>
      <unit eId="art_2" kind="article" rank="1">
         <num>
            <t v="Article 2"/>
         </num>
         <p>
            <t v="Regulation (EC) No 888/2009 is repealed."/>
         </p>
      </unit>
      <unit eId="art_3" kind="article" rank="1">
         <num>
            <t v="Article 3"/>
         </num>
         <p>
            <t v="This Regulation shall enter into force on the 20th day following its publication in the "/>
            <emphasis kind="i">
               <t v="Official Journal of the European Union"/>
            </emphasis>
            <t v="."/>
         </p>
      </unit>
   </body>
   <conclusions>
      <p>
         <t v="This Regulation shall be binding in its entirety and directly applicable in all Member States."/>
      </p>
   </conclusions>
