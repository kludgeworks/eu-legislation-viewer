            <t v=" "/>
            <docNumber>
               <t v="(EU) No 12/2014"/>
            </docNumber>
         </p>
         <p>
            <t v="of "/>
            <docDate asWritten="8 January 2014" date="2014-01-08"/>
         </p>
         <p>
            <docPurpose>
               <t v="entering a name in the register of traditional specialities guaranteed [Salinātā rudzu rupjmaize (TSG)]"/>
            </docPurpose>
         </p>
      </longTitle>
   </preface>
   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE EUROPEAN COMMISSION,"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to the Treaty on the Functioning of the European Union,"/>
            </p>
         </unit>
         <unit eId="pbl_1/cit_2" kind="citation">
            <p>
               <t v="Having regard to Regulation (EU) No 1151/2012 of the European Parliament and of the Council of "/>
               <date asWritten="21 November 2012" date="2012-11-21"/>
               <t v=" on quality schemes for agricultural products and foodstuffs"/>
               <noteRef href="#note_1" marker="1"/>
               <t v=", and in particular Article 52(2) thereof,"/>
            </p>
         </unit>
      </citations>
      <recitals>
         <intro>
            <p>
               <t v="Whereas:"/>
            </p>
         </intro>
         <unit eId="pbl_1/rct_1" kind="recital">
            <num>
               <t v="(1)"/>
            </num>
            <p>
               <t v="Pursuant to Article 50(2)(b) of Regulation (EU) No 1151/2012, Latvia’s application to register the name "/>
               <quote startQuote="‘" endQuote="’">
                  <t v="Salinātā rudzu rupjmaize"/>
               </quote>
               <t v=" was published in the "/>
               <emphasis kind="i">
                  <t v="Official Journal of the European Union"/>
               </emphasis>
               <noteRef href="#note_2" marker="2"/>
               <t v="."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_2" kind="recital">
            <num>
               <t v="(2)"/>
            </num>
            <p>
               <t v="As no statement of opposition under Article 51 of Regulation (EU) No 1151/2012 has been received by the Commission, the name "/>
               <quote startQuote="‘" endQuote="’">
                  <t v="Salinātā rudzu rupjmaize"/>
               </quote>
               <t v=" should therefore be entered in the register,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HAS ADOPTED THIS REGULATION:"/>
         </p>
      </formula>
   </preamble>
   <body>
      <unit eId="art_1" kind="article" rank="1">
         <num>
            <t v="Article 1"/>
         </num>
         <p>
            <t v="The name contained in the Annex to this Regulation is hereby entered in the register."/>
         </p>
      </unit>
      <unit eId="art_2" kind="article" rank="1">
         <num>
            <t v="Article 2"/>
         </num>
         <p>
            <t v="This Regulation shall enter into force on the twentieth day following that of its publication in the "/>
            <emphasis kind="i">
               <t v="Official Journal of the European Union."/>
            </emphasis>
         </p>
      </unit>
   </body>
   <conclusions>
      <p>
         <t v="This Regulation shall be binding in its entirety and directly applicable in all Member States."/>
      </p>
   </conclusions>
