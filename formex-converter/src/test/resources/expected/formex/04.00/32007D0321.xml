   <preface>
      <longTitle>
         <p>
            <docType>
               <emphasis kind="uc">
                  <t v="Commission Decision"/>
               </emphasis>
            </docType>
            <docNumber/>
         </p>
         <p>
            <t v="of "/>
            <docDate asWritten="2 May 2007" date="2007-05-02"/>
         </p>
         <p>
            <docPurpose>
               <t v="releasing the United Kingdom from certain obligations for the marketing of vegetable seed under Council Directive 2002/55/EC"/>
            </docPurpose>
         </p>
         <p>
            <t v="(notified under document number C(2007) 1836)"/>
         </p>
         <p>
            <t v="(Only the English text is authentic)"/>
         </p>
         <p>
            <t v="(2007/321/EC)"/>
         </p>
      </longTitle>
   </preface>
   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE COMMISSION OF THE EUROPEAN COMMUNITIES,"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to the Treaty establishing the European Community,"/>
            </p>
         </unit>
         <unit eId="pbl_1/cit_2" kind="citation">
            <p>
               <t v="Having regard to Council Directive 2002/55/EC of "/>
               <date asWritten="13 June 2002" date="2002-06-13"/>
               <t v=" on the marketing of vegetable seed"/>
               <noteRef href="#note_1" marker="1"/>
               <t v=", and in particular Article 49 thereof,"/>
            </p>
         </unit>
         <unit eId="pbl_1/cit_3" kind="citation">
            <p>
               <t v="Having regard to the request submitted by the United Kingdom,"/>
            </p>
         </unit>
      </citations>
      <recitals>
         <intro>
            <p>
               <t v="Whereas:"/>
            </p>
         </intro>
         <unit eId="pbl_1/rct_1" kind="recital">
            <num>
               <t v="(1)"/>
            </num>
            <p>
               <t v="Under Directive 2002/55/EC the Commission may, subject to certain conditions, release a Member State from obligations for the marketing of vegetable seed set out in that Directive."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_2" kind="recital">
            <num>
               <t v="(2)"/>
            </num>
            <p>
               <t v="The United Kingdom has applied for release from its obligations in respect of certain species and a sub-species."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_3" kind="recital">
            <num>
               <t v="(3)"/>
            </num>
            <p>
               <t v="Since the seed of those species and of that sub-species is not normally reproduced in the United Kingdom and the normal reproduction concerns exclusively propagating and planting material other than seed, the United Kingdom should be released from certain obligations under Directive 2002/55/EC in respect of the species and the sub-species in question."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_4" kind="recital">
            <num>
               <t v="(4)"/>
            </num>
            <p>
               <t v="The measures provided for in this Decision are in accordance with the opinion of the Standing Committee on Seeds and Propagating Material for Agriculture, Horticulture and Forestry,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HAS ADOPTED THIS DECISION:"/>
         </p>
      </formula>
   </preamble>
   <body>
      <unit eId="art_1" kind="article">
         <num>
            <t v="Article 1"/>
         </num>
         <p>
            <t v="The United Kingdom is released from the obligation to apply Directive 2002/55/EC, with the exception of Articles 2 to 20, 34(1) and 39, to the following species or sub-species."/>
         </p>
         <table cols="2">
            <rowGroup columns="2">
               <heading>
                  <emphasis kind="i">
                     <t v="Allium cepa"/>
                  </emphasis>
                  <t v=" L."/>
               </heading>
               <tr>
                  <td>
                     <unit eId="art_1/tab_1/tr_1/td_1/idt_1" kind="indent">
                        <num>
                           <t v="—"/>
                        </num>
                        <p>
                           <t v="Aggregatum Group"/>
                        </p>
                     </unit>
                  </td>
                  <td>
                     <p>
                        <t v="Shallot"/>
                     </p>
                  </td>
               </tr>
            </rowGroup>
            <tr>
               <td>
                  <p>
                     <emphasis kind="i">
                        <t v="Allium fistulosum"/>
                     </emphasis>
                     <t v=" L."/>
                  </p>
               </td>
               <td>
                  <p>
                     <t v="Japanese bunching onion or Welsh onion"/>
                  </p>
               </td>
            </tr>
            <tr>
               <td>
                  <p>
                     <emphasis kind="i">
                        <t v="Allium sativum"/>
                     </emphasis>
                     <t v=" L."/>
                  </p>
               </td>
               <td>
                  <p>
                     <t v="Garlic"/>
                  </p>
               </td>
            </tr>
            <tr>
               <td>
                  <p>
                     <emphasis kind="i">
                        <t v="Allium schoenoprasum"/>
                     </emphasis>
                     <t v=" L."/>
                  </p>
               </td>
               <td>
                  <p>
                     <t v="Chives"/>
                  </p>
               </td>
            </tr>
            <tr>
               <td>
                  <p>
                     <emphasis kind="i">
                        <t v="Rheum rhabarbarum"/>
                     </emphasis>
                     <t v=" L."/>
                  </p>
               </td>
               <td>
                  <p>
                     <t v="Rhubarb"/>
                  </p>
               </td>
            </tr>
         </table>
      </unit>
      <unit eId="art_2" kind="article">
         <num>
            <t v="Article 2"/>
         </num>
         <p>
            <t v="This Decision is addressed to the United Kingdom."/>
         </p>
      </unit>
