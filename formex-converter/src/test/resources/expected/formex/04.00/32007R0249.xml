   <source celex="32007R0249">
      <publication series="L" number="69" date="2007-03-09" page="16"/>
   </source>
   <preface>
      <longTitle>
         <p>
            <docType>
               <emphasis kind="uc">
                  <t v="Commission Regulation"/>
               </emphasis>
            </docType>
            <t v=" "/>
            <docNumber>
               <t v="(EC) No 249/2007"/>
            </docNumber>
         </p>
         <p>
            <t v="of "/>
            <docDate asWritten="8 March 2007" date="2007-03-08"/>
         </p>
         <p>
            <docPurpose>
               <t v="amending Regulation (EC) No 1431/94 laying down detailed rules for the application in the poultrymeat sector of the import arrangements provided for in Council Regulation (EC) No 774/94 opening and providing for the administration of certain Community tariff quotas for poultrymeat and certain other agricultural products"/>
            </docPurpose>
         </p>
      </longTitle>
   </preface>
   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE COMMISSION OF THE EUROPEAN COMMUNITIES,"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to the Treaty establishing the European Community,"/>
            </p>
         </unit>
         <unit eId="pbl_1/cit_2" kind="citation">
            <p>
               <t v="Having regard to Council Regulation (EEC) No 2777/75 of "/>
               <date asWritten="29 October 1975" date="1975-10-29"/>
               <t v=" on the common organisation of the market in poultrymeat"/>
               <noteRef href="#note_1" marker="1"/>
               <t v=", and in particular Article 6(1) thereof,"/>
            </p>
         </unit>
         <unit eId="pbl_1/cit_3" kind="citation">
            <p>
               <t v="Having regard to Council Regulation (EC) No 774/94 of "/>
               <date asWritten="29 March 1994" date="1994-03-29"/>
               <t v=" opening and providing for the administration of certain Community tariff quotas for high-quality beef, and for pigmeat, poultrymeat, wheat and meslin, and brans, sharps and other residues"/>
               <noteRef href="#note_2" marker="2"/>
               <t v=", and in particular Article 7 thereof,"/>
            </p>
         </unit>
      </citations>
      <recitals>
         <intro>
            <p>
               <t v="Whereas:"/>
            </p>
         </intro>
         <unit eId="pbl_1/rct_1" kind="recital">
            <num>
               <t v="(1)"/>
            </num>
            <p>
               <t v="The tariff quota for group 1 provided for in Annex I to Commission Regulation (EC) No 1431/94"/>
               <noteRef href="#note_3" marker="3"/>
               <t v=", with the serial number 09.4410 covering codes CN "/>
               <t v="02071410"/>
               <t v=", "/>
               <t v="02071450"/>
               <t v=" and "/>
               <t v="02071470"/>
               <t v=" (frozen chicken cuts), is specifically allocated to Brazil."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_2" kind="recital">
            <num>
               <t v="(2)"/>
            </num>
            <p>
               <t v="The Agreement in the form of an Exchange of Letters between the European Community and Brazil reached during negotiations under Article XXIV:6 and Article XXVIII of the General Agreement on Tariffs and Trade (GATT) 1994, approved by Council Decision 2006/963/EC"/>
               <noteRef href="#note_4" marker="4"/>
               <t v=", provides for an annual import tariff quota for poultrymeat of "/>
               <t v="2 332"/>
               <t v=" tonnes for certain frozen chicken cuts (CN codes "/>
               <t v="02071410"/>
               <t v=", "/>
               <t v="02071450"/>
               <t v=" and "/>
               <t v="02071470"/>
               <t v="), at a rate of 0 %."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_3" kind="recital">
            <num>
               <t v="(3)"/>
            </num>
            <p>
               <t v="This amount should be added to the quota for group 1."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_4" kind="recital">
            <num>
               <t v="(4)"/>
            </num>
            <p>
               <t v="Regulation (EC) No 1431/94 should therefore be amended accordingly."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_5" kind="recital">
            <num>
               <t v="(5)"/>
            </num>
            <p>
               <t v="The measures provided for in this Regulation are in accordance with the opinion of the Management Committee for Poultrymeat and Eggs,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HAS ADOPTED THIS REGULATION:"/>
         </p>
      </formula>
   </preamble>
   <body>
      <unit eId="art_1" kind="article">
         <num>
            <t v="Article 1"/>
         </num>
         <p>
            <t v="Annex I to Regulation (EC) No 1431/94 is hereby replaced by the Annex hereto."/>
         </p>
      </unit>
      <unit eId="art_2" kind="article">
         <num>
            <t v="Article 2"/>
         </num>
         <p>
            <t v="This Regulation shall enter into force on the day of its publication in the "/>
            <emphasis kind="i">
               <t v="Official Journal of the European Union"/>
            </emphasis>
            <t v="."/>
         </p>
      </unit>
   </body>
   <conclusions>
      <p>
         <t v="This Regulation shall be binding in its entirety and directly applicable in all Member States."/>
      </p>
