   <source celex="32013R0038">
      <publication series="L" number="16" date="2013-01-19" page="14"/>
   </source>
   <preface>
      <longTitle>
         <p>
            <docType>
               <emphasis kind="uc">
                  <t v="Commission Implementing Regulation"/>
               </emphasis>
            </docType>
            <t v=" "/>
            <docNumber>
               <t v="(EU) No 38/2013"/>
            </docNumber>
         </p>
         <p>
            <t v="of "/>
            <docDate asWritten="18 January 2013" date="2013-01-18"/>
         </p>
         <p>
            <docPurpose>
               <t v="on the issue of licences for the import of garlic in the subperiod from "/>
               <date asWritten="1 March 2013" date="2013-03-01"/>
               <t v=" to "/>
               <date asWritten="31 May 2013" date="2013-05-31"/>
            </docPurpose>
         </p>
      </longTitle>
   </preface>
   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE EUROPEAN COMMISSION,"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to the Treaty on the Functioning of the European Union,"/>
            </p>
         </unit>
         <unit eId="pbl_1/cit_2" kind="citation">
            <p>
               <t v="Having regard to Council Regulation (EC) No 1234/2007 of "/>
               <date asWritten="22 October 2007" date="2007-10-22"/>
               <t v=" establishing a common organisation of agricultural markets and on specific provisions for certain agricultural products (Single CMO Regulation)"/>
               <noteRef href="#note_1" marker="1"/>
               <t v=","/>
            </p>
         </unit>
         <unit eId="pbl_1/cit_3" kind="citation">
            <p>
               <t v="Having regard to Commission Regulation (EC) No 1301/2006 of "/>
               <date asWritten="31 August 2006" date="2006-08-31"/>
               <t v=" laying down common rules for the administration of import tariff quotas for agricultural products managed by a system of import licences"/>
               <noteRef href="#note_2" marker="2"/>
               <t v=", and in particular Article 7(2) thereof,"/>
            </p>
         </unit>
      </citations>
      <recitals>
         <intro>
            <p>
               <t v="Whereas:"/>
            </p>
         </intro>
         <unit eId="pbl_1/rct_1" kind="recital">
            <num>
               <t v="(1)"/>
            </num>
            <p>
               <t v="Commission Regulation (EC) No 341/2007"/>
               <noteRef href="#note_3" marker="3"/>
               <t v=" opens and provides for the administration of tariff quotas and introduces a system of import licences and certificates of origin for garlic and other agricultural products imported from third countries."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_2" kind="recital">
            <num>
               <t v="(2)"/>
            </num>
            <p>
               <t v="The quantities for which "/>
               <quote startQuote="‘" endQuote="’">
                  <t v="A"/>
               </quote>
               <t v=" licence applications have been lodged by traditional importers and by new importers during the first seven working days of January 2013, pursuant to Article 10(1) of Regulation (EC) No 341/2007 exceed the quantities available for products originating in China."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_3" kind="recital">
            <num>
               <t v="(3)"/>
            </num>
            <p>
               <t v="Therefore, in accordance with Article 7(2) of Regulation (EC) No 1301/2006, it is now necessary to establish the extent to which the "/>
               <quote startQuote="‘" endQuote="’">
                  <t v="A"/>
               </quote>
               <t v=" licence applications sent to the Commission by "/>
               <date asWritten="14 January 2013" date="2013-01-14"/>
               <t v=" can be met in accordance with Article 12 of Regulation (EC) No 341/2007."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_4" kind="recital">
            <num>
               <t v="(4)"/>
            </num>
            <p>
               <t v="In order to ensure sound management of the procedure of issuing import licences, the present Regulation should enter into force immediately after its publication,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HAS ADOPTED THIS REGULATION:"/>
         </p>
      </formula>
   </preamble>
   <body>
      <unit eId="art_1" kind="article" rank="1">
         <num>
            <t v="Article 1"/>
         </num>
         <p>
            <t v="Applications for "/>
            <quote startQuote="‘" endQuote="’">
               <t v="A"/>
            </quote>
            <t v=" import licences lodged pursuant to Article 10(1) of Regulation (EC) No 341/2007 during the first seven working days of January 2013 and sent to the Commission by "/>
            <date asWritten="14 January 2013" date="2013-01-14"/>
            <t v=" shall be met at a percentage rate of the quantities applied for as set out in the Annex to this Regulation."/>
         </p>
      </unit>
      <unit eId="art_2" kind="article" rank="1">
         <num>
            <t v="Article 2"/>
         </num>
         <p>
            <t v="This Regulation shall enter into force on the day of its publication in the "/>
            <emphasis kind="i">
               <t v="Official Journal of the European Union"/>
            </emphasis>
            <t v="."/>
         </p>
      </unit>
   </body>
   <conclusions>
      <p>
         <t v="This Regulation shall be binding in its entirety and directly applicable in all Member States."/>
      </p>
