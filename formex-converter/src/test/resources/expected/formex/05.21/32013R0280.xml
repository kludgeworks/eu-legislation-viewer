   <source celex="32013R0280">
      <publication series="L" number="84" date="2013-03-23" page="17"/>
   </source>
   <preface>
      <longTitle>
         <p>
            <docType>
               <emphasis kind="uc">
                  <t v="Commission Regulation"/>
               </emphasis>
            </docType>
            <t v=" "/>
            <docNumber>
               <t v="(EU) No 280/2013"/>
            </docNumber>
         </p>
         <p>
            <t v="of "/>
            <docDate date="2013-03-22">
               <t v="22 March 2013"/>
            </docDate>
         </p>
         <p>
            <docPurpose>
               <t v="amending Regulation (EC) No 62/2006 concerning the technical specification for interoperability relating to the telematic applications for freight subsystem of the trans-European conventional rail system"/>
            </docPurpose>
         </p>
         <p>
            <t v="(Text with EEA relevance)"/>
         </p>
      </longTitle>
   </preface>
   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE EUROPEAN COMMISSION,"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to the Treaty on the Functioning of the European Union,"/>
            </p>
         </unit>
         <unit eId="pbl_1/cit_2" kind="citation">
            <p>
               <t v="Having regard to Directive 2008/57/EC of the European Parliament and of the Council of "/>
               <date date="2008-06-17">
                  <t v="17 June 2008"/>
               </date>
               <t v=" on the interoperability of the rail system within the Community"/>
               <noteRef href="#note_1" marker="1"/>
               <t v=", and in particular Article 6(1) thereof,"/>
            </p>
         </unit>
      </citations>
      <recitals>
         <intro>
            <p>
               <t v="Whereas:"/>
            </p>
         </intro>
         <unit eId="pbl_1/rct_1" kind="recital">
            <num>
               <t v="(1)"/>
            </num>
            <p>
               <t v="Article 4b of Commission Regulation (EC) No 62/2006 of "/>
               <date date="2005-12-23">
                  <t v="23 December 2005"/>
               </date>
               <t v=" concerning the technical specification for interoperability relating to the telematic applications for freight subsystem of the trans-European conventional rail system"/>
               <noteRef href="#note_2" marker="2"/>
               <t v=" provides that the European Railway Agency has to update the documents referred to in Annex A to Regulation (EC) No 62/2006 on the basis of change requests that are validated before "/>
               <date date="2012-05-13">
                  <t v="13 May 2012"/>
               </date>
               <t v="."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_2" kind="recital">
            <num>
               <t v="(2)"/>
            </num>
            <p>
               <t v="The Commission has received European Railway Agency recommendation ERA/REC/06a-2012/INT of "/>
               <date date="2012-07-24">
                  <t v="24 July 2012"/>
               </date>
               <t v=" to update Annex A to Regulation (EC) No 62/2006 in order to refer to the technical documents which have been amended in accordance with the change management process ("/>
               <quote startQuote="‘" endQuote="’">
                  <t v="Final Baseline 5.2"/>
               </quote>
               <t v=")."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_3" kind="recital">
            <num>
               <t v="(3)"/>
            </num>
            <p>
               <t v="Regulation (EC) No 62/2006 should therefore be amended accordingly."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_4" kind="recital">
            <num>
               <t v="(4)"/>
            </num>
            <p>
               <t v="The measures provided for in this Regulation are in accordance with the opinion of the Committee established in accordance with Article 29(1) of Directive 2008/57/EC,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HAS ADOPTED THIS REGULATION:"/>
         </p>
      </formula>
   </preamble>
   <body>
      <unit eId="art_1" kind="article" rank="1">
         <num>
            <t v="Article 1"/>
         </num>
         <p>
            <t v="Annex A to Regulation (EC) No 62/2006 is replaced by the text set out in the Annex to this Regulation."/>
         </p>
      </unit>
      <unit eId="art_2" kind="article" rank="1">
         <num>
            <t v="Article 2"/>
         </num>
         <p>
            <t v="This Regulation shall enter into force on the day following that of its publication in the "/>
            <emphasis kind="i">
               <t v="Official Journal of the European Union"/>
            </emphasis>
            <t v="."/>
         </p>
      </unit>
   </body>
   <conclusions>
      <p>
         <t v="This Regulation shall be binding in its entirety and directly applicable in all Member States."/>
      </p>
      <signature>
         <placeAndDate>
            <t v="Done at Brussels, "/>
            <date date="2013-03-22">
