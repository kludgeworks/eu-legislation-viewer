   <preface>
      <longTitle>
         <p>
            <docType>
               <emphasis kind="uc">
                  <t v="European Council Decision"/>
               </emphasis>
            </docType>
            <docNumber/>
         </p>
         <p>
            <t v="of "/>
            <docDate asWritten="30 August 2014" date="2014-08-30"/>
         </p>
         <p>
            <docPurpose>
               <t v="electing the President of the European Council"/>
            </docPurpose>
         </p>
         <p>
            <t v="(2014/638/EU)"/>
         </p>
      </longTitle>
   </preface>
   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE EUROPEAN COUNCIL,"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to the Treaty on the European Union, and in particular Article 15(5) thereof,"/>
            </p>
         </unit>
      </citations>
      <recitals>
         <intro>
            <p>
               <t v="Whereas:"/>
            </p>
         </intro>
         <unit eId="pbl_1/rct_1" kind="recital">
            <num>
               <t v="(1)"/>
            </num>
            <p>
               <t v="On "/>
               <date asWritten="30 November 2014" date="2014-11-30"/>
               <t v=", the term of office of the current President of the European Council Mr Herman VAN ROMPUY will come to an end."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_2" kind="recital">
            <num>
               <t v="(2)"/>
            </num>
            <p>
               <t v="A new President of the European Council should therefore be elected,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HAS ADOPTED THIS DECISION:"/>
         </p>
      </formula>
   </preamble>
   <body>
      <unit eId="art_1" kind="article">
         <num>
            <t v="Article 1"/>
         </num>
         <p>
            <t v="Mr Donald TUSK is hereby elected President of the European Council for the period from "/>
            <date asWritten="1 December 2014" date="2014-12-01"/>
            <t v=" until "/>
            <date asWritten="31 May 2017" date="2017-05-31"/>
            <t v="."/>
         </p>
      </unit>
      <unit eId="art_2" kind="article">
         <num>
            <t v="Article 2"/>
         </num>
         <p>
            <t v="This Decision shall be notified to Mr Donald TUSK by the Secretary-General of the Council."/>
         </p>
      </unit>
      <unit eId="art_3" kind="article">
         <num>
            <t v="Article 3"/>
         </num>
         <p>
            <t v="This Decision shall be published in the "/>
            <emphasis kind="i">
               <t v="Official Journal of the European Union"/>
            </emphasis>
            <t v="."/>
         </p>
      </unit>
   </body>
