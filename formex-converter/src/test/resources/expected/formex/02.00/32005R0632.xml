               <t v="Mariann "/>
               <emphasis kind="uc">
                  <t v="Fischer Boel"/>
               </emphasis>
            </role>
            <person>
               <emphasis kind="i">
                  <t v="Member of the Commission"/>
               </emphasis>
            </person>
         </signatory>
      </signature>
   </conclusions>
