                  <t v="The President"/>
               </emphasis>
            </role>
            <person>
               <t v="José Manuel "/>
               <emphasis kind="uc">
                  <t v="Barroso"/>
               </emphasis>
            </person>
         </signatory>
      </signature>
   </conclusions>
