      <unit eId="art_3" kind="article">
         <num>
            <t v="Article 3"/>
         </num>
         <p>
            <t v="In Article 7 of Regulation (EC) No 1788/2001, the following paragraph is added:"/>
         </p>
         <quotedStructure eId="art_3/qstr_1">
            <unit eId="art_3/qstr_1/sub_1" kind="subparagraph">
               <p>
                  <quote startQuote="‘" endQuote="’">
                     <t v="For the Czech Republic, Cyprus, Estonia, Hungary, Latvia, Lithuania, Malta, Poland, Slovakia and Slovenia, the date of information referred to in the second paragraph shall be "/>
                     <date asWritten="1 May 2004" date="2004-05-01"/>
                     <t v="."/>
                  </quote>
               </p>
            </unit>
         </quotedStructure>
      </unit>
      <unit eId="art_4" kind="article">
         <num>
            <t v="Article 4"/>
         </num>
         <p>
            <t v="In Article 2 of Regulation (EC) No 473/2002, the following paragraph is inserted after the first paragraph:"/>
         </p>
         <quotedStructure eId="art_4/qstr_1">
            <unit eId="art_4/qstr_1/sub_1" kind="subparagraph">
               <p>
                  <quote startQuote="‘" endQuote="’">
                     <t v="For the Czech Republic, Cyprus, Estonia, Hungary, Latvia, Lithuania, Malta, Poland, Slovakia and Slovenia, the date referred to in the first indent of the first paragraph shall be "/>
                     <date asWritten="1 August 2004" date="2004-08-01"/>
                     <t v=" and the date referred to in the second indent of the first paragraph shall be "/>
                     <date asWritten="31 December 2005" date="2005-12-31"/>
                     <t v="."/>
                  </quote>
               </p>
            </unit>
         </quotedStructure>
      </unit>
      <unit eId="art_5" kind="article">
         <num>
            <t v="Article 5"/>
         </num>
         <p>
            <t v="In Article 6 of Regulation (EC) No 223/2003, the following paragraph is added:"/>
         </p>
         <quotedStructure eId="art_5/qstr_1">
            <unit eId="art_5/qstr_1/sub_1" kind="subparagraph">
               <p>
                  <quote startQuote="‘" endQuote="’">
                     <t v="For the Czech Republic, Cyprus, Estonia, Hungary, Latvia, Lithuania, Malta, Poland, Slovakia and Slovenia, the date of application referred to in point (a) of the first paragraph shall be "/>
                     <date asWritten="1 May 2004" date="2004-05-01"/>
                     <t v=" at the latest."/>
                  </quote>
               </p>
            </unit>
         </quotedStructure>
      </unit>
      <unit eId="art_6" kind="article">
         <num>
            <t v="Article 6"/>
         </num>
         <p>
            <t v="This Regulation shall enter into force subject to and on the date of the entry into force of the Treaty of Accession of the Czech Republic, Estonia, Cyprus, Latvia, Lithuania, Hungary, Malta, Poland, Slovenia and Slovakia."/>
         </p>
      </unit>
