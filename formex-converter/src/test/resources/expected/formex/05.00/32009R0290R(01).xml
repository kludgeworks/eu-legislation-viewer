      <unit eId="cor_1" kind="correction">
         <p>
            <t v="On page 77, Annex I(1), replace the footnote to paragraph 7 of Section III of Part 1 with the following:"/>
         </p>
         <new>
            <quotedStructure eId="cor_1/new/qstr_1">
               <p>
                  <num>
                     <t v="‘"/>
                     <t v="(*)"/>
                  </num>
                  <t v="i.e. the sum of the intra-stratum variances defined as "/>
                  <math>
                     <m:math xmlns:m="http://www.w3.org/1998/Math/MathML" display="inline">
                        <m:mrow>
                           <munder xmlns="http://www.w3.org/1998/Math/MathML">
                              <m:mi>Σ</m:mi>
                              <m:mrow>
                                 <m:mi mathvariant="italic">h</m:mi>
                              </m:mrow>
                           </munder>
                           <munder xmlns="http://www.w3.org/1998/Math/MathML">
                              <m:mi>Σ</m:mi>
                              <m:mrow>
                                 <m:mi mathvariant="italic">i</m:mi>
                                 <m:mo>∈</m:mo>
                                 <m:mi mathvariant="italic">h</m:mi>
                              </m:mrow>
                           </munder>
                           <m:mrow>
                              <m:mfrac>
                                 <m:mrow>
                                    <m:mn>1</m:mn>
                                 </m:mrow>
                                 <m:mrow>
                                    <m:mi mathvariant="italic">n</m:mi>
                                 </m:mrow>
                              </m:mfrac>
                           </m:mrow>
                           <m:mrow>
                              <msup xmlns="http://www.w3.org/1998/Math/MathML">
                                 <m:mrow>
                                    <m:mo fence="true">(</m:mo>
                                    <msub>
                                       <m:mi mathvariant="italic">x</m:mi>
                                       <m:mrow>
                                          <m:mi mathvariant="italic">i</m:mi>
                                       </m:mrow>
                                    </msub>
                                    <m:mo>–</m:mo>
                                    <msub>
                                       <mover>
                                          <m:mi mathvariant="italic">x</m:mi>
                                          <m:mrow>
                                             <m:mo>–</m:mo>
                                          </m:mrow>
                                       </mover>
                                       <m:mrow>
                                          <m:mi mathvariant="italic">h</m:mi>
                                       </m:mrow>
                                    </msub>
                                    <m:mo fence="true">)</m:mo>
                                 </m:mrow>
                                 <m:mrow>
                                    <m:mn>2</m:mn>
                                 </m:mrow>
                              </msup>
                           </m:mrow>
                        </m:mrow>
                     </m:math>
                  </math>
                  <t v=" is to be substantially lower than the total variance of the reporting population defined as "/>
                  <math>
                     <m:math xmlns:m="http://www.w3.org/1998/Math/MathML" display="inline">
                        <m:mrow>
                           <m:munderover>
                              <m:mi xmlns="http://www.w3.org/1998/Math/MathML">Σ</m:mi>
                              <m:mrow>
                                 <m:mi mathvariant="italic">i</m:mi>
                                 <m:mo>=</m:mo>
                                 <m:mi>l</m:mi>
                              </m:mrow>
                              <m:mrow xmlns="http://www.w3.org/1998/Math/MathML">
                                 <m:mi mathvariant="italic">n</m:mi>
                              </m:mrow>
                           </m:munderover>
                           <m:mrow>
                              <m:mfrac>
                                 <m:mrow>
                                    <m:mn>1</m:mn>
                                 </m:mrow>
                                 <m:mrow>
                                    <m:mi mathvariant="italic">n</m:mi>
                                 </m:mrow>
                              </m:mfrac>
                           </m:mrow>
                           <m:mrow>
                              <msup xmlns="http://www.w3.org/1998/Math/MathML">
                                 <m:mrow>
                                    <m:mo fence="true">(</m:mo>
                                    <msub>
                                       <m:mi mathvariant="italic">x</m:mi>
                                       <m:mrow>
                                          <m:mi mathvariant="italic">i</m:mi>
                                       </m:mrow>
                                    </msub>
                                    <m:mo>–</m:mo>
                                    <mover>
                                       <m:mi mathvariant="italic">x</m:mi>
                                       <m:mrow>
                                          <m:mo>–</m:mo>
                                       </m:mrow>
                                    </mover>
                                    <m:mo fence="true">)</m:mo>
                                 </m:mrow>
                                 <m:mrow>
                                    <m:mn>2</m:mn>
                                 </m:mrow>
                              </msup>
                           </m:mrow>
                        </m:mrow>
                     </m:math>
                  </math>
                  <t v=", where h indicates each stratum, x"/>
                  <emphasis kind="sub">
                     <t v="i"/>
                  </emphasis>
                  <t v=" the interest rate for institution i, "/>
                  <math>
                     <m:math xmlns:m="http://www.w3.org/1998/Math/MathML" display="inline">
                        <m:mrow>
                           <msub xmlns="http://www.w3.org/1998/Math/MathML">
                              <mover>
                                 <m:mi mathvariant="italic">x</m:mi>
                                 <m:mrow>
                                    <m:mo>–</m:mo>
                                 </m:mrow>
                              </mover>
                              <m:mrow>
                                 <m:mi mathvariant="italic">h</m:mi>
                              </m:mrow>
                           </msub>
                        </m:mrow>
                     </m:math>
                  </math>
                  <t v=" the simple average interest rate of stratum h, n the total number of institutions in the sample and "/>
                  <math>
                     <m:math xmlns:m="http://www.w3.org/1998/Math/MathML" display="inline">
                        <m:mrow>
                           <mover xmlns="http://www.w3.org/1998/Math/MathML">
                              <m:mi mathvariant="italic">x</m:mi>
                              <m:mrow>
                                 <m:mo>–</m:mo>
                              </m:mrow>
                           </mover>
                        </m:mrow>
                     </m:math>
                  </math>
                  <t v=" the simple average of interest rates of all institutions in the sample."/>
                  <t v="’"/>
                  <t v=";"/>
               </p>
            </quotedStructure>
         </new>
      </unit>
