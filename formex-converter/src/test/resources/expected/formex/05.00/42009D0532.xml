   <body>
      <unit eId="art_1" kind="article" rank="1">
         <num>
            <t v="Article 1"/>
         </num>
         <p>
            <t v="Mr José Manuel DURÃO BARROSO is hereby nominated as the person the Council intends to appoint as President of the Commission for the period from "/>
            <date date="2009-11-01">
               <t v="1 November 2009"/>
            </date>
            <t v=" to "/>
            <date date="2014-10-31">
               <t v="31 October 2014"/>
            </date>
            <t v="."/>
         </p>
      </unit>
      <unit eId="art_2" kind="article" rank="1">
         <num>
            <t v="Article 2"/>
         </num>
         <p>
            <t v="This Decision shall be forwarded to the European Parliament."/>
         </p>
      </unit>
      <unit eId="art_3" kind="article" rank="1">
         <num>
            <t v="Article 3"/>
         </num>
         <p>
            <t v="This Decision shall be published in the "/>
            <emphasis kind="i">
               <t v="Official Journal of the European Union"/>
            </emphasis>
            <t v="."/>
         </p>
      </unit>
