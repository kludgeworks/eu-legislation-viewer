   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE COUNCIL OF THE EUROPEAN UNION, MEETING IN THE COMPOSITION OF HEADS OF STATE OR GOVERNMENT,"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to the Treaty establishing the European Community, and in particular Article 213(1), second and third subparagraphs, and Article 214(2), first subparagraph thereof, as well as to the Protocol on the enlargement of the European Union, and in particular Article 4(3) thereof,"/>
            </p>
         </unit>
      </citations>
