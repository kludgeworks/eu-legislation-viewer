      <recitals>
         <intro>
            <p>
               <t v="Whereas:"/>
            </p>
         </intro>
         <unit eId="pbl_1/rct_1" kind="recital">
            <num>
               <t v="1."/>
            </num>
            <p>
               <t v="The European Council in its Resolution of "/>
               <date asWritten="16 June 1997" date="1997-06-16"/>
               <t v=" (hereinafter the "/>
               <quote startQuote="‘" endQuote="’">
                  <t v="Resolution"/>
               </quote>
               <t v=") agreed to set up an exchange rate mechanism (hereinafter "/>
               <quote startQuote="‘" endQuote="’">
                  <t v="ERM II"/>
               </quote>
               <t v=") when the third stage of Economic and Monetary Union began on "/>
               <date asWritten="1 January 1999" date="1999-01-01"/>
               <t v="."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_2" kind="recital">
            <num>
               <t v="2."/>
            </num>
            <p>
               <t v="Under the terms of the Resolution, ERM II is designed to help ensure that non-euro area Member States participating in ERM II orient their policies to stability, foster convergence and thereby help the non-euro area Member States in their efforts to adopt the euro."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_3" kind="recital">
            <num>
               <t v="3."/>
            </num>
            <p>
               <t v="Lithuania, as a Member State with a derogation, has participated in ERM II since 2004. Lietuvos bankas is a party to the Agreement of "/>
               <date asWritten="16 March 2006" date="2006-03-16"/>
               <t v=" between the European Central Bank and the national central banks of the Member States outside the euro area laying down the operating procedures for an exchange rate mechanism in stage three of Economic and Monetary Union"/>
               <noteRef href="#note_1" marker="1"/>
               <t v=", as amended by the Agreement of "/>
               <date asWritten="21 December 2006" date="2006-12-21"/>
               <noteRef href="#note_2" marker="2"/>
               <t v=", by the Agreement of "/>
               <date asWritten="14 December 2007" date="2007-12-14"/>
               <noteRef href="#note_3" marker="3"/>
               <t v=", by the Agreement of "/>
               <date asWritten="8 December 2008" date="2008-12-08"/>
               <noteRef href="#note_4" marker="4"/>
               <t v=", by the Agreement of "/>
               <date asWritten="13 December 2010" date="2010-12-13"/>
               <noteRef href="#note_5" marker="5"/>
               <t v=", by the Agreement of "/>
               <date asWritten="21 June 2013" date="2013-06-21"/>
               <noteRef href="#note_6" marker="6"/>
               <t v=" and by the Agreement of "/>
               <date asWritten="6 December 2013" date="2013-12-06"/>
               <noteRef href="#note_7" marker="7"/>
               <t v=" (hereinafter collectively referred to as the "/>
               <quote startQuote="‘" endQuote="’">
                  <t v="ERM II Central Bank Agreement"/>
               </quote>
               <t v=")."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_4" kind="recital">
            <num>
               <t v="4."/>
            </num>
            <p>
               <t v="Pursuant to Article 1 of Council Decision 2014/509/EU of "/>
               <date asWritten="23 July 2014" date="2014-07-23"/>
               <t v=" on the adoption by Lithuania of the euro on "/>
               <date asWritten="1 January 2015" date="2015-01-01"/>
               <noteRef href="#note_8" marker="8"/>
               <t v=" the derogation in favour of Lithuania referred to in Article 4 of the 2003 Act of Accession is abrogated with effect from "/>
               <date asWritten="1 January 2015" date="2015-01-01"/>
               <t v=". The euro will be Lithuania's currency from "/>
               <date asWritten="1 January 2015" date="2015-01-01"/>
               <t v=" and Lietuvos bankas should no longer be party to the ERM II Central Bank Agreement from that date."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_5" kind="recital">
            <num>
               <t v="5."/>
            </num>
            <p>
               <t v="It is therefore necessary to amend the ERM II Central Bank Agreement to take account of the abrogation of the derogation in favour of Lithuania,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HAVE AGREED AS FOLLOWS:"/>
         </p>
      </formula>
