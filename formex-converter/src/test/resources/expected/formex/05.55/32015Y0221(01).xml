   <body>
      <unit eId="art_1" kind="article">
         <num>
            <t v="Article 1"/>
         </num>
         <heading>
            <t v="Amendment to the ERM II Central Bank Agreement in view of the abrogation of Lithuania's derogation"/>
         </heading>
         <p>
            <t v="Lietuvos bankas shall no longer be party to the ERM II Central Bank Agreement from "/>
            <date asWritten="1 January 2015" date="2015-01-01"/>
            <t v="."/>
         </p>
      </unit>
      <unit eId="art_2" kind="article">
         <num>
            <t v="Article 2"/>
         </num>
         <heading>
            <t v="Replacement of Annex II to the ERM II Central Bank Agreement"/>
         </heading>
         <p>
            <t v="Annex II to the ERM II Central Bank Agreement is replaced by the text set out in the Annex to this Agreement."/>
         </p>
      </unit>
      <unit eId="art_3" kind="article">
         <num>
            <t v="Article 3"/>
         </num>
         <heading>
            <t v="Final provisions"/>
         </heading>
         <unit eId="art_3/par_1" kind="paragraph">
            <num>
               <t v="1."/>
            </num>
            <p>
               <t v="This Agreement amends the ERM II Central Bank Agreement with effect from "/>
               <date asWritten="1 January 2015" date="2015-01-01"/>
               <t v="."/>
            </p>
         </unit>
         <unit eId="art_3/par_2" kind="paragraph">
            <num>
               <t v="2."/>
            </num>
            <p>
               <t v="This Agreement shall be drawn up in English and duly signed by the Parties' authorised representatives. The ECB, which shall retain the original Agreement, shall send a certified copy of the original Agreement to each euro area and non-euro area national central bank. The Agreement shall be published in the "/>
               <emphasis kind="i">
                  <t v="Official Journal of the European Union"/>
               </emphasis>
               <t v="."/>
            </p>
         </unit>
      </unit>
   </body>
