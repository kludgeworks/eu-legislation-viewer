   <source celex="32020R0217R(01)">
      <publication series="L" number="51" date="2020-02-25" page="13"/>
   </source>
   <preface>
      <longTitle>
         <p>
            <t v="Corrigendum to Commission Delegated Regulation (EU) 2020/217 of "/>
            <date asWritten="4 October 2019" date="2019-10-04"/>
            <t v=" amending, for the purposes of its adaptation to technical and scientific progress, Regulation (EC) No 1272/2008 of the European Parliament and of the Council on classification, labelling and packaging of substances and mixtures and correcting that Regulation"/>
         </p>
         <p>
            <emphasis kind="i">
               <ref kind="oj" series="L" number="44" date="2020-02-18">
                  <t v="(Official Journal of the European Union of L 44 of 18 February 2020)"/>
               </ref>
            </emphasis>
         </p>
      </longTitle>
   </preface>
   <body>
      <unit eId="cor_1" kind="correction">
         <p>
            <t v="On page 4, Article 3 is replaced as follows:"/>
         </p>
         <quotedStructure eId="cor_1/qstr_1">
            <p>
               <t v="‘"/>
               <t v="Article 3"/>
            </p>
            <p>
               <t v="Entry into force and application"/>
            </p>
            <unit eId="cor_1/qstr_1/sub_1" kind="subparagraph">
               <p>
                  <t v="This Regulation shall enter into force on the twentieth day following that of its publication in the "/>
                  <emphasis kind="i">
                     <t v="Official Journal of the European Union"/>
                  </emphasis>
                  <t v="."/>
               </p>
            </unit>
            <unit eId="cor_1/qstr_1/sub_2" kind="subparagraph">
               <p>
                  <t v="It shall apply from "/>
                  <date asWritten="1 October 2021" date="2021-10-01"/>
                  <t v="."/>
               </p>
            </unit>
            <unit eId="cor_1/qstr_1/sub_3" kind="subparagraph">
               <p>
                  <t v="However, Article 2 shall apply from "/>
                  <date asWritten="1 December 2019" date="2019-12-01"/>
                  <t v="."/>
               </p>
            </unit>
            <unit eId="cor_1/qstr_1/sub_4" kind="subparagraph">
               <p>
                  <t v="Substances and mixtures may, before "/>
                  <date asWritten="1 October 2021" date="2021-10-01"/>
                  <t v=", be classified, labelled and packaged in accordance with Regulation (EC) No 1272/2008 as amended by this Regulation."/>
                  <t v="’"/>
               </p>
            </unit>
         </quotedStructure>
      </unit>
   </body>
</legalText>

