   <source celex="32008L0048R(05)">
      <publication series="L" number="234" date="2011-09-10" page="46"/>
   </source>
   <preface>
      <longTitle>
         <p>
            <t v="Corrigendum to Directive 2008/48/EC of the European Parliament and of the Council of "/>
            <date asWritten="23 April 2008" date="2008-04-23"/>
            <t v=" on credit agreements for consumers and repealing Council Directive 87/102/EEC"/>
         </p>
         <p>
            <t v="("/>
            <ref kind="oj" series="L" number="133" date="2008-05-22">
               <t v="Official Journal of the European Union L 133 of 22 May 2008"/>
            </ref>
            <t v=")"/>
         </p>
      </longTitle>
   </preface>
   <body>
      <unit eId="cor_1" kind="correction">
         <p>
            <t v="The Corrigendum which was published in the "/>
            <ref kind="oj"
                 series="L"
                 number="199"
                 date="2010-07-31"
                 page="40">
               <emphasis kind="i">
                  <t v="Official Journal of the European Union"/>
               </emphasis>
               <t v=" L 199 of 31 July 2010, p. 40"/>
            </ref>
            <t v=", shall be cancelled and replaced with regard to the following item:"/>
         </p>
         <p>
            <t v="On page 87, Annex II, heading 3 shall be replaced by the following:"/>
         </p>
         <new>
            <quotedStructure eId="cor_1/new/qstr_1">
               <unit eId="cor_1/new/qstr_1/pnt_3"
                     kind="level"
                     depth="1"
                     numbered="true">
                  <num>
                     <t v="‘"/>
                     <t v="3."/>
                  </num>
                  <heading>
                     <emphasis kind="b">
                        <t v="Costs of the credit"/>
                     </emphasis>
                  </heading>
                  <table cols="2">
                     <tr>
                        <td>
                           <p>
                              <t v="The borrowing rate or, if applicable, different borrowing rates which apply to the credit agreement"/>
                           </p>
                        </td>
                        <td>
                           <p>
                              <t v="[ %"/>
                           </p>
                           <list kind="dash">
                              <unit eId="cor_1/new/qstr_1/pnt_3/tab_1/tr_1/td_2/idt_1" kind="indent">
                                 <p>
                                    <t v="fixed, or"/>
                                 </p>
                              </unit>
                              <unit eId="cor_1/new/qstr_1/pnt_3/tab_1/tr_1/td_2/idt_2" kind="indent">
                                 <p>
                                    <t v="variable (with the index or reference rate applicable to the initial borrowing rate),"/>
                                 </p>
                              </unit>
                              <unit eId="cor_1/new/qstr_1/pnt_3/tab_1/tr_1/td_2/idt_3" kind="indent">
                                 <p>
                                    <t v="periods]"/>
                                 </p>
                              </unit>
                           </list>
                        </td>
                     </tr>
                     <tr>
                        <td>
                           <p>
                              <t v="Annual Percentage Rate of Charge (APR)"/>
                           </p>
                           <p>
                              <emphasis kind="i">
                                 <t v="This is the total cost expressed as an annual percentage of the total amount of credit"/>
                              </emphasis>
                              <t v="."/>
                           </p>
                           <p>
                              <emphasis kind="i">
                                 <t v="The APR is there to help you compare different offers"/>
                              </emphasis>
                              <t v="."/>
                           </p>
                        </td>
                        <td>
                           <p>
                              <t v="[ % A representative example mentioning all the assumptions used for calculating the rate to be set out here]"/>
                           </p>
                        </td>
                     </tr>
                     <tr>
                        <td>
                           <p>
                              <t v="Is it compulsory, in order to obtain the credit or to obtain it on the terms and conditions marketed, to take out"/>
                           </p>
                        </td>
                        <td/>
                     </tr>
                     <tr>
                        <td>
                           <unit eId="cor_1/new/qstr_1/pnt_3/tab_1/tr_4/td_1/list_2/idt_1" kind="indent">
                              <num>
                                 <t v="—"/>
                              </num>
                              <p>
                                 <t v="an insurance policy securing the credit, or"/>
                              </p>
                           </unit>
                        </td>
                        <td>
                           <p>
                              <t v="Yes/no [if yes, specify the kind of insurance]"/>
                           </p>
                        </td>
                     </tr>
                     <tr>
                        <td>
                           <unit eId="cor_1/new/qstr_1/pnt_3/tab_1/tr_5/td_1/list_3/idt_1" kind="indent">
                              <num>
                                 <t v="—"/>
                              </num>
                              <p>
                                 <t v="another ancillary service contract?"/>
                              </p>
                           </unit>
                        </td>
                        <td>
                           <p>
                              <t v="Yes/no [if yes, specify the kind of ancillary service]"/>
                           </p>
                        </td>
                     </tr>
                     <tr>
                        <td>
                           <p>
                              <emphasis kind="i">
                                 <t v="If the costs of these services are not known by the creditor they are not included in the APR."/>
                              </emphasis>
                           </p>
                        </td>
                        <td/>
                     </tr>
                     <rowGroup columns="2">
                        <heading>
                           <emphasis kind="b">
                              <t v="Related costs"/>
                           </emphasis>
                        </heading>
                        <tr>
                           <td>
                              <p>
                                 <t v="If applicable"/>
                              </p>
                              <p>
                                 <t v="Maintaining one or more accounts is required for recording both payment transactions and drawdowns"/>
                              </p>
                           </td>
                           <td/>
                        </tr>
                        <tr>
                           <td>
                              <p>
                                 <t v="If applicable"/>
                              </p>
                              <p>
                                 <t v="Amount of costs for using a specific means of payment (e.g. a credit card)"/>
                              </p>
                           </td>
                           <td/>
                        </tr>
                        <tr>
                           <td>
                              <p>
                                 <t v="If applicable"/>
                              </p>
                              <p>
                                 <t v="Any other costs deriving from the credit agreement"/>
                              </p>
                           </td>
                           <td/>
                        </tr>
                        <tr>
                           <td>
                              <p>
                                 <t v="If applicable"/>
                              </p>
                              <p>
                                 <t v="Conditions under which the abovementioned costs related to the credit agreement can be changed"/>
                              </p>
                           </td>
                           <td/>
                        </tr>
                        <tr>
                           <td>
                              <p>
                                 <t v="If applicable"/>
                              </p>
                              <p>
                                 <t v="Obligation to pay notarial fees"/>
                              </p>
                           </td>
                           <td/>
                        </tr>
                        <tr>
                           <td>
                              <p>
                                 <t v="Costs in the case of late payments"/>
                              </p>
                           </td>
                           <td rowspan="2">
                              <p>
                                 <t v="You will be charged [… (applicable interest rate and arrangements for its adjustment and, where applicable, default charges)] for late payments."/>
                                 <t v="’"/>
                              </p>
                           </td>
                        </tr>
                        <tr>
                           <td>
                              <p>
                                 <emphasis kind="i">
                                    <t v="Missing payments could have severe consequences for you (e.g. forced sale) and make obtaining credit more difficult."/>
                                 </emphasis>
                              </p>
                           </td>
                        </tr>
                     </rowGroup>
                  </table>
               </unit>
            </quotedStructure>
         </new>
      </unit>
   </body>
