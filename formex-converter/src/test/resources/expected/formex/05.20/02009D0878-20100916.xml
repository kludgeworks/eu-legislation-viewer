   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE COUNCIL OF THE EUROPEAN UNION,"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to the Protocol on transitional provisions, and in particular Article 4 thereof,"/>
            </p>
         </unit>
      </citations>
      <recitals>
         <intro>
            <p>
               <t v="Whereas:"/>
            </p>
         </intro>
         <unit eId="pbl_1/rct_1" kind="recital">
            <num>
               <t v="(1)"/>
            </num>
            <p>
               <t v="Article 4 of the Protocol on transitional provisions provides that until the entry into force of the European Council Decision referred to in the first subparagraph of Article 16(6) of the Treaty on European Union regarding the list of Council configurations, the list of Council configurations, in addition to the General Affairs and the Foreign Affairs ones, should be established by the General Affairs Council, acting by a simple majority."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_2" kind="recital">
            <num>
               <t v="(2)"/>
            </num>
            <p>
               <t v="The list of Council configurations was established by the Council (General Affairs) on "/>
               <date date="2002-07-22">
                  <t v="22 July 2002"/>
               </date>
               <t v=", as part of Annex I to the Council's Rules of Procedure and following the list agreed upon at the European Council meeting in Seville on "/>
               <date date="2002-06-21">
                  <t v="21"/>
               </date>
               <t v=" and "/>
               <date date="2002-06-22">
                  <t v="22 June 2002"/>
               </date>
               <t v="."/>
            </p>
         </unit>
         <unit eId="pbl_1/rct_3" kind="recital">
            <num>
               <t v="(3)"/>
            </num>
            <p>
               <t v="In order to comply with the provisions of the Treaties, it is appropriate to adapt this list, which is to be inserted in the Council's Rules of Procedure,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HAS ADOPTED THIS DECISION:"/>
         </p>
      </formula>
   </preamble>
   <body>
      <unit eId="art_1" kind="article" rank="1">
         <num>
            <t v="Article 1"/>
         </num>
         <p>
            <t v="The list of Council configurations referred to in Article 4 of the Protocol on transitional provisions is set out in Annex."/>
         </p>
      </unit>
      <unit eId="art_2" kind="article" rank="1">
         <num>
            <t v="Article 2"/>
         </num>
         <unit eId="art_2/unp_1" kind="paragraph">
            <p>
               <t v="This Decision shall enter into force on the day of its adoption."/>
            </p>
         </unit>
         <unit eId="art_2/unp_2" kind="paragraph">
            <p>
               <t v="It shall be published in the "/>
               <emphasis kind="i">
                  <t v="Official Journal of the European Union"/>
               </emphasis>
               <t v="."/>
            </p>
         </unit>
      </unit>
