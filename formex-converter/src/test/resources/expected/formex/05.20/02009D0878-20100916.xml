               <t v="1 December 2009"/>
            </docDate>
         </p>
         <p>
            <docPurpose>
               <t v="establishing the list of Council configurations in addition to those referred to in the second and third subparagraphs of Article 16(6) of the Treaty on European Union"/>
            </docPurpose>
         </p>
         <p>
            <t v="(2009/878/EU)"/>
         </p>
      </longTitle>
