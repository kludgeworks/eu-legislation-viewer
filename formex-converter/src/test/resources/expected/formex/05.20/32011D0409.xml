   <preface>
      <longTitle>
         <p>
            <docType>
               <emphasis kind="uc">
                  <t v="Commission Decision"/>
               </emphasis>
            </docType>
            <docNumber/>
         </p>
         <p>
            <t v="of "/>
            <docDate asWritten="11 July 2011" date="2011-07-11"/>
         </p>
         <p>
            <docPurpose>
               <t v="on the position to be taken by the European Union, within the EU-Switzerland Joint Committee, on the rules of procedure to be adopted by it in accordance with Article 19(4) of the Agreement between the European Community and the Swiss Confederation on the simplification of inspections and formalities in respect of the carriage of goods and on customs security measures"/>
            </docPurpose>
         </p>
         <p>
            <t v="(2011/409/EU)"/>
         </p>
      </longTitle>
   </preface>
   <preamble eId="pbl_1">
      <formula name="actingEntity">
         <p>
            <t v="THE EUROPEAN COMMISSION,"/>
         </p>
      </formula>
      <citations>
         <unit eId="pbl_1/cit_1" kind="citation">
            <p>
               <t v="Having regard to the Treaty on the Functioning of the European Union,"/>
            </p>
         </unit>
         <unit eId="pbl_1/cit_2" kind="citation">
            <p>
               <t v="Having regard to the Agreement of "/>
               <date asWritten="25 June 2009" date="2009-06-25"/>
               <t v=" between the European Community and the Swiss Confederation on the simplification of inspections and formalities in respect of the carriage of goods and on customs security measures"/>
               <noteRef href="#note_1" marker="1"/>
               <t v=" (hereinafter "/>
               <quote startQuote="‘" endQuote="’">
                  <t v="the Agreement"/>
               </quote>
               <t v="),"/>
            </p>
         </unit>
         <unit eId="pbl_1/cit_3" kind="citation">
            <p>
               <t v="Having regard to Council Decision 2009/556/EC of "/>
               <date asWritten="25 June 2009" date="2009-06-25"/>
               <t v=" concerning the provisional application and conclusion of the Agreement between the European Community and the Swiss Confederation on the simplification of inspections and formalities in respect of the carriage of goods and on customs security measures"/>
               <noteRef href="#note_2" marker="2"/>
               <t v=", and in particular the second paragraph of Article 5 thereof,"/>
            </p>
         </unit>
      </citations>
      <recitals>
         <intro>
            <p>
               <t v="Whereas:"/>
            </p>
         </intro>
         <unit eId="pbl_1/rct_1" kind="recital">
            <p>
               <t v="Article 19(4) of the Agreement states that the joint committee set up by that Agreement (hereinafter "/>
               <quote startQuote="‘" endQuote="’">
                  <t v="the EU-Switzerland Joint Committee"/>
               </quote>
               <t v=") must adopt its rules of procedure,"/>
            </p>
         </unit>
      </recitals>
      <formula name="enactingFormula">
         <p>
            <t v="HAS ADOPTED THIS DECISION:"/>
         </p>
      </formula>
   </preamble>
   <body>
      <unit eId="art_Sole-Article" kind="article" rank="1">
         <num>
            <t v="Sole Article"/>
         </num>
         <p>
            <t v="The position to be taken by the European Union within the EU-Switzerland Joint Committee on the rules of procedure to be adopted in accordance with Article 19(4) of the Agreement shall be laid down in the attached draft decision of the EU-Switzerland Joint Committee."/>
         </p>
      </unit>
   </body>
