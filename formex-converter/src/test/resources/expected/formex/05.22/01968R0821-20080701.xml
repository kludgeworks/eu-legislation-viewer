   <body>
      <deleted>
         <provenance amendingAct="32008R0508"
                     action="deleted"
                     location="AR:2"
                     marker="O002001M001000"/>
         <unit eId="art_1" kind="article">
            <num>
               <t v="Article 1"/>
            </num>
            <p>
               <t v="For the granting of export refunds pearled grains and hulled grains of cereals shall be those which possess the characteristics listed in the Annex."/>
            </p>
         </unit>
         <unit eId="art_2" kind="article">
            <num>
               <t v="Article 2"/>
            </num>
            <p>
               <t v="This Regulation shall enter into force on 1 July 1968."/>
            </p>
         </unit>
      </deleted>
   </body>
