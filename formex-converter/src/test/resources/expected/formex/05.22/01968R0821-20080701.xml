            <unit eId="pbl_1/cit_1" kind="citation">
               <p>
                  <t v="Having regard to the Treaty establishing the European Economic Community;"/>
               </p>
            </unit>
            <unit eId="pbl_1/cit_2" kind="citation">
               <p>
                  <t v="Having regard to Council Regulation No 120/67/EEC"/>
                  <noteRef href="#note_1" marker="1"/>
                  <t v=". of 13 June 1967 on the common organisation of the market in cereals, and in particular Article 16 (4) thereof:"/>
               </p>
            </unit>
         </deleted>
      </citations>
      <recitals>
         <deleted>
            <provenance amendingAct="32008R0508"
                        action="deleted"
                        location="AR:2"
                        marker="O002001M001000"/>
            <unit eId="pbl_1/rct_1" kind="recital">
               <p>
                  <t v="Whereas the export refund should take into account the quality of the product processed from cereals which qualifies for it lest public funds contribute to the export of goods of inferior quality; whereas it is therefore necessary to establish a precise definition, applicable in each Member State, of cereal grains qualifying for the refund on "/>
                  <quote startQuote="‘" endQuote="’">
                     <t v="hulled grains"/>
                  </quote>
                  <t v=" and "/>
                  <quote startQuote="‘" endQuote="’">
                     <t v="pearled grains"/>
                  </quote>
                  <t v=";"/>
               </p>
            </unit>
            <unit eId="pbl_1/rct_2" kind="recital">
               <p>
                  <t v="Whereas the measures provided for in this Regulation are in accordance with the Opinion of the Management Committee for Cereals;"/>
               </p>
            </unit>
         </deleted>
      </recitals>
