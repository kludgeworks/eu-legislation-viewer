<CONS.ACT xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://formex.publications.europa.eu/schema/formex-04.00-20061031.xd"><INFO.CONSLEG CONSLEG.DATE="20080821" CONSLEG.REF="1998D0481" DATE.LAST.MOD="20080711" END="NONE" END.DATE="99999999" LEG.VAL="DEC" PROD.SEQ="001.001.0" START.DATE="20080708"/><INFO.PROD PROD.DATE="20080821" PROD.SYSTEM="CONSLEG.NEW" PRODUCER="ES"/><CONS.DOC><BIB.INSTANCE><DOCUMENT.REF FILE="CL1998D0481EN0010010.0001.doc.xml"><LG.OJ>EN</LG.OJ><PAGE.FIRST>1</PAGE.FIRST></DOCUMENT.REF><DATE ISO="20080708">20080708</DATE><LG.DOC>EN</LG.DOC><PAGE.FIRST>1</PAGE.FIRST><PAGE.SEQ>1</PAGE.SEQ><PAGE.LAST>2</PAGE.LAST><PAGE.TOTAL>2</PAGE.TOTAL></BIB.INSTANCE><FAM.COMP LEG.VAL="DEC"><BIB.DATA><BIB.INSTANCE.CONS><DOCUMENT.REF.CONS><COLL>L</COLL><NO.OJ>216</NO.OJ><YEAR>1998</YEAR><LG.OJ>EN</LG.OJ><PAGE.FIRST>7</PAGE.FIRST><PAGE.SEQ>1</PAGE.SEQ><VOLUME.REF>01</VOLUME.REF></DOCUMENT.REF.CONS><DATE ISO="19980804">19980804</DATE><LG.DOC>EN</LG.DOC><NO.SEQ>0004</NO.SEQ><PAGE.FIRST>7</PAGE.FIRST><PAGE.SEQ>1</PAGE.SEQ><PAGE.LAST>7</PAGE.LAST><PAGE.TOTAL>1</PAGE.TOTAL><NO.DOC FORMAT="NY" TYPE="OJ"><NO.CURRENT>481</NO.CURRENT><YEAR>1998</YEAR><COM>EC</COM></NO.DOC></BIB.INSTANCE.CONS><NO.CELEX>398D0481</NO.CELEX><DATE ISO="19980720">19980720</DATE><TITLE><TI><P><HT TYPE="UC">Council Decision</HT></P><P>of 20 July 1998</P><P>approving the external auditors of the European Central Bank</P><P>(98/481/EC)</P></TI></TITLE></BIB.DATA><GR.MOD.ACT><MOD.ACT EXISTS="YES" LEG.VAL="DEC" TYPE="MOD"><BIB.DATA><BIB.INSTANCE.CONS><DOCUMENT.REF.CONS><COLL>L</COLL><NO.OJ>183</NO.OJ><YEAR>2008</YEAR><LG.OJ>EN</LG.OJ><PAGE.FIRST>34</PAGE.FIRST><PAGE.SEQ>1</PAGE.SEQ><VOLUME.REF>01</VOLUME.REF></DOCUMENT.REF.CONS><DATE ISO="20080711">20080711</DATE><LG.DOC>EN</LG.DOC><NO.SEQ>0010</NO.SEQ><PAGE.FIRST>34</PAGE.FIRST><PAGE.SEQ>1</PAGE.SEQ><PAGE.LAST>34</PAGE.LAST><PAGE.TOTAL>1</PAGE.TOTAL><NO.DOC FORMAT="YN" TYPE="OJ"><NO.CURRENT>571</NO.CURRENT><YEAR>2008</YEAR><COM>EC</COM></NO.DOC></BIB.INSTANCE.CONS><NO.CELEX>308D0571</NO.CELEX><DATE ISO="20080708">20080708</DATE><TITLE><TI><P><HT TYPE="UC">Council Decision</HT></P><P>of <DATE ISO="20080708">8 July 2008</DATE></P><P>amending Decision 98/481/EC approving the external auditors of the European Central Bank</P><P>(2008/571/EC)</P></TI></TITLE></BIB.DATA></MOD.ACT></GR.MOD.ACT></FAM.COMP><TITLE><TI><P><HT TYPE="UC">Council Decision</HT></P><P>of 20 July 1998</P><P>approving the external auditors of the European Central Bank</P><P>(98/481/EC)</P></TI></TITLE><PREAMBLE><PREAMBLE.INIT>THE COUNCIL OF THE EUROPEAN UNION,</PREAMBLE.INIT><GR.VISA><VISA>Having regard to the Protocol on the Statute of the European System of Central Banks and of the European Central Bank and in particular to Article 27.1 thereof,</VISA><VISA>Having regard to the Recommendation of the Governing Council of the European Central Bank (hereinafter referred to as the <QUOT.START CODE="2018" ID="QS0001" REF.END="QE0001"/>ECB<QUOT.END CODE="2019" ID="QE0001" REF.START="QS0001"/>) of 19 June 1998,</VISA></GR.VISA><GR.CONSID><CONSID><P>Whereas the accounts of the ECB and national central banks are to be audited by independent external auditors recommended by the Governing Council and approved by the Council of the European Union;</P></CONSID><CONSID><P>Whereas the Governing Council of the ECB has recommended Coopers and Lybrand as the external auditors of the ECB,</P></CONSID></GR.CONSID><PREAMBLE.FINAL>HAS DECIDED AS FOLLOWS:</PREAMBLE.FINAL></PREAMBLE><ENACTING.TERMS><?CLG.MDFO ID="O001001M001000" IDREF="C001001M001000" ACTION="REPLACED" LEVEL="STRUCTURE" COMMAND="EXPLICIT" ACTIVE.DOC="308D0571" ACTIVE.LOC="AR:1" MOD.LEVEL="1"?><ARTICLE IDENTIFIER="001"><TI.ART>Article 1</TI.ART><ALINEA>PricewaterhouseCoopers Aktiengesellschaft Wirtschaftsprüfungsgesellschaft is hereby approved as the external auditors of the ECB for the financial years 2008 to 2012.</ALINEA></ARTICLE><?CLG.MDFC ID="C001001M001000" IDREF="O001001M001000"?><ARTICLE IDENTIFIER="002"><TI.ART>Article 2</TI.ART><ALINEA>This Decision shall be notified to the ECB.</ALINEA></ARTICLE><ARTICLE IDENTIFIER="003"><TI.ART>Article 3</TI.ART><ALINEA>This Decision shall be published in the <HT TYPE="ITALIC">Official Journal of the European Communities</HT>.</ALINEA></ARTICLE></ENACTING.TERMS></CONS.DOC></CONS.ACT>