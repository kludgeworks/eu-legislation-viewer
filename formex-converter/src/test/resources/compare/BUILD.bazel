load("@rules_java//java:defs.bzl", "java_library")

package(default_visibility = ["//visibility:public"])

# The conservation checks: Formex and legal text reduced to the same values, the text
# (formex-values, legal-text-values) and the metadata the viewer relies on (*-metadata)
filegroup(
    name = "compare",
    srcs = [
        "formex-metadata.xsl",
        "formex-values.xsl",
        "legal-text-metadata.xsl",
        "legal-text-values.xsl",
    ],
)

# the same, on the classpath at /compare/
java_library(
    name = "resources",
    resources = [":compare"],
)
