<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT -->
<!-- The document: identity, source, lifecycle, long title, preamble, conclusions, notes -->
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec"
    xmlns="https://kludgeworks.groknull.dev/ns/legal-text/1"
    stylesheet="../../main/resources/dev/groknull/kludgeworks/formex/converter/xslt/formex-to-legal-text.xsl">

  <!-- the CELEX number the application passes for an OJ act (a consolidation carries its own) -->
  <x:param name="celex" select="'32026R0449'"/>

  <x:scenario label="A consolidated version">
    <x:context xmlns="">
      <CONS.ACT xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://formex.publications.europa.eu/schema/formex-06.02.1-20231031.xd">
        <INFO.CONSLEG CONSLEG.DATE="20260305" CONSLEG.REF="2015R1998" END="NONE" END.DATE="99999999" PROD.SEQ="023.001.0" START.DATE="20260322"/>
        <INFO.PROD PROD.DATE="20260305"/>
        <CONS.DOC>
          <BIB.INSTANCE><LG.DOC>EN</LG.DOC></BIB.INSTANCE>
          <FAM.COMP LEG.VAL="REG">
            <BIB.DATA><BIB.INSTANCE.CONS><DOCUMENT.REF.CONS><COLL>L</COLL><NO.OJ>299</NO.OJ><YEAR>2015</YEAR><PAGE.FIRST>1</PAGE.FIRST></DOCUMENT.REF.CONS><DATE ISO="20151114">20151114</DATE></BIB.INSTANCE.CONS><NO.CELEX>32015R1998</NO.CELEX></BIB.DATA>
            <GR.MOD.ACT>
              <MOD.ACT TYPE="MOD"><BIB.DATA><NO.CELEX>32015R2426</NO.CELEX><DATE ISO="20151218">20151218</DATE></BIB.DATA></MOD.ACT>
              <MOD.ACT TYPE="MOD"><BIB.DATA><NO.CELEX>32026R0449</NO.CELEX><DATE ISO="20260227">20260227</DATE></BIB.DATA></MOD.ACT>
            </GR.MOD.ACT>
          </FAM.COMP>
          <TITLE><TI><P><HT TYPE="UC">Commission Implementing Regulation</HT> (EU) 2015/1998</P><P>of <DATE ISO="20151105">5 November 2015</DATE></P><P>laying down detailed measures</P><P>(Text with EEA relevance)</P></TI></TITLE>
          <PREAMBLE><PREAMBLE.INIT/><PREAMBLE.FINAL/></PREAMBLE>
          <ENACTING.TERMS><ARTICLE IDENTIFIER="001"><TI.ART>Article 1</TI.ART><ALINEA>text</ALINEA></ARTICLE></ENACTING.TERMS>
          <FINAL><P>This Regulation shall be binding in its entirety.</P></FINAL>
        </CONS.DOC>
      </CONS.ACT>
    </x:context>
    <x:expect label="names the act, the version and its Formex" test="
        $x:result/@act = '32015R1998' and $x:result/@kind = 'consolidated' and $x:result/@version = '2026-03-22'
        and $x:result/@xml:lang = 'en' and $x:result/@formexVersion = '06.02.1' and matches($x:result/@converter, '^\d+\.\d+\.\d+$')"/>
    <x:expect label="points at its schema" test="
        $x:result/@xsi:schemaLocation = 'https://kludgeworks.groknull.dev/ns/legal-text/1 https://kludgeworks.groknull.dev/schema/legal-text/1.0/legal-text.xsd'"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/>
    <x:expect label="has the source and the lifecycle" test="$x:result/(*:source, *:lifecycle)">
      <source celex="02015R1998-20260322"><publication series="L" number="299" date="2015-11-14" page="1"/></source>
      <lifecycle produced="2026-03-05" sequence="023.001.0">
        <eventRef type="amendment" act="32015R2426" date="2015-12-18"/>
        <eventRef type="amendment" act="32026R0449" date="2026-02-27"/>
      </lifecycle>
    </x:expect>
    <x:expect label="splits the long title by position" test="
        $x:result/*:preface/*:longTitle/*:p[1]/*:docType/*:emphasis[@kind = 'uc']/*:t/@v = 'Commission Implementing Regulation'
        and $x:result/*:preface/*:longTitle/*:p[1]/*:docNumber/*:t/@v = '(EU) 2015/1998'
        and $x:result/*:preface/*:longTitle/*:p[2]/*:docDate/@date = '2015-11-05'
        and $x:result/*:preface/*:longTitle/*:p[3]/*:docPurpose/*:t/@v = 'laying down detailed measures'
        and $x:result/*:preface/*:longTitle/*:p[4]/*:t/@v = '(Text with EEA relevance)'"/>
    <x:expect label="leaves out an empty preamble" test="empty($x:result/*:preamble)"/>
    <x:expect label="keeps the closing formula" test="$x:result/*:conclusions/*:p/*:t/@v = 'This Regulation shall be binding in its entirety.'"/>
  </x:scenario>

  <x:scenario label="A consolidated version of an act outside sector 3 (an agreement)">
    <x:context xmlns="">
      <CONS.ACT xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://formex.publications.europa.eu/schema/formex-06.02.1-20231031.xd">
        <INFO.CONSLEG CONSLEG.DATE="20250310" CONSLEG.REF="2002A2430" END="NONE" END.DATE="99999999" PROD.SEQ="001.001.0" START.DATE="20250201"/>
        <INFO.PROD PROD.DATE="20250310"/>
        <CONS.DOC>
          <BIB.INSTANCE><LG.DOC>EN</LG.DOC></BIB.INSTANCE>
          <FAM.COMP LEG.VAL="AGR"><BIB.DATA><NO.CELEX>22002A0430(02)</NO.CELEX></BIB.DATA>
            <GR.CORRIG><CORRIG><BIB.DATA><BIB.INSTANCE.CONS><DOCUMENT.REF.CONS><COLL>L</COLL><NO.OJ>173</NO.OJ></DOCUMENT.REF.CONS><DATE ISO="20030711">20030711</DATE></BIB.INSTANCE.CONS><NO.CELEX>22002A0430(02)R(01)</NO.CELEX></BIB.DATA></CORRIG></GR.CORRIG>
          </FAM.COMP>
          <TITLE><TI><P>Agreement</P></TI></TITLE>
          <ENACTING.TERMS><ARTICLE IDENTIFIER="001"><TI.ART>Article 1</TI.ART><ALINEA>text</ALINEA></ARTICLE></ENACTING.TERMS>
        </CONS.DOC>
      </CONS.ACT>
    </x:context>
    <x:expect label="is a version of its base act, not of 3 and the consolidation's reference"
              test="$x:result/@act = '22002A0430(02)' and $x:result/*:source/@celex = '02002A2430-20250201'"/>
    <x:expect label="dates a corrigendum, which has no date of its own, by its publication"
              test="$x:result/*:lifecycle/*:eventRef[@type = 'corrigendum'][@act = '22002A0430(02)R(01)']/@date = '2003-07-11'"/>
  </x:scenario>

  <x:scenario label="A preamble with two groups of citations">
    <x:context xmlns="">
      <ACT xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://formex.publications.europa.eu/schema/formex-06.02.3-20250123.xd">
        <BIB.INSTANCE><DOCUMENT.REF><COLL>L</COLL><PAGE.FIRST>1</PAGE.FIRST></DOCUMENT.REF><LG.DOC>EN</LG.DOC></BIB.INSTANCE>
        <TITLE><TI><P>Council Decision (EU) 2026/1</P></TI></TITLE>
        <PREAMBLE><PREAMBLE.INIT>THE COUNCIL OF THE EUROPEAN UNION,</PREAMBLE.INIT>
          <GR.VISA><VISA>Having regard to the Treaty,</VISA><VISA>Having regard to the proposal,</VISA></GR.VISA>
          <GR.VISA><VISA>Whereas the Commission has been consulted,</VISA></GR.VISA>
          <PREAMBLE.FINAL>HAS ADOPTED THIS DECISION:</PREAMBLE.FINAL></PREAMBLE>
        <ENACTING.TERMS/>
      </ACT>
    </x:context>
    <x:expect label="numbers the citations through the preamble, not within each group"
              test="$x:result/*:preamble/*:citations/*:unit/@eId => string-join(' ') = 'pbl_1/cit_1 pbl_1/cit_2 pbl_1/cit_3'"/>
  </x:scenario>

  <x:scenario label="Unnumbered CONSIDs among numbered recitals">
    <x:context xmlns="">
      <ACT xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://formex.publications.europa.eu/schema/formex-06.02.3-20250123.xd">
        <BIB.INSTANCE><DOCUMENT.REF><COLL>L</COLL><PAGE.FIRST>1</PAGE.FIRST></DOCUMENT.REF><LG.DOC>EN</LG.DOC></BIB.INSTANCE>
        <TITLE><TI><P>Commission Regulation (EU) 2026/2</P></TI></TITLE>
        <PREAMBLE><PREAMBLE.INIT>THE EUROPEAN COMMISSION,</PREAMBLE.INIT>
          <GR.CONSID>
            <CONSID><P>Whereas:</P></CONSID>
            <CONSID><NP><NO.P>(1)</NO.P><TXT>The investigation found dumping.</TXT></NP></CONSID>
            <CONSID><P>All interested parties were informed.</P></CONSID>
            <CONSID><NP><NO.P>(2)</NO.P><TXT>Measures should be imposed.</TXT></NP></CONSID>
          </GR.CONSID>
          <PREAMBLE.FINAL>HAS ADOPTED THIS REGULATION:</PREAMBLE.FINAL></PREAMBLE>
        <ENACTING.TERMS/>
      </ACT>
    </x:context>
    <x:expect label="are no recitals of their own: rct_1 and rct_2, not a third by position"
              test="$x:result//*:recitals/*:unit/@eId => string-join(' ') = 'pbl_1/rct_1 pbl_1/rct_2'"/>
    <x:expect label="one before the first numbered recital opens them"
              test="$x:result//*:recitals/*:intro//*:t/@v = 'Whereas:'"/>
    <x:expect label="one after a numbered recital continues it"
              test="$x:result//*:recitals/*:unit[1]//*:t/@v = 'All interested parties were informed.'"/>
  </x:scenario>

  <x:scenario label="A paragraph number the published text gives twice (2. and 2), printed differently)">
    <x:context xmlns="">
      <CONS.ACT xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://formex.publications.europa.eu/schema/formex-06.02.1-20231031.xd">
        <INFO.CONSLEG CONSLEG.REF="2015R0001" START.DATE="20260101" END.DATE="99999999"/>
        <CONS.DOC><BIB.INSTANCE><LG.DOC>EN</LG.DOC></BIB.INSTANCE>
          <ENACTING.TERMS><ARTICLE IDENTIFIER="001"><TI.ART>Article 1</TI.ART>
            <PARAG IDENTIFIER="001.001"><NO.PARAG>1.</NO.PARAG><ALINEA>first</ALINEA></PARAG>
            <PARAG IDENTIFIER="001.002"><NO.PARAG>2.</NO.PARAG><ALINEA>second:<LIST TYPE="alpha"><ITEM><NP><NO.P>(a)</NO.P><TXT>x</TXT></NP></ITEM></LIST></ALINEA></PARAG>
            <PARAG IDENTIFIER="001.003"><NO.PARAG>2)</NO.PARAG><ALINEA>another second:<LIST TYPE="alpha"><ITEM><NP><NO.P>(a)</NO.P><TXT>y</TXT></NP></ITEM></LIST></ALINEA></PARAG>
          </ARTICLE></ENACTING.TERMS>
        </CONS.DOC>
      </CONS.ACT>
    </x:context>
    <x:expect label="keeps the label as published: both are art_1/par_2, marked ambiguous"
              test="count($x:result//*:unit[@eId = 'art_1/par_2'][@ambiguous = 'true']) = 2"/>
    <x:expect label="and so are the points under them"
              test="count($x:result//*:unit[@eId = 'art_1/par_2/pnt_a'][@ambiguous = 'true']) = 2"/>
    <x:expect label="the paragraph numbered once isn't" test="empty($x:result//*:unit[@eId = 'art_1/par_1']/@ambiguous)"/>
  </x:scenario>

  <x:scenario label="A recital holding headed sections">
    <x:context xmlns="">
      <ACT xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://formex.publications.europa.eu/schema/formex-06.02.3-20250123.xd">
        <BIB.INSTANCE><DOCUMENT.REF><COLL>L</COLL><PAGE.FIRST>1</PAGE.FIRST></DOCUMENT.REF><LG.DOC>EN</LG.DOC></BIB.INSTANCE>
        <TITLE><TI><P>Commission Decision (EU) 2026/3</P></TI></TITLE>
        <PREAMBLE><PREAMBLE.INIT>THE EUROPEAN COMMISSION,</PREAMBLE.INIT>
          <GR.CONSID>
            <CONSID><NP><NO.P>(1)</NO.P><TXT>The measure covers:</TXT></NP>
              <GR.SEQ LEVEL="1"><TITLE><TI><P>Scope</P></TI></TITLE><P>a</P></GR.SEQ>
              <GR.SEQ LEVEL="1"><TITLE><TI><P>Budget</P></TI></TITLE><P>b</P></GR.SEQ></CONSID>
          </GR.CONSID>
          <PREAMBLE.FINAL>HAS ADOPTED THIS DECISION:</PREAMBLE.FINAL></PREAMBLE>
        <ENACTING.TERMS/>
      </ACT>
    </x:context>
    <x:expect label="numbers them within the recital: rct_1/level_1, rct_1/level_2"
              test="$x:result//*:recitals//*:unit[@kind = 'level']/@eId => string-join(' ') = 'pbl_1/rct_1/level_1 pbl_1/rct_1/level_2'"/>
  </x:scenario>

  <x:scenario label="Recitals in groups, with unnumbered CONSIDs and a number printed twice">
    <x:context xmlns="">
      <ACT xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://formex.publications.europa.eu/schema/formex-06.02.3-20250123.xd">
        <BIB.INSTANCE><DOCUMENT.REF><COLL>L</COLL><PAGE.FIRST>1</PAGE.FIRST></DOCUMENT.REF><LG.DOC>EN</LG.DOC></BIB.INSTANCE>
        <TITLE><TI><P>Commission Implementing Regulation (EU) 2026/4</P></TI></TITLE>
        <PREAMBLE><PREAMBLE.INIT>THE EUROPEAN COMMISSION,</PREAMBLE.INIT>
          <GR.CONSID>
            <CONSID><P>Whereas:</P></CONSID>
            <DIV.CONSID><TITLE><TI><NP><NO.P>A.</NO.P><TXT>PROCEDURE</TXT></NP></TI></TITLE><CONSID><NP><NO.P>(1)</NO.P><TXT>One.</TXT></NP></CONSID></DIV.CONSID>
            <DIV.CONSID><TITLE><TI><NP><NO.P>B.</NO.P><TXT>SAMPLING</TXT></NP></TI></TITLE><CONSID><P>No sampling was needed.</P></CONSID></DIV.CONSID>
            <DIV.CONSID><TITLE><TI><NP><NO.P>C.</NO.P><TXT>DUMPING</TXT></NP></TI></TITLE><CONSID><NP><NO.P>(2)</NO.P><TXT>Two.</TXT></NP></CONSID></DIV.CONSID>
            <DIV.CONSID><TITLE><TI><NP><NO.P>D.</NO.P><TXT>INJURY</TXT></NP></TI></TITLE><CONSID><NP><NO.P>(2)</NO.P><TXT>Two again.</TXT></NP></CONSID></DIV.CONSID>
          </GR.CONSID>
          <PREAMBLE.FINAL>HAS ADOPTED THIS REGULATION:</PREAMBLE.FINAL></PREAMBLE>
        <ENACTING.TERMS/>
      </ACT>
    </x:context>
    <x:expect label="the unnumbered ones are no recitals: only (1) and the two (2)"
              test="$x:result//*:unit[@kind = 'recital']/@eId => string-join(' ') = 'pbl_1/rct_1 pbl_1/rct_2 pbl_1/rct_2'"/>
    <x:expect label="Whereas: opens the recitals" test="$x:result//*:recitals/*:intro//*:t/@v = 'Whereas:'"/>
    <x:expect label="the lone one in group B is the group's text"
              test="$x:result//*:unit[@eId = 'pbl_1/division_B']/*:p//*:t/@v = 'No sampling was needed.'"/>
    <x:expect label="(2) in two groups is the source repeating a preamble-wide number: both marked"
              test="count($x:result//*:unit[@eId = 'pbl_1/rct_2'][@ambiguous = 'true']) = 2"/>
  </x:scenario>

  <x:scenario label="An article printed without a number">
    <x:context xmlns="">
      <CONS.ACT xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://formex.publications.europa.eu/schema/formex-06.02.1-20231031.xd">
        <INFO.CONSLEG CONSLEG.REF="2015R0001" START.DATE="20260101" END.DATE="99999999"/>
        <CONS.DOC><BIB.INSTANCE><LG.DOC>EN</LG.DOC></BIB.INSTANCE>
          <ENACTING.TERMS>
            <ARTICLE IDENTIFIER="001"><TI.ART>Article 1</TI.ART><ALINEA>a</ALINEA></ARTICLE>
            <ARTICLE IDENTIFIER="002"><TI.ART>.</TI.ART><ALINEA>b</ALINEA></ARTICLE>
            <ARTICLE IDENTIFIER="003"><TI.ART>Article 2</TI.ART><ALINEA>c</ALINEA></ARTICLE>
          </ENACTING.TERMS>
        </CONS.DOC>
      </CONS.ACT>
    </x:context>
    <x:expect label="is art_unnumbered-1, not art_2 by position, which Article 2 prints"
              test="$x:result//*:unit[@kind = 'article']/@eId => string-join(' ') = 'art_1 art_unnumbered-1 art_2'"/>
  </x:scenario>

  <x:scenario label="An act printed in two languages (Article 2, Artículo 2)">
    <x:context xmlns="">
      <CONS.ACT xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://formex.publications.europa.eu/schema/formex-06.02.1-20231031.xd">
        <INFO.CONSLEG CONSLEG.REF="2015R0001" START.DATE="20260101" END.DATE="99999999"/>
        <CONS.DOC><BIB.INSTANCE><LG.DOC>EN</LG.DOC></BIB.INSTANCE>
          <ENACTING.TERMS>
            <ARTICLE IDENTIFIER="001"><TI.ART>Article 2</TI.ART><ALINEA>a</ALINEA></ARTICLE>
            <ARTICLE IDENTIFIER="002"><TI.ART>Artículo 2</TI.ART><ALINEA>b</ALINEA></ARTICLE>
          </ENACTING.TERMS>
        </CONS.DOC>
      </CONS.ACT>
    </x:context>
    <x:expect label="gives the article's two versions one eId, marked ambiguous"
              test="count($x:result//*:unit[@eId = 'art_2'][@ambiguous = 'true']) = 2"/>
  </x:scenario>

  <x:scenario label="An OJ act's preamble and signature">
    <x:context xmlns="">
      <ACT xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://formex.publications.europa.eu/schema/formex-06.02.3-20250123.xd">
        <BIB.INSTANCE><DOCUMENT.REF><COLL>L</COLL><PAGE.FIRST>1</PAGE.FIRST></DOCUMENT.REF><LG.DOC>EN</LG.DOC></BIB.INSTANCE>
        <TITLE><TI><P><HT TYPE="UC">Commission Implementing Regulation</HT> (EU) 2026/449</P></TI></TITLE>
        <PREAMBLE><PREAMBLE.INIT>THE EUROPEAN COMMISSION,</PREAMBLE.INIT>
          <GR.VISA><VISA>Having regard to the Treaty on the Functioning of the European Union,</VISA><VISA>Having regard to Regulation (EC) No 300/2008,</VISA></GR.VISA>
          <GR.CONSID><GR.CONSID.INIT>Whereas:</GR.CONSID.INIT><CONSID><NP><NO.P>(1)</NO.P><TXT>Experience gained</TXT></NP></CONSID></GR.CONSID>
          <PREAMBLE.FINAL>HAS ADOPTED THIS REGULATION:</PREAMBLE.FINAL></PREAMBLE>
        <ENACTING.TERMS/>
        <FINAL><P>This Regulation shall be binding.</P>
          <SIGNATURE><PL.DATE><P>Done at Brussels, <DATE ISO="20260227">27 February 2026</DATE>.</P></PL.DATE>
            <SIGNATORY><P><HT TYPE="ITALIC">For the Commission</HT></P><P><HT TYPE="ITALIC">The President</HT></P><P>Ursula <HT TYPE="UC">von der Leyen</HT></P></SIGNATORY></SIGNATURE></FINAL>
      </ACT>
    </x:context>
    <x:expect label="is an original text with the CELEX it was given" test="$x:result/@act = '32026R0449' and $x:result/@kind = 'original' and empty($x:result/@version)"/>
    <x:expect label="has the formulas around citations and recitals"
              test="$x:result/*:preamble/*/local-name() = ('formula', 'citations', 'recitals', 'formula') and $x:result/*:preamble/*:formula/@name = ('actingEntity', 'enactingFormula')"/>
    <x:expect label="numbers citations by position and recitals by label"
              test="$x:result/*:preamble/*:citations/*:unit/@eId = ('pbl_1/cit_1', 'pbl_1/cit_2') and $x:result/*:preamble/*:recitals/*:unit/@eId = 'pbl_1/rct_1'"/>
    <x:expect label="keeps the recitals' intro" test="$x:result/*:preamble/*:recitals/*:intro/*:p/*:t/@v = 'Whereas:'"/>
    <x:expect label="types the date of the signature, keeping the place as text" test="$x:result//*:placeAndDate">
      <placeAndDate><t v="Done at Brussels, "/><date date="2026-02-27" asWritten="27 February 2026"/><t v="."/></placeAndDate>
    </x:expect>
    <x:expect label="splits the signatory by line: organisation, role, person" test="
        $x:result//*:signatory/*:organization/*:emphasis/*:t/@v = 'For the Commission'
        and $x:result//*:signatory/*:role/*:emphasis/*:t/@v = 'The President'
        and $x:result//*:signatory/*:person/*:emphasis[@kind = 'uc']/*:t/@v = 'von der Leyen'"/>
  </x:scenario>


  <x:scenario label="An OJ act's package (Formex 06.x): the ELI its descriptor gives">
    <x:context href="../resources/fixtures/formex/06.02.3/32026R0449/L_202600449EN.doc.fmx.xml"/>
    <x:expect label="takes the URI from NO.ELI/@ID, not the text with its ELI: prefix"
              test="$x:result/*:source/@eli = 'http://data.europa.eu/eli/reg_impl/2026/449/oj'"/>
  </x:scenario>

  <x:scenario label="Footnotes">
    <x:context xmlns="">
      <CONS.ACT xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://formex.publications.europa.eu/schema/formex-06.02.1-20231031.xd">
        <INFO.CONSLEG CONSLEG.REF="2015R1998" START.DATE="20260322" END.DATE="99999999"/>
        <CONS.DOC><BIB.INSTANCE><LG.DOC>EN</LG.DOC></BIB.INSTANCE>
          <ENACTING.TERMS><ARTICLE IDENTIFIER="001"><TI.ART>Article 1</TI.ART><ALINEA>Decision 2015/444<NOTE NOTE.ID="E0001" NUMBERING="ARAB" TYPE="FOOTNOTE"><P>Commission Decision (EU, Euratom) 2015/444 (<REF.DOC.OJ COLL="L" DATE.PUB="20150317" NO.OJ="072" PAGE.FIRST="53">OJ L 72, 17.3.2015, p. 53</REF.DOC.OJ>).</P></NOTE> applies.</ALINEA></ARTICLE></ENACTING.TERMS>
        </CONS.DOC>
      </CONS.ACT>
    </x:context>
    <x:expect label="are collected at the end, with the reference left in the text" test="
        $x:result//*:body//*:noteRef/@href = '#note_1'
        and $x:result/*:notes/*:note/@eId = 'note_1'
        and $x:result/*:notes/*:note/@marker = '1'
        and $x:result/*:notes/*:note/@kind = 'footnote'
        and $x:result/*:notes/*:note/*:p/*:ref/@number = '72'"/>
  </x:scenario>

  <x:scenario label="A long title whose number line has emphasis and a subtitle">
    <x:context xmlns="">
      <ACT><BIB.INSTANCE><DOCUMENT.REF><COLL>L</COLL></DOCUMENT.REF><LG.DOC>EN</LG.DOC></BIB.INSTANCE>
        <TITLE><TI><P><HT TYPE="UC">Decision</HT> (EU) 2019/1798 <HT TYPE="ITALIC">of the European Parliament</HT></P><P>of <DATE ISO="20191023">23 October 2019</DATE> <NOTE NOTE.ID="E0001"><P>a note</P></NOTE></P></TI><STI><P>on products excluded from the scope</P></STI></TITLE>
        <ENACTING.TERMS/></ACT>
    </x:context>
    <x:expect label="keeps the emphasis in the number line" test="$x:result/*:preface/*:longTitle/*:p[1]/*:docNumber/*:emphasis[@kind = 'i']/*:t/@v = 'of the European Parliament'"/>
    <x:expect label="keeps a note on the date line" test="exists($x:result/*:preface/*:longTitle/*:p[2]/*:noteRef)"/>
    <x:expect label="keeps the subtitle" test="$x:result/*:preface/*:longTitle/*:p[3]/*:t/@v = 'on products excluded from the scope'"/>
  </x:scenario>

</x:description>
