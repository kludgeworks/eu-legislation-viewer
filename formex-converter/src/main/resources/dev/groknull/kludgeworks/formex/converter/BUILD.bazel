load("@contrib_rules_jvm//java:defs.bzl", "java_library")
load("//tools/build:defs.bzl", "project_version")

package(default_visibility = ["//formex-converter:__subpackages__"])

# The converter's classpath resources, at /dev/groknull/kludgeworks/formex/converter/: the path the
# viewer's adapter loads them by, and the tests' package

exports_files([
    "schema/legal-text.sch",
    "schema/legal-text.xsd",
    "schema/xml.xsd",
])

# The single project version. Release builds pass the validated CalVer tag with
# --embed_label; unlabelled builds retain the fixture-compatible fallback from
# project_version.
project_version(name = "version")

# formex-to-legal-text.xsl, the modules it includes and the vocabularies they read: Formex → legal-text
filegroup(
    name = "xslt",
    srcs = glob([
        "xslt/*.xsl",
        "xslt/*.rdf",
    ]),
)

# the stylesheets and the project version: the stylesheet reads ../version.txt
# and stamps it on every document (legalText/@converter)
java_library(
    name = "stylesheets",
    resources = [
        ":version",
        ":xslt",
    ],
)

# legal-text.xsd, the schema of the xml: namespace it imports (xml.xsd, W3C's), the rules it can't
# express (legal-text.sch) and the catalog that resolves their URLs (catalog.xml)
java_library(
    name = "schema",
    resources = glob(["schema/*"]),
)
