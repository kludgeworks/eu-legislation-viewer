load("@rules_java//java:defs.bzl", "java_library")

# The converter's Java API: Formex 4 → legal-text XML with formex-to-legal-text.xsl
java_library(
    name = "converter",
    srcs = glob(["*.java"]),
    visibility = ["//visibility:public"],
    runtime_deps = ["//formex-converter/src/main/resources/dev/groknull/kludgeworks/formex/converter:stylesheets"],
    deps = [
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_jspecify_jspecify",
    ],
)
