// SPDX-License-Identifier: MIT
// Fast file-level checks on changed files (pre-commit) and on everything (`hk check --all`, CI).
// Checks that need the real schema are Bazel tests; javac's (Error Prone, NullAway, doclint) are the
// compile's, so the build fails on them: before a push (pre-push), and in CI's mise run test.
amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Builtins.pkl"

// Cellar's responses as it serves them (Formex, recorded replies, the EU subdivision table): byte-identical,
// excluded from every fixer
local raw =
  List(
    "formex-converter/src/test/resources/fixtures/**",
    "viewer/src/test/resources/acts/**",
    "viewer/src/test/resources/cellar/**",
    "**/xslt/subdivision.rdf",
  )
// vendored W3C schemas, under the W3C licence; patches, whose context lines must match exactly; the
// licence texts, as SPDX publishes them
local vendored =
  List(
    "formex-converter/src/test/resources/mathml3/**",
    "formex-converter/src/main/resources/dev/groknull/kludgeworks/formex/converter/schema/xml.xsd",
    "**/*.patch",
    "LICENSES/**",
  )
// written by tools, never edited by hand: the Maven lock file (bazel run @maven//:pin), the
// converter's expected output (mise run expected), the pipx tools' dependency locks (mise lock)
local generated =
  List(
    "maven_install.json",
    "formex-converter/src/test/resources/expected/**/*.xml",
    ".mise/locks/**",
  )
// the legal text's templates: their files end without a newline, which jte would write into running
// text (Rendering and UI)
local legalTemplates = List("viewer/src/main/jte/legal/**", "viewer/src/main/jte/legalpart/**")
local migrations = List("viewer/src/main/resources/db/migration/**")
local xml = List("**/*.xml", "**/*.xsl", "**/*.xsd", "**/*.xspec", "**/*.sch")

local linters = new Mapping<String, Step> {
  // not the task scripts: it would space jbang's lines (///usr/bin/env jbang, //JAVA 25), which jbang
  // reads only as written
  ["google_java_format"] = (Builtins.google_java_format) {
    batch = true
    exclude = List("tools/tasks/**")
  }
  ["addlicense"] = new Step {
    required = List("LICENSE_HOLDER", "LICENSE_TYPE")
    glob =
      List(
        "**/*.java",
        "**/*.bzl",
        "**/BUILD.bazel",
        "**/*.BUILD",
        "MODULE.bazel",
        "**/*.toml",
        "**/*.sh",
        "**/*.py",
      )
    exclude = raw + vendored + generated
    batch = true
    check = "addlicense -s=only -c \"$LICENSE_HOLDER\" -l \"$LICENSE_TYPE\" -check {{files}}"
    fix = "addlicense -s=only -c \"$LICENSE_HOLDER\" -l \"$LICENSE_TYPE\" {{files}}"
  }
  // every file's copyright and licence, from its header or REUSE.toml (the REUSE specification);
  // also what addlicense skips without a word: the XML family, Pkl, SPARQL, the dotfiles
  ["reuse"] = new Step { check = "reuse lint --quiet" }
  // well-formedness only: XML is never reformatted, whitespace is significant in legal text. The JDK's
  // parser (tools/tasks/lint/xml.java), not xmllint, which mise can't install
  ["xml"] = new Step {
    glob = xml
    exclude = raw
    batch = true
    check = "mise run lint:xml {{files}}"
    diagnostic_format = "gcc"
  }
  ["buildifier_format"] = Builtins.buildifier_format
  ["buildifier_lint"] = Builtins.buildifier_lint
  ["taplo_format"] = Builtins.taplo_format
  ["pkl_format"] = Builtins.pkl_format
  ["ruff"] = Builtins.ruff
  ["ruff_format"] = Builtins.ruff_format
  ["shellcheck"] = Builtins.shellcheck
  // the page scripts (.oxlintrc.json). tsc checks their types and Vitest tests them, under Bazel.
  ["ox_lint"] = (Builtins.ox_lint) { exclude = raw + vendored + generated }
  ["shfmt"] = (Builtins.shfmt) { batch = true }
  // the pending migrations a change touches named NEXT_<NNN>__<description>.sql, their modules
  // numbered whole; not in the release's commit (the release profile), which names them released
  ["flyway_migrations"] = new Step {
    profiles = List("!release")
    glob = migrations
    check = "mise run release:db-migrations {{files}}"
    fix = "tools/tasks/release/db-migrations.bash --fix {{files}}"
    // a rename's new name, which is none of the files hk handed it
    stage = migrations
  }
  // in the release's commit (mise run release), every migration named as released, each version once
  ["flyway_migrations_released"] = new Step {
    profiles = List("release")
    glob = migrations
    check = "tools/tasks/release/db-migrations.bash --final"
  }
  ["kubeconform"] = (Builtins.kubeconform) {
    check {
      command {
        argv =
          super.argv.filter((a) -> a != "{{files}}" && a != "-ignore-missing-schemas")
            + List(
              "-schema-location",
              "default",
              "-schema-location",
              "{% raw %}https://raw.githubusercontent.com/datreeio/CRDs-catalog/c86448cbf1a840ca62d119259864863897c8748a/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json{% endraw %}",
              "{{files}}",
            )
      }
    }
  }
  ["kube_linter"] = Builtins.kube_linter
  ["mise_tasks"] = new Step {
    glob = List("mise.toml", "tools/tasks.toml")
    check = "mise run lint:mise-tasks"
  }
  ["usage"] = new Step {
    glob = List("**/*.usage.kdl")
    check = "usage lint -W {{files}}"
  }
  ["jactionlint"] = Builtins.jactionlint
  ["pinact"] = Builtins.pinact
  ["pinact_update"] = Builtins.pinact_update
  ["typos"] = (Builtins.typos) { exclude = raw + vendored + generated }
  ["trailing_whitespace"] = (Builtins.trailing_whitespace) { exclude = raw + vendored + generated }
  ["newlines"] = (Builtins.newlines) { exclude = raw + vendored + generated + legalTemplates }
  ["mixed_line_ending"] = (Builtins.mixed_line_ending) { exclude = raw + vendored + generated }
  ["check_merge_conflict"] = Builtins.check_merge_conflict
  ["check_case_conflict"] = Builtins.check_case_conflict
  ["check_added_large_files"] = (Builtins.check_added_large_files) { exclude = raw + generated }
  ["detect_private_key"] = Builtins.detect_private_key
  ["gitleaks"] = Builtins.gitleaks
  ["semgrep"] = new Step {
    // .jte, .css, .js and .sql for the project's own text rules (semgrep/rules.yaml)
    glob = List("**/*.java", "**/*.py", "**/*.jte", "**/*.css", "**/*.js", "**/*.sql")
    exclude = raw + vendored + generated
    batch = true
    check =
      "semgrep scan --config semgrep/ --config p/java --config p/owasp-top-ten --config p/security-audit --config p/secrets --config p/python --metrics=off --error {{files}}"
  }
}

// before a commit, secrets in what it adds: not the working tree's, which has the git-ignored corpus
// (tens of GB of EU texts, whose words trip gitleaks' generic rules)
local staged = (linters) { ["gitleaks"] = (Builtins.gitleaks) { scan = "staged" } }

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps { ...staged }
  }
  // javac's checks, before the commits leave: Bazel builds what changed since its last build
  ["pre-push"] {
    steps { ["build"] = new Step { check = "bazel build //..." } }
  }
  ["commit-msg"] {
    steps { ["conventional"] = Builtins.check_conventional_commit }
  }
  ["check"] { steps { ...linters } }
  ["fix"] {
    fix = true
    steps { ...linters }
  }
}
