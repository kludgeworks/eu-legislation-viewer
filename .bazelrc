# SPDX-License-Identifier: MIT
common --java_language_version=25 --tool_java_language_version=25
common --java_runtime_version=remotejdk_25 --tool_java_runtime_version=remotejdk_25
test --test_output=errors
# Two hours for an eternal test (size enormous), not one: only the corpus test is, whose shards
# share the cores, a shard with the corpus's longest manifestation (43 minutes) beside its share
test --test_timeout=-1,-1,-1,7200

# NullAway on every Java target: the @NullMarked packages are checked against their JSpecify
# annotations, and @Nullable is honoured where unmarked code has it.
# AssertJ's isNotNull() counts as a null check in tests, and JUnit's parameterized classes
# initialise their fields (@Parameter, @BeforeParameterizedClassInvocation).
build --extra_toolchains=//tools/build:java_toolchain_definition
build --plugin=//tools/build:nullaway
# Picnic's checks (error-prone-contrib) as well, configured for our packages in tools/build/BUILD.bazel.
build --plugin=//tools/build:picnic
# Error Prone checks our own sources only: not third-party code Bazel compiles from source
# (external/), nor generated code, which Bazel compiles from its own output (_javac/)
build --javacopt=-XepExcludedPaths:(.*/)?(external|_javac)/.*
build --javacopt=-Xep:NullAway:ERROR
build --javacopt=-XepOpt:NullAway:OnlyNullMarked=true
build --javacopt=-XepOpt:NullAway:JSpecifyMode=true
build --javacopt=-XepOpt:NullAway:AcknowledgeRestrictiveAnnotations=true
build --javacopt=-XepOpt:NullAway:TreatGeneratedAsUnannotated=true
build --javacopt=-XepOpt:NullAway:HandleTestAssertionLibraries=true
build --javacopt=-XepOpt:NullAway:ExcludedFieldAnnotations=org.junit.jupiter.params.Parameter
build --javacopt=-XepOpt:NullAway:CustomInitializerAnnotations=org.junit.jupiter.params.BeforeParameterizedClassInvocation
