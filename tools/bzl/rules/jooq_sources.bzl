"""Rule for generating jOOQ source JARs from Flyway migrations."""

def _jooq_sources_impl(ctx):
    out = ctx.actions.declare_file(ctx.label.name + ".srcjar")
    migrations = ctx.attr.migrations[DefaultInfo].files
    files = migrations.to_list()
    if not files:
        fail("migrations must contain at least one SQL file")
    args = ctx.actions.args()
    args.add(ctx.file.config)
    directory = files[0].dirname
    for file in files:
        if file.dirname != directory:
            fail("migrations must all be in one directory: %s is not in %s" % (file.path, directory))
    args.add(directory)
    args.add(ctx.attr.package)
    args.add(out)
    ctx.actions.run(
        executable = ctx.executable._tool,
        arguments = [args],
        inputs = depset(direct = [ctx.file.config], transitive = [migrations]),
        outputs = [out],
        tools = [ctx.executable._tool],
        mnemonic = "JooqCodegen",
        progress_message = "Generating jOOQ sources for %{label}",
        # zonky's Postgres listens on localhost
        execution_requirements = {"requires-network": "1"},
    )
    return [DefaultInfo(files = depset([out]))]

jooq_sources = rule(
    implementation = _jooq_sources_impl,
    doc = """A source JAR generated by jOOQ from one module's Flyway migrations, run on embedded Postgres.""",
    attrs = {
        "migrations": attr.label(mandatory = True),
        "package": attr.string(mandatory = True),
        "config": attr.label(mandatory = True, allow_single_file = True),
        "_tool": attr.label(
            default = "//tools/build/src/main/java/dev/groknull/kludgeworks/build:jooq_codegen",
            executable = True,
            cfg = "exec",
        ),
    },
)
