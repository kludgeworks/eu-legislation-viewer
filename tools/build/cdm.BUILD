# SPDX-License-Identifier: MIT
# CDM (Publications Office, CC BY 4.0): the ontology whose terms Cellar's RDF uses. cdm.rdf declares
# the cdm: and cmr: terms, cdm_annotationproperties.rdf the annotation: ones; the rest of the zip is
# cdmplus and the W3C vocabularies CDM imports.
exports_files(
    [
        "cdm.rdf",
        "cdm_annotationproperties.rdf",
    ],
    visibility = ["//visibility:public"],
)
