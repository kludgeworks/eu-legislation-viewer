# SPDX-License-Identifier: MIT
load("@rules_java//java:defs.bzl", "java_binary", "java_import", "java_library", "java_plugin")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "xslt-quality.conf.xml",
])

java_library(
    name = "xspec_runner",
    testonly = True,
    srcs = ["src/dev/groknull/kludgeworks/build/XSpecTests.java"],
    runtime_deps = ["@maven//:io_xspec_xspec"],
    deps = [
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# MapStruct's annotation processor: a library with it in plugins gets its mappers generated
java_plugin(
    name = "mapstruct",
    processor_class = "org.mapstruct.ap.MappingProcessor",
    deps = ["@maven//:org_mapstruct_mapstruct_processor"],
)

# NullAway, an Error Prone check, for every Java target (see .bazelrc): it checks the @NullMarked
# packages, so generated and third-party code is left alone
java_plugin(
    name = "nullaway",
    deps = ["@maven//:com_uber_nullaway_nullaway"],
)

# a Schematron schema compiled with SchXslt 2, and its findings
java_library(
    name = "schematron",
    srcs = ["src/dev/groknull/kludgeworks/build/Schematron.java"],
    runtime_deps = ["@maven//:name_dmaus_schxslt_schxslt2"],
    deps = ["@maven//:net_sf_saxon_Saxon_HE"],
)

# xslt-quality's validator, built once: the way its pom builds it, then transpiled with SchXslt 2,
# with the rules xslt-quality.conf.xml rejects switched off. A jar, so it is on the test classpath.
java_binary(
    name = "xslt_quality_build",
    srcs = ["src/dev/groknull/kludgeworks/build/XsltQualityBuild.java"],
    main_class = "dev.groknull.kludgeworks.build.XsltQualityBuild",
    deps = [
        ":schematron",
        "@maven//:net_sf_saxon_Saxon_HE",
    ],
)

genrule(
    name = "xslt_quality_validator",
    srcs = [
        "xslt-quality.conf.xml",
        "@xslt_quality//:sources",
        "@xslt_quality//:src/main/sch/xslt-quality.sch",
    ],
    outs = ["xslt-quality-validator.jar"],
    cmd = " && ".join([
        "zipper=$$PWD/$(execpath @bazel_tools//tools/zip:zipper)",
        "jar=$$PWD/$@",
        # the repository root, from its main schema: src/main/sch/xslt-quality.sch
        "sources=$$(dirname $(execpath @xslt_quality//:src/main/sch/xslt-quality.sch))/../../..",
        "out=$$(mktemp -d)",
        "$(execpath :xslt_quality_build) $$out/xslt-quality $$sources $(execpath xslt-quality.conf.xml)",
        "cd $$out",
        "$$zipper c $$jar $$(find xslt-quality -type f | LC_ALL=C sort)",
        "rm -rf $$out",
    ]),
    tools = [
        ":xslt_quality_build",
        "@bazel_tools//tools/zip:zipper",
    ],
)

java_import(
    name = "xslt_quality_validator_jar",
    jars = [":xslt_quality_validator"],
)

java_library(
    name = "xslt_quality_runner",
    testonly = True,
    srcs = [
        "src/dev/groknull/kludgeworks/build/XsltQuality.java",
        "src/dev/groknull/kludgeworks/build/XsltQualityTests.java",
    ],
    runtime_deps = [":xslt_quality_validator_jar"],
    deps = [
        ":schematron",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# JAXB's code generator, through its own entry point, for xjc_library, with our plugin (-Xjspecify)
java_binary(
    name = "xjc",
    main_class = "com.sun.tools.xjc.XJCFacade",
    runtime_deps = [
        ":xjc_plugins",
        "@maven//:org_glassfish_jaxb_jaxb_runtime",
        "@maven//:org_glassfish_jaxb_jaxb_xjc",
    ],
)

# -Xjspecify: the schema's optionality as JSpecify annotations on the generated getters
java_library(
    name = "xjc_plugins",
    srcs = ["src/dev/groknull/kludgeworks/build/JSpecifyPlugin.java"],
    resource_strip_prefix = "tools/build/src",
    resources = ["src/META-INF/services/com.sun.tools.xjc.Plugin"],
    deps = [
        "@maven//:org_glassfish_jaxb_codemodel",
        "@maven//:org_glassfish_jaxb_jaxb_xjc",
    ],
)
