# SPDX-License-Identifier: MIT
load("@rules_java//java:defs.bzl", "java_binary", "java_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "xslt-quality.conf.xml",
])

java_library(
    name = "xspec_runner",
    testonly = True,
    srcs = ["src/dev/groknull/kludgeworks/build/XSpecTests.java"],
    runtime_deps = ["@maven//:io_xspec_xspec"],
    deps = [
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# a Schematron schema compiled with SchXslt 2, and its findings
java_library(
    name = "schematron",
    testonly = True,
    srcs = ["src/dev/groknull/kludgeworks/build/Schematron.java"],
    runtime_deps = ["@maven//:name_dmaus_schxslt_schxslt2"],
    deps = ["@maven//:net_sf_saxon_Saxon_HE"],
)

java_library(
    name = "xslt_quality_runner",
    testonly = True,
    srcs = [
        "src/dev/groknull/kludgeworks/build/XsltQuality.java",
        "src/dev/groknull/kludgeworks/build/XsltQualityTests.java",
    ],
    deps = [
        ":schematron",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# JAXB's code generator, through its own entry point, for xjc_library
java_binary(
    name = "xjc",
    main_class = "com.sun.tools.xjc.XJCFacade",
    runtime_deps = [
        "@maven//:org_glassfish_jaxb_jaxb_runtime",
        "@maven//:org_glassfish_jaxb_jaxb_xjc",
    ],
)
