load("@rules_java//java:defs.bzl", "java_import", "java_plugin")

package(default_visibility = ["//visibility:public"])

# Build tooling: the macros and rules in defs.bzl, the compiler plugins, and xslt-quality's
# validator. The Java tools are in src/main/java, laid out as Maven lays out a Java project.

exports_files([
    "defs.bzl",
    "xslt-quality.conf.xml",
])

# MapStruct's annotation processor: a library with it in plugins gets its mappers generated
java_plugin(
    name = "mapstruct",
    processor_class = "org.mapstruct.ap.MappingProcessor",
    deps = ["@maven//:org_mapstruct_mapstruct_processor"],
)

# NullAway, an Error Prone check, for every Java target (see .bazelrc): it checks the @NullMarked
# packages, so generated and third-party code is left alone
java_plugin(
    name = "nullaway",
    deps = ["@maven//:com_uber_nullaway_nullaway"],
)

# xslt-quality's validator, built once: the way its pom builds it, then transpiled with SchXslt 2,
# with the rules xslt-quality.conf.xml rejects switched off. A jar, so it is on the test classpath.
genrule(
    name = "xslt_quality_validator",
    srcs = [
        "xslt-quality.conf.xml",
        "@xslt_quality//:sources",
        "@xslt_quality//:src/main/sch/xslt-quality.sch",
    ],
    outs = ["xslt-quality-validator.jar"],
    cmd = " && ".join([
        "zipper=$$PWD/$(execpath @bazel_tools//tools/zip:zipper)",
        "jar=$$PWD/$@",
        # the repository root, from its main schema: src/main/sch/xslt-quality.sch
        "sources=$$(dirname $(execpath @xslt_quality//:src/main/sch/xslt-quality.sch))/../../..",
        "out=$$(mktemp -d)",
        "$(execpath //tools/build/src/main/java/dev/groknull/kludgeworks/build:xslt_quality_build) $$out/xslt-quality $$sources $(execpath xslt-quality.conf.xml)",
        "cd $$out",
        "$$zipper c $$jar $$(find xslt-quality -type f | LC_ALL=C sort)",
        "rm -rf $$out",
    ]),
    tools = [
        "//tools/build/src/main/java/dev/groknull/kludgeworks/build:xslt_quality_build",
        "@bazel_tools//tools/zip:zipper",
    ],
)

java_import(
    name = "xslt_quality_validator_jar",
    jars = [":xslt_quality_validator"],
)
