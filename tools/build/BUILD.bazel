load("@contrib_rules_jvm//java:defs.bzl", "pmd_binary", "pmd_ruleset", "spotbugs_binary", "spotbugs_config")
load("@rules_java//java:defs.bzl", "java_import", "java_library", "java_package_configuration", "java_plugin")
load("@rules_java//toolchains:default_java_toolchain.bzl", "DEFAULT_TOOLCHAIN_CONFIGURATION", "default_java_toolchain")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# Build tooling: the macros and rules in defs.bzl, the compiler plugins, and xslt-quality's
# validator. The Java tools are in src/main/java, laid out as Maven lays out a Java project.

exports_files([
    "defs.bzl",
    "pmd.xml",
    "spotbugs-exclude.xml",
    "xslt-quality.conf.xml",
])

# PMD and CPD (ISS-82)
pmd_binary(
    name = "pmd_cli",
    runtime_deps = [
        "@pmd_maven//:net_sf_saxon_Saxon_HE",
        "@pmd_maven//:net_sourceforge_pmd_pmd_dist",
    ],
)

pmd_ruleset(
    name = "pmd_ruleset",
    format = "text",
    pmd_binary = ":pmd_cli",
    rulesets = [":pmd.xml"],
    shallow = False,
)

# CPD (Copy-Paste Detector) test (ISS-82)
sh_test(
    name = "cpd",
    srcs = ["cpd.sh"],
    args = ["$(rootpath :pmd_cli)"],
    data = [":pmd_cli"],
    tags = [
        "local",
        "no-sandbox",
    ],
)

# SpotBugs with FindSecBugs and sb-contrib plugins (ISS-82)
spotbugs_binary(
    name = "spotbugs_cli",
    runtime_deps = [
        "@maven//:com_github_spotbugs_spotbugs",
        "@maven//:org_slf4j_slf4j_jdk14",
    ],
)

spotbugs_config(
    name = "spotbugs_config",
    effort = "default",
    exclude_filter = "spotbugs-exclude.xml",
    fail_on_warning = True,
    plugin_list = [
        "@maven//:com_h3xstream_findsecbugs_findsecbugs_plugin",
        "@maven//:com_mebigfatguy_sb_contrib_sb_contrib",
    ],
    spotbugs_binary = ":spotbugs_cli",
)

# NullAway, an Error Prone check, for every Java target (see .bazelrc): it checks the @NullMarked
# packages, so generated and third-party code is left alone
java_plugin(
    name = "nullaway",
    deps = ["@maven//:com_uber_nullaway_nullaway"],
)

# Picnic's Error Prone checks (error-prone-contrib), for every Java target (see .bazelrc), as NullAway
java_plugin(
    name = "picnic",
    deps = ["@maven//:tech_picnic_error_prone_support_error_prone_contrib"],
)

# RecordBuilder: builders and withers for the records annotated @RecordBuilder, generated as they
# are compiled. A target that uses it depends on this, for the annotations and the processor.
java_library(
    name = "record_builder",
    exported_plugins = [":record_builder_processor"],
    exports = ["@maven//:io_soabase_record_builder_record_builder_core"],
)

java_plugin(
    name = "record_builder_processor",
    generates_api = True,
    processor_class = "io.soabase.recordbuilder.processor.RecordBuilderProcessor",
    deps = ["@maven//:io_soabase_record_builder_record_builder_processor"],
)

# Picnic's checks that hold in our code, errors there: SLF4J's placeholders and loggers, idioms
# (DirectReturn, OptionalOrElseGet …), AssertJ and JUnit, and Spring MVC's and Jackson's, which
# hold trivially until the first controller. Not StaticImport: its list is the reverse of ours
# (classes named, as StandardCharsets.UTF_8, but for the test DSLs); NonStaticImport is ours. Not
# JUnitClassModifiers (final test classes), nor the lexicographical orders: a sealed interface's
# permits and annotations follow the domain.
PICNIC_CHECKS = [
    "AmbiguousJsonCreator",
    "AssertJNullnessAssertion",
    "AssertJOptionalAssertion",
    "AutowiredConstructor",
    "CanonicalAnnotationSyntax",
    "CanonicalClassNameUsage",
    "ClassCastLambdaUsage",
    "CollectorMutability",
    "ConstantNaming",
    "DirectReturn",
    "EagerStringFormatting",
    "EmptyMethod",
    "EmptyMonoZip",
    "ExplicitArgumentEnumeration",
    "ExplicitEnumOrdering",
    "FluxFlatMapUsage",
    "FluxImplicitBlock",
    "FormatStringConcatenation",
    "IdentityConversion",
    "ImmutablesSortedSetComparator",
    "IsInstanceLambdaUsage",
    "JUnitMethodDeclaration",
    "JUnitNullaryParameterizedTestDeclaration",
    "JUnitValueSource",
    "MockitoMockClassReference",
    "MockitoStubbing",
    "MongoDBTextFilterUsage",
    "NestedOptionals",
    "NestedPublishers",
    "NonEmptyMono",
    "NonStaticImport",
    "OptionalOrElseGet",
    "PrimitiveComparison",
    "RedundantStringConversion",
    "RedundantStringEscape",
    "RequestMappingAnnotation",
    "RequestParamType",
    "Slf4jLoggerDeclaration",
    "Slf4jLogStatement",
    "SpringMvcAnnotation",
    "StringJoining",
    "TimeZoneUsage",
]

PICNIC_OFF = [
    "JUnitClassModifiers",
    "LexicographicalAnnotationAttributeListing",
    "LexicographicalAnnotationListing",
    "LexicographicalPermitsListing",
    "StaticImport",
]

# The Java toolchain (see .bazelrc): rules_java's default for Java 25, stricter on our own packages.
# Third-party code (rules_java's runfiles among it) is left alone: doclint can't resolve its links,
# and its warnings aren't ours to fix.
default_java_toolchain(
    name = "java_toolchain",
    configuration = DEFAULT_TOOLCHAIN_CONFIGURATION,
    package_configuration = [":strict"],
    source_version = "25",
    target_version = "25",
)

# Our packages, stricter than Error Prone's defaults as Bazel runs them, its errors alone: Picnic's
# checks above, and three of Error Prone's own, are errors too. RequireExplicitNullMarking: no class slips past NullAway unmarked;
# ReturnMissingNullable (off in rules_java's defaults): a return of null says @Nullable;
# SameNameButDifferent: one simple name means one type in a file. A javac warning
# fails the build (-Werror; Error Prone's warnings don't count). javac's doclint: a Javadoc {@link}
# that doesn't resolve, a @param for no parameter, malformed HTML, down to private members; not
# "missing": a comment on every member would be noise.
java_package_configuration(
    name = "strict",
    javacopts = [
        "-Werror",
        "-Xep:RequireExplicitNullMarking:ERROR",
        "-Xep:ReturnMissingNullable:ERROR",
        "-Xep:SameNameButDifferent:ERROR",
        "-Xdoclint:all/private,-missing",
    ] + ["-Xep:%s:ERROR" % check for check in PICNIC_CHECKS] + ["-Xep:%s:OFF" % check for check in PICNIC_OFF],
    packages = [":ours"],
)

package_group(
    name = "ours",
    packages = [
        "//formex-converter/...",
        "//tools/...",
        "//viewer/...",
    ],
)

# xslt-quality's validator, built once: the way its pom builds it, then transpiled with SchXslt 2,
# with the rules xslt-quality.conf.xml rejects switched off. A jar, so it is on the test classpath.
genrule(
    name = "xslt_quality_validator",
    srcs = [
        "xslt-quality.conf.xml",
        "@xslt_quality//:sources",
        "@xslt_quality//:src/main/sch/xslt-quality.sch",
    ],
    outs = ["xslt-quality-validator.jar"],
    cmd = " && ".join([
        "zipper=$$PWD/$(execpath @bazel_tools//tools/zip:zipper)",
        "jar=$$PWD/$@",
        # the repository root, from its main schema: src/main/sch/xslt-quality.sch
        "sources=$$(dirname $(execpath @xslt_quality//:src/main/sch/xslt-quality.sch))/../../..",
        "out=$$(mktemp -d)",
        "$(execpath //tools/build/src/main/java/dev/groknull/kludgeworks/build:xslt_quality_build) $$out/xslt-quality $$sources $(execpath xslt-quality.conf.xml)",
        "cd $$out",
        "$$zipper c $$jar $$(find xslt-quality -type f | LC_ALL=C sort)",
        "rm -rf $$out",
    ]),
    tools = [
        "//tools/build/src/main/java/dev/groknull/kludgeworks/build:xslt_quality_build",
        "@bazel_tools//tools/zip:zipper",
    ],
)

java_import(
    name = "xslt_quality_validator_jar",
    jars = [":xslt_quality_validator"],
)
