# SPDX-License-Identifier: MIT
# xslt-quality (github.com/mricaud/xslt-quality, Apache-2.0): its Schematron, its XSLT library and
# the build stylesheets its pom runs. XsltQualityTests builds the validator from them.
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob([
        "src/main/sch/**",
        "src/main/xsl/**",
        "src/build/**",
    ]),
)
