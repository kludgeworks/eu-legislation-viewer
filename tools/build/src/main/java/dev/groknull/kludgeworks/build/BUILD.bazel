# SPDX-License-Identifier: MIT
load("@rules_java//java:defs.bzl", "java_binary", "java_library")

package(default_visibility = ["//visibility:public"])

# XSpec suites as JUnit 5 tests (the macro xspec_test)
java_library(
    name = "xspec_runner",
    testonly = True,
    srcs = ["XSpecTests.java"],
    runtime_deps = ["@maven//:io_xspec_xspec"],
    deps = [
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# Records' Javadoc from an XML Schema's documentation (the macro schema_javadoc): the tool that
# writes it, and the check
java_library(
    name = "schema_javadoc",
    srcs = [
        "SchemaJavadoc.java",
        "UpdateSchemaJavadoc.java",
    ],
    deps = [
        "@maven//:com_github_javaparser_javaparser_core",
        "@maven//:net_sf_saxon_Saxon_HE",
    ],
)

java_library(
    name = "schema_javadoc_runner",
    testonly = True,
    srcs = ["SchemaJavadocTests.java"],
    deps = [
        ":schema_javadoc",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# a Schematron schema compiled with SchXslt 2, and its findings
java_library(
    name = "schematron",
    srcs = ["Schematron.java"],
    runtime_deps = ["@maven//:name_dmaus_schxslt_schxslt2"],
    deps = ["@maven//:net_sf_saxon_Saxon_HE"],
)

# xslt-quality's validator, built the way its pom builds it (//tools/build:xslt_quality_validator)
java_binary(
    name = "xslt_quality_build",
    srcs = ["XsltQualityBuild.java"],
    main_class = "dev.groknull.kludgeworks.build.XsltQualityBuild",
    deps = [
        ":schematron",
        "@maven//:net_sf_saxon_Saxon_HE",
    ],
)

# stylesheets checked with xslt-quality (the macro xslt_quality_test)
java_library(
    name = "xslt_quality_runner",
    testonly = True,
    srcs = [
        "XsltQuality.java",
        "XsltQualityTests.java",
    ],
    runtime_deps = ["//tools/build:xslt_quality_validator_jar"],
    deps = [
        ":schematron",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# Spring Boot's executable jar from Bazel's jars (the rule spring_boot_jar)
java_binary(
    name = "spring_boot_jar",
    srcs = ["SpringBootJar.java"],
    main_class = "dev.groknull.kludgeworks.build.SpringBootJar",
    deps = ["@maven//:org_springframework_boot_spring_boot_loader_tools"],
)

# JAXB's code generator, through its own entry point, for xjc_library, with our plugin (-Xjspecify)
java_binary(
    name = "xjc",
    main_class = "com.sun.tools.xjc.XJCFacade",
    runtime_deps = [
        ":xjc_plugins",
        "@maven//:org_glassfish_jaxb_jaxb_runtime",
        "@maven//:org_glassfish_jaxb_jaxb_xjc",
    ],
)

# -Xjspecify: the schema's optionality as JSpecify annotations on the generated getters
java_library(
    name = "xjc_plugins",
    srcs = ["JSpecifyPlugin.java"],
    resources = ["//tools/build/src/main/resources:META-INF/services/com.sun.tools.xjc.Plugin"],
    deps = [
        "@maven//:org_glassfish_jaxb_codemodel",
        "@maven//:org_glassfish_jaxb_jaxb_xjc",
    ],
)
