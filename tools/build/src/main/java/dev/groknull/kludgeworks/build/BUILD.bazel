# SPDX-License-Identifier: MIT
load("@contrib_rules_jvm//java:defs.bzl", "java_binary", "java_library")

package(default_visibility = ["//visibility:public"])

# The package's @NullMarked (package-info), for NullAway: each target here depends on it
java_library(
    name = "package_info",
    srcs = ["package-info.java"],
    exports = ["@maven//:org_jspecify_jspecify"],
    deps = ["@maven//:org_jspecify_jspecify"],
)

# XSpec suites as JUnit 5 tests (the macro xspec_test)
java_library(
    name = "xspec_runner",
    testonly = True,
    srcs = ["XSpecTests.java"],
    runtime_deps = ["@maven//:io_xspec_xspec"],
    deps = [
        ":package_info",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# a Schematron schema compiled with SchXslt 2, and its findings
java_library(
    name = "schematron",
    srcs = ["Schematron.java"],
    runtime_deps = ["@maven//:name_dmaus_schxslt_schxslt2"],
    deps = [
        ":package_info",
        "@maven//:net_sf_saxon_Saxon_HE",
    ],
)

# xslt-quality's validator, built the way its pom builds it (//tools/build:xslt_quality_validator)
java_binary(
    name = "xslt_quality_build",
    srcs = ["XsltQualityBuild.java"],
    main_class = "dev.groknull.kludgeworks.build.XsltQualityBuild",
    deps = [
        ":package_info",
        ":schematron",
        "@maven//:net_sf_saxon_Saxon_HE",
    ],
)

# stylesheets checked with xslt-quality (the macro xslt_quality_test)
java_library(
    name = "xslt_quality_runner",
    testonly = True,
    srcs = [
        "XsltQuality.java",
        "XsltQualityTests.java",
    ],
    runtime_deps = ["//tools/build:xslt_quality_validator_jar"],
    deps = [
        ":package_info",
        ":schematron",
        "@maven//:net_sf_saxon_Saxon_HE",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# SPARQL queries' terms checked against the ontologies (the macro sparql_terms_test)
java_library(
    name = "sparql_terms",
    srcs = ["SparqlTerms.java"],
    deps = [":package_info"],
)

java_library(
    name = "sparql_terms_runner",
    testonly = True,
    srcs = ["SparqlTermsTests.java"],
    deps = [
        ":package_info",
        ":sparql_terms",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)

# Spring Boot's executable jar from Bazel's jars (the rule spring_boot_jar)
java_binary(
    name = "spring_boot_jar",
    srcs = ["SpringBootJar.java"],
    main_class = "dev.groknull.kludgeworks.build.SpringBootJar",
    deps = [
        ":package_info",
        "@maven//:org_springframework_boot_spring_boot_loader_tools",
    ],
)

# jOOQ's code generator on a module's migrations, run on Postgres in a container (the macro
# jooq_tables); needs Docker
java_binary(
    name = "jooq_codegen",
    srcs = ["JooqCodegen.java"],
    main_class = "dev.groknull.kludgeworks.build.JooqCodegen",
    runtime_deps = [
        "@maven//:org_flywaydb_flyway_database_postgresql",
        "@maven//:org_postgresql_postgresql",
        "@maven//:org_slf4j_slf4j_simple",  # Testcontainers' log, in the action's output on failure
    ],
    deps = [
        ":package_info",
        "//tools/build/src/main/java/dev/groknull/kludgeworks/build/flyway",
        "@maven//:org_flywaydb_flyway_core",
        "@maven//:org_jooq_jooq_codegen",
        "@maven//:org_jooq_jooq_meta",
        "@maven//:org_testcontainers_testcontainers",
        "@maven//:org_testcontainers_testcontainers_postgresql",
    ],
)

# jte templates as Java sources, with jte-models' typed facade (the macro jte_library)
java_binary(
    name = "jte_generate",
    srcs = ["JteGenerate.java"],
    main_class = "dev.groknull.kludgeworks.build.JteGenerate",
    runtime_deps = ["@maven//:gg_jte_jte_models"],
    deps = [
        ":package_info",
        "@maven//:gg_jte_jte",
        "@maven//:gg_jte_jte_runtime",
    ],
)
