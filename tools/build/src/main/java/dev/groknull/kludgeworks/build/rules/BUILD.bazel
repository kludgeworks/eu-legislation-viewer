load("@contrib_rules_jvm//java:defs.bzl", "java_binary", "java_library")

# The business rules on the wiki: the plugin that saves a run of a rules suite as Cucumber's
# messages, and the writer of the wiki's pages from the runs
java_library(
    name = "rules",
    srcs = glob(["*.java"]),
    visibility = [
        "//tools/build:__subpackages__",
        "//viewer:__subpackages__",
    ],
    runtime_deps = ["@maven//:tools_jackson_core_jackson_databind"],
    deps = [
        "@maven//:io_cucumber_cucumber_core",
        "@maven//:io_cucumber_cucumber_plugin",
        "@maven//:io_cucumber_gherkin",
        "@maven//:io_cucumber_messages",
        "@maven//:io_cucumber_messages_ndjson",
        "@maven//:io_github_java_diff_utils_java_diff_utils",
        "@maven//:org_jspecify_jspecify",
    ],
)

# The rules' wiki pages, written from the runs of the rules suites, and compared with the features
# of the last release
java_binary(
    name = "wiki",
    main_class = "dev.groknull.kludgeworks.build.rules.RulesWiki",
    runtime_deps = [":rules"],
)
