load("@bazel_lib//lib:bats.bzl", "bats_test")

# The task scripts' tests: each runs its script in a throwaway git repository in its own
# BATS_TEST_TMPDIR, with the tools the script calls (bazel, pack) replaced by stubs, so the only
# tools they need from the machine are the ones in /usr/bin on Linux and macOS: git, awk, find,
# grep, sed, perl, shasum, install. Here, not beside the scripts: mise takes any executable file
# below tools/tasks for a task.

bats_test(
    name = "release",
    size = "small",
    srcs = ["release.bats"],
    data = [
        "test_helper.bash",
        "//tools/lib:ui.bash",
        "//tools/tasks:release.bash",
    ],
)

bats_test(
    name = "release_db_migrations",
