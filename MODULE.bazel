# SPDX-License-Identifier: MIT
module(
    name = "kludgeworks_viewer",
    version = "0.0.0",
)

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "contrib_rules_jvm", version = "0.34.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "apple_rules_lint", version = "0.4.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

# JavaScript: the viewer's scripts. Vitest tests them in happy-dom, and tsc checks their JSDoc
# types. The npm packages come from package.json and pnpm-lock.yaml at the root.
bazel_dep(name = "rules_nodejs", version = "6.7.7")
bazel_dep(name = "aspect_rules_js", version = "3.6.0")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.22.1")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

# bats_test: the task scripts' tests (tools/test/tasks), with its own bats; already in the graph
# through rules_jvm_external and contrib_rules_jvm
bazel_dep(name = "bazel_lib", version = "3.7.0")

# A C toolchain for Linux, as Bazel brings its own JDK: nothing here is C, but every java_test needs
# one to analyse (the Windows launcher maker), so a Linux machine with no compiler would fail. macOS
# keeps Xcode's.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

zig = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.31",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.31",
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        # XSLT and its tests
        "net.sf.saxon:Saxon-HE:13.1",
        "io.xspec:xspec:4.1.2",
        # Schematron (legal-text.sch) with the XSLT 3.0 binding
        "name.dmaus.schxslt:schxslt2:1.11.2",
        # NullAway: JSpecify nullness checked at compile time, as an Error Prone plugin
        "com.uber.nullaway:nullaway:0.14.3",
        # Picnic's Error Prone checks, as a plugin: built on Error Prone 2.50.0, the one in rules_java's
        # JavaBuilder, so the two are upgraded together
        "tech.picnic.error-prone-support:error-prone-contrib:0.30.0",
        # Spring: versions from the Spring Boot and Spring Modulith BOMs below
        "org.springframework:spring-core",
        "org.springframework:spring-context",
        "org.springframework:spring-web",
        "org.springframework:spring-webmvc",
        "org.springframework.boot:spring-boot",
        "org.springframework.boot:spring-boot-autoconfigure",
        # the app: Spring MVC on Tomcat, and Actuator
        "org.springframework.boot:spring-boot-starter-webmvc",
        "org.springframework.boot:spring-boot-starter-actuator",
        # RestClient.Builder, configured by Boot (spring.http.clients.*)
        "org.springframework.boot:spring-boot-starter-restclient",
        # Jakarta Bean Validation (Hibernate Validator), for @Validated configuration properties
        "org.springframework.boot:spring-boot-starter-validation",
        "jakarta.validation:jakarta.validation-api",
        # the store: Postgres, its schema by Flyway, queried with jOOQ (its classes generated from the
        # migrations: jooq_tables), and Spring Modulith's event publication registry in it
        "org.springframework.boot:spring-boot-starter-jooq",
        "org.jooq:jooq",
        "org.jooq:jooq-codegen",
        "org.jooq:jooq-meta",
        "org.flywaydb:flyway-core",
        "org.springframework.boot:spring-boot-starter-flyway",
        "org.flywaydb:flyway-database-postgresql",
        "org.postgresql:postgresql",
        # jOOQ's temporary Postgres: native binaries, so code generation does not need Docker
        "io.zonky.test:embedded-postgres:2.2.2",
        "io.zonky.test.postgres:embedded-postgres-binaries-darwin-amd64",
        "io.zonky.test.postgres:embedded-postgres-binaries-darwin-arm64v8",
        "io.zonky.test.postgres:embedded-postgres-binaries-linux-amd64",
        "io.zonky.test.postgres:embedded-postgres-binaries-linux-arm64v8",
        "org.springframework.modulith:spring-modulith-starter-jdbc",
        # Valkey (Spring Data Redis, Lettuce): the externalized events every instance reads back (the
        # broadcast module's streams)
        "org.springframework.boot:spring-boot-starter-data-redis",
        # observability: OpenTelemetry (traces, metrics, logs over OTLP), a span per module entry and the
        # modules' actuator (Modulith's insight starter), JDBC spans (datasource-micrometer)
        "org.springframework.boot:spring-boot-starter-opentelemetry",
        "org.springframework.modulith:spring-modulith-starter-insight",
        "net.ttddyy.observation:datasource-micrometer-spring-boot:2.3.0",  # not in the BOMs
        # the app as Spring Boot's executable jar, by the Repackager its Maven and Gradle plugins use
        "org.springframework.boot:spring-boot-loader-tools:4.1.1",  # not in the BOM: keep it at Boot's version
        "org.springframework.modulith:spring-modulith-api",
        "tools.jackson.core:jackson-databind",
        # jMolecules: the DDD building blocks and the sliced onion's rings, as annotations, and their ArchUnit
        # rules (tests); versions from the jMolecules BOM below
        "org.jmolecules:jmolecules-ddd",
        "org.jmolecules:jmolecules-onion-architecture",
        "org.jmolecules:jmolecules-events",
        "org.jmolecules.integrations:jmolecules-archunit",
        # identifiers from path variables, and single-value types as plain JSON values
        "org.jmolecules.integrations:jmolecules-spring",
        "org.jmolecules.integrations:jmolecules-jackson3",
        "org.jspecify:jspecify",
        # pages: jte templates, precompiled by jte_library (with jte-models' typed facade), and htmx from
        # its webjar, served by Boot at /webjars/htmx.org/… (version-agnostic: webjars-locator-lite)
        "gg.jte:jte:3.2.5",
        "gg.jte:jte-models:3.2.5",
        "gg.jte:jte-jspecify-nullmarked:3.2.5",
        "gg.jte:jte-spring-boot-starter-4:3.2.5",
        "org.webjars.npm:htmx.org:4.0.1",
        # htmx's requests in Spring MVC: @HxRequest handlers for fragments, Vary: HX-Request on their
        # responses (not on the full page's: that one sets it itself)
        "io.github.wimdeblauwe:htmx-spring-boot:6.0.1",
        "org.webjars:webjars-locator-lite",
        # comparisons: Myers's diff of the words of two versions' wording (the comparison module)
        "io.github.java-diff-utils:java-diff-utils:4.18",
        # builders and withers for records, generated (an annotation processor: //:tools_build_record_builder)
        "io.soabase.record-builder:record-builder-core:53",
        "io.soabase.record-builder:record-builder-processor:53",
        # tests
        "org.junit.jupiter:junit-jupiter-api",
        "org.junit.jupiter:junit-jupiter-params",
        "org.junit.jupiter:junit-jupiter-engine",
        "org.junit.platform:junit-platform-launcher",
        "org.junit.platform:junit-platform-reporting",
        "org.assertj:assertj-core",
        "org.xmlunit:xmlunit-assertj3:2.14.0",
        "org.jsoup:jsoup:1.23.2",  # the rendered pages' text, as a browser reads it
        "org.springframework:spring-test",
        "org.springframework.boot:spring-boot-test",
        "org.springframework.boot:spring-boot-test-autoconfigure",
        # the pages' controllers alone (@WebMvcTest, MockMvc), what they ask of the modules mocked
        "org.springframework.boot:spring-boot-webmvc-test",
        "org.mockito:mockito-core",
        "org.hamcrest:hamcrest",
        # waiting on work done in the background (the ingest workers)
        "org.awaitility:awaitility",
        "org.springframework.modulith:spring-modulith-core",
        # the modules' documentation, from the same model the boundaries are verified on (mise run modules)
        "org.springframework.modulith:spring-modulith-docs",
        # the app's containers, for the tests and for running the app locally (TestViewerApplication):
        # Postgres, and Grafana's OpenTelemetry stack (LGTM) to see the traces locally
        "org.springframework.boot:spring-boot-testcontainers",
        "org.testcontainers:testcontainers",
        "org.testcontainers:testcontainers-postgresql",
        "org.testcontainers:testcontainers-grafana",
        # the build's own log (jooq_codegen)
        "org.slf4j:slf4j-simple",
        # SpotBugs, plugins and logging (ISS-82)
        "com.github.spotbugs:spotbugs:4.10.5",
        "com.h3xstream.findsecbugs:findsecbugs-plugin:1.14.0",
        "com.mebigfatguy.sb-contrib:sb-contrib:7.7.4",
        "org.slf4j:slf4j-jdk14:2.0.17",
    ],
    boms = [
        "org.springframework.boot:spring-boot-dependencies:4.1.1",
        "org.springframework.modulith:spring-modulith-bom:2.1.1",
        "org.jmolecules:jmolecules-bom:2025.0.2",
        # Keep embedded Postgres's native binaries aligned with the Postgres 18 used in production.
        "io.zonky.test.postgres:embedded-postgres-binaries-bom:18.3.0",
    ],
    known_contributing_modules = ["protobuf"],
    # the resolved versions and their SHA-256s; after changing the artifacts: mise run pin
    lock_file = "//:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
)

# the Servlet API, to compile against only: at run time it is Tomcat's own
maven.artifact(
    artifact = "jakarta.servlet-api",
    group = "jakarta.servlet",
    neverlink = True,
)

# PMD tooling isolated to its required Saxon 12 engine (ISS-82)
maven.install(
    name = "pmd_maven",
    artifacts = [
        "net.sourceforge.pmd:pmd-dist:7.28.0",
        "net.sf.saxon:Saxon-HE:12.10",
        "org.slf4j:slf4j-jdk14:2.0.17",
    ],
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven", "pmd_maven")

# Linting via apple_rules_lint (ISS-82)
linter = use_extension("@apple_rules_lint//lint:extensions.bzl", "linter")
linter.configure(
    name = "java-spotbugs",
    config = "//tools/build:spotbugs_config",
)
linter.configure(
    name = "java-pmd",
    config = "//tools/build:pmd_ruleset",
)
use_repo(linter, "apple_linters")

# xslt-quality: Schematron rules for XSLT (github.com/mricaud/xslt-quality, Apache-2.0). It has no
# releases; this is master as of 2024-11-13. The patch makes its schema work with SchXslt 2.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "xslt_quality",
    build_file = "//tools/build:xslt-quality.BUILD",
    patch_args = ["-p1"],
    patches = ["//tools/build:xslt-quality.patch"],
    sha256 = "9b42ba86c3c034468bbce2f9f5fbd9c2ec5b5fb1b32a10b575bd1722b2d2f03b",
    strip_prefix = "xslt-quality-9faf4484318c6e02b5a88a27b121b731c7fc3aaf",
    urls = ["https://github.com/mricaud/xslt-quality/archive/9faf4484318c6e02b5a88a27b121b731c7fc3aaf.tar.gz"],
)

# CDM, the ontology behind Cellar's RDF (Publications Office, CC BY 4.0): what every cdm:, cmr: and
# annotation: term our SPARQL queries use means, and the list sparql_terms_test checks them against.
# 4.17.0 is the latest published release; Cellar's endpoint already runs 5.0.0, which isn't
# published yet (it adds terms and removes none): move up when it is. One zip, from the EU
# Vocabularies download over HTTPS.
http_archive(
    name = "cdm",
    build_file = "//tools/build:cdm.BUILD",
    sha256 = "95b001c2cba352a1a1c9c3be3423e187f97ae9773133413040c138f2c285cb8b",
    type = "zip",
    urls = [
        "https://op.europa.eu/o/opportal-service/euvoc-download-handler?cellarURI=http%3A%2F%2Fpublications.europa.eu%2Fresource%2Fdistribution%2Fcdm%2F20260625-0%2Fzip%2Fzip%2Fcdm-4.17.0.zip&fileName=cdm-4.17.0.zip",
    ],
)
