load("@npm//:defs.bzl", "npm_link_all_packages")

# tbls's configuration, for the schema's lint (//viewer/src/test/db:schema)
exports_files([".tbls.yml"])

# The npm packages of package.json, as //:node_modules/<package>, for the viewer's JavaScript tests
npm_link_all_packages(name = "node_modules")

# The corpus regression test by a short name: bazel test //:corpus (see mise run corpus:test)
test_suite(
    name = "corpus",
    tags = ["manual"],  # not part of //...
    tests = ["//formex-converter/src/test/java/dev/groknull/kludgeworks/formex/converter:corpus"],
)
