/bazel-*

# IDEs (.bazelbsp/: the IntelliJ Bazel plugin's generated aspects)
.idea/
.bazelbsp/
*.iml
.vscode/

# coding agents' local configuration
/.claude/
/.codex/
/.opencode/
/AGENTS.md
/CLAUDE.md

# local tool configuration and output (dist/: release:artifact's JAR; formex-corpus/: corpus:fetch's
# mirror of Cellar; text-compare/: text:compare's references and reports; ui-snapshots/:
# ui:snapshots's pages; viewer/spring-modulith-docs/: mise run modules)
/dist/
formex-corpus/
text-compare/
ui-snapshots/
viewer/spring-modulith-docs/
# the database's documentation and diagrams, written by mise run db:diagram
docs/database/
mise.local.toml
.playwright-mcp/
.DS_Store

# pnpm's packages, if someone runs pnpm install outside Bazel
/node_modules/
