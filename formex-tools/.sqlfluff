[sqlfluff]
dialect = duckdb
templater = jinja
exclude_rules = LT09

[sqlfluff:templater:jinja]
# Provide default context for linting
[sqlfluff:templater:jinja:context]
versions = ['formex-06.02.3-20250123.xd']
root_elements = ['GENERAL']
with_version = false
limit = null
uri = 'http://publications.europa.eu/resource/cellar/example.0001.01/DOC_1'

[sqlfluff:rules:capitalisation.keywords]
# Capitalization style for keywords (formerly L010)
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
# Unquoted identifiers (formerly L014)
extended_capitalisation_policy = lower

[sqlfluff:rules:layout.select_targets]
# Disable LT09 - it has issues with Jinja templates
wildcard_policy = single
