<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec"
               xmlns:fmx="http://formex.publications.europa.eu/schema/formex"
               stylesheet="../xslt/annex/v05.53.xsl">
    
    <x:doc>
        XSpec tests for Formex ANNEX transformation: v05.53
        
        These tests verify that the transformation correctly:
        1. Updates schema references
        2. Preserves ANNEX structure
        3. Applies version-specific changes
        4. Maintains data integrity
    </x:doc>
    
    <!-- Test 1: Basic ANNEX transformation with schema update -->
    <x:scenario label="Transform simple ANNEX with schema update">
        <x:doc>
            Tests that the ANNEX element gets its schema reference updated
            while preserving all content and structure.
        </x:doc>
        
        <x:context>
            <fmx:ANNEX xmlns:fmx="http://formex.publications.europa.eu/schema/formex"
                                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                                xsi:schemaLocation="http://formex.publications.europa.eu/schema/formex formex-old.xd"/>
        </x:context>
        
        <x:expect label="Schema location should be updated">
            <fmx:ANNEX xmlns:fmx="http://formex.publications.europa.eu/schema/formex"
                                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                                xsi:schemaLocation="http://formex.publications.europa.eu/schema/formex formex-v05.53.xd"/>
        </x:expect>
    </x:scenario>
    
    <!-- Test 2: Empty ANNEX element -->
    <x:scenario label="Transform empty ANNEX element">
        <x:doc>
            Tests that empty ANNEX elements are handled correctly,
            ensuring the transformation does not break on minimal content.
        </x:doc>
        
        <x:context>
            <fmx:ANNEX xmlns:fmx="http://formex.publications.europa.eu/schema/formex"/>
        </x:context>
        
        <x:expect label="Empty ANNEX should be preserved">
            <fmx:ANNEX xmlns:fmx="http://formex.publications.europa.eu/schema/formex"/>
        </x:expect>
    </x:scenario>

</x:description>