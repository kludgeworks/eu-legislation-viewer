<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- File appender with size-based rolling policy -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-logs}/formex-ingester.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH:-logs}/formex-ingester.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId}-%X{spanId}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Console appender (conditionally attached based on profile) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] [%X{traceId}-%X{spanId}] %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        Profile-based appender configuration:
        
        When formex.features.cli-progress=true (default):
        - FILE only - console owned by terminal progress bars
        - Activated via cli-progress profile (set by CliProgressProfileActivator)
        
        When formex.features.cli-progress=false:
        - FILE + CONSOLE - no progress bars, standard console logging
        - Activated when cli-progress profile is NOT active
    -->
    <springProfile name="cli-progress">
        <root level="INFO">
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>
    
    <springProfile name="!cli-progress">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- Application loggers -->
    <logger name="eu.legislation.formex.ingester" level="DEBUG"/>
    
    <!-- Spring Batch loggers -->
    <logger name="org.springframework.batch" level="INFO"/>
    
    <!-- Reduce noise from Spring framework -->
    <logger name="org.springframework.web" level="WARN"/>
    <logger name="org.springframework.jdbc" level="WARN"/>
    <logger name="org.springframework.transaction" level="WARN"/>
    <logger name="org.jetbrains.exposed" level="WARN"/>
    <logger name="Exposed" level="WARN"/>
    
    <!-- Suppress verbose Artemis audit logging (per-message logging) -->
    <!-- INFO level audit logs generate one log entry per message sent/received -->
    <logger name="org.apache.activemq.audit.base" level="WARN"/>
    <logger name="org.apache.activemq.audit.message" level="WARN"/>
    
    <!-- Keep Artemis server startup/shutdown logs at INFO -->
    <logger name="org.apache.activemq.artemis.core.server" level="INFO"/>
</configuration>
