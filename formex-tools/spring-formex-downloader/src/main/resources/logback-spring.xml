<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Single-mode logging for progress bar operation
         - Console is reserved exclusively for Mordant progress output
         - All application logs go to file only
    -->

    <!-- File appender with size- and time-based rolling policy -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-logs}/formex-downloader.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH:-logs}/formex-downloader.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId}-%X{spanId}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger: write to file only (no console appender) -->
    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>

    <!-- Application loggers -->
    <logger name="com.kludgeworks.eu.legislation.formex.downloader" level="DEBUG"/>

    <!-- Reduce noise from Spring framework -->
    <logger name="org.springframework.web" level="WARN"/>
    <logger name="org.springframework.jdbc" level="WARN"/>
    <logger name="org.springframework.transaction" level="WARN"/>
    <logger name="org.jetbrains.exposed" level="WARN"/>
    <logger name="Exposed" level="WARN"/>
</configuration>
