
### Query for Information About a Work
@CELEX_NUMBER = 32015R1998
POST https://publications.europa.eu/webapi/rdf/sparql
Accept: application/sparql-results+json
Content-Type: application/x-www-form-urlencoded

query = PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?expression ?language
WHERE {
  # Retrieve the work by its CELEX number
  ?work cdm:resource_legal_id_celex "{{CELEX_NUMBER}}"^^xsd:string .

  # Find all expressions that belong to this work
  ?expression cdm:expression_belongs_to_work ?work ;
              cdm:expression_uses_language ?language .
}

> {%
    var bindings = response.body.results.bindings;

    const result = bindings.filter(item =>
        item.language.value.endsWith('language/ENG')
    );
    const expression = result[0].expression.value

    console.log(expression)

%}

